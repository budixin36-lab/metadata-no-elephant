}

if (!primary_col %in% colnames(traits_raw)) {
  stop("Table S1 中找不到 primary_lifestyle 列。")
}

comment_col <- if ("COMMENT on genus" %in% colnames(traits_raw)) {
  "COMMENT on genus"
} else if ("COMMENT.on.genus" %in% colnames(traits_raw)) {
  "COMMENT.on.genus"
} else {
  NA_character_
}

traits_core <- traits_raw %>%
  transmute(
    accepted_name = as.character(.data[[genus_col]]),
    comment_on_genus = if (!is.na(comment_col)) {
      as.character(.data[[comment_col]])
    } else {
      NA_character_
    },
    primary_lifestyle = as.character(.data[[primary_col]])
  ) %>%
  mutate(
    genus_key = normalize_name(accepted_name),
    primary_lifestyle_mid = vapply(primary_lifestyle, map_primary_lifestyle_mid, character(1)),
    primary_lifestyle_cn = standardize_function_label(primary_lifestyle_mid),
    synonym_target_key = extract_synonym_target(comment_on_genus)
  ) %>%
  filter(!is.na(genus_key), genus_key != "")

cat("Table S1 可用属记录数：", nrow(traits_core), "\n", sep = "")
cat("Table S1 唯一 GENUS 数：", dplyr::n_distinct(traits_core$genus_key), "\n", sep = "")

## 直接 GENUS 匹配表
direct_map <- traits_core %>%
  group_by(genus_key) %>%
  summarise(
    accepted_name_joined = paste(unique(accepted_name), collapse = "; "),
    primary_lifestyle_joined = paste(unique(na.omit(primary_lifestyle)), collapse = "; "),
    n_lifestyle_cn = n_distinct(primary_lifestyle_cn[!is.na(primary_lifestyle_cn)]),
    primary_lifestyle_cn = ifelse(
      n_distinct(primary_lifestyle_cn[!is.na(primary_lifestyle_cn)]) == 1,
      unique(primary_lifestyle_cn[!is.na(primary_lifestyle_cn)])[1],
      "未分类"
    ),
    comment_joined = paste(unique(na.omit(comment_on_genus)), collapse = "; "),
    .groups = "drop"
  ) %>%
  mutate(
    direct_status = ifelse(primary_lifestyle_cn == "未分类", "direct_missing_or_ambiguous", "direct")
  )

## COMMENT on genus 中 synonym of X 的保守 fallback
synonym_map <- traits_core %>%
  filter(!is.na(synonym_target_key), synonym_target_key != "") %>%
  group_by(synonym_target_key) %>%
  summarise(
    synonym_source_genera = paste(unique(accepted_name), collapse = "; "),
    synonym_lifestyle_joined = paste(unique(na.omit(primary_lifestyle)), collapse = "; "),
    n_lifestyle_cn = n_distinct(primary_lifestyle_cn[!is.na(primary_lifestyle_cn)]),
    primary_lifestyle_cn = ifelse(
      n_distinct(primary_lifestyle_cn[!is.na(primary_lifestyle_cn)]) == 1,
      unique(primary_lifestyle_cn[!is.na(primary_lifestyle_cn)])[1],
      "未分类"
    ),
    synonym_comments = paste(unique(na.omit(comment_on_genus)), collapse = "; "),
    .groups = "drop"
  ) %>%
  filter(primary_lifestyle_cn != "未分类")

cat("COMMENT synonym fallback 可用 target 数：", nrow(synonym_map), "\n", sep = "")

