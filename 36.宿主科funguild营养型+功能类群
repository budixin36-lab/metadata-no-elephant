#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
从 no-elephant BIOM 文件中提取每个 SH 的 taxonomy，
生成 FUNGuild 可用的 OTU 表格式输入文件。

输入：
  merged_SH_globalfungi_style_nozero_no_elephant_with_taxonomy.biom

输出：
  1. SH_taxonomy_for_FUNGuild_from_BIOM_no_elephant.txt
     - FUNGuild 输入文件
     - 三列：OTU_ID, dummy, taxonomy
  2. SH_taxonomy_from_BIOM_no_elephant.tsv
     - 每个 SH 的 taxonomy 明细表，方便检查
  3. BIOM_taxonomy_extract_summary_no_elephant.txt
     - 提取摘要
"""

from pathlib import Path
import json
import re
import sys
from collections import Counter

BASE = Path("/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant")

BIOM_FILE = BASE / "taxonomy/merged_SH_globalfungi_style_nozero_no_elephant_with_taxonomy.biom"

OUT_DIR = BASE / "results/funguild_no_elephant"
OUT_DIR.mkdir(parents=True, exist_ok=True)

OUT_FUNGUILD = OUT_DIR / "SH_taxonomy_for_FUNGuild_from_BIOM_no_elephant.txt"
OUT_TAXONOMY = OUT_DIR / "SH_taxonomy_from_BIOM_no_elephant.tsv"
OUT_SUMMARY = OUT_DIR / "BIOM_taxonomy_extract_summary_no_elephant.txt"

RANKS = ["kingdom", "phylum", "class", "order", "family", "genus", "species"]

RANK_PREFIX = {
    "kingdom": "k__",
    "phylum": "p__",
    "class": "c__",
    "order": "o__",
    "family": "f__",
    "genus": "g__",
    "species": "s__",
}


def clean_taxon_value(value):
    """
    清理 BIOM metadata 中的分类单元名称。
    保留 Incertae_sedis 这类信息，不强行删除。
    """
    if value is None:
        return ""

    value = str(value).strip()

    if value in {
        "",
        "NA", "N/A", "na", "n/a",
        "None", "none", "NULL", "null",
        "Unassigned", "unassigned",
        "Unknown", "unknown",
        "-", ";"
    }:
        return ""

    # 去除已有 rank 前缀，避免出现 g__g__Aspergillus
    value = re.sub(r"^[dkpcofgs]__+", "", value, flags=re.IGNORECASE)

    # FUNGuild 输入中 taxonomy 用分号分隔，分类名本身不要再带分号
    value = value.replace(";", "_")
    value = value.replace(",", "_")
    value = re.sub(r"\s+", "_", value)

    # 去掉多余下划线
    value = re.sub(r"_+", "_", value).strip("_")

    return value


def build_funguild_taxonomy(metadata):
    """
    将 BIOM 中的 metadata 转成 FUNGuild 常见可识别的 taxonomy 字符串：
    k__Fungi;p__Ascomycota;c__...
    """
    if metadata is None:
        metadata = {}

    parts = []

    for rank in RANKS:
        value = clean_taxon_value(metadata.get(rank, ""))

        if rank == "kingdom" and value == "":
            value = "Fungi"

        if value != "":
            parts.append(RANK_PREFIX[rank] + value)

    if len(parts) == 0:
        parts = ["k__Fungi"]

    return ";".join(parts)


def main():
    if not BIOM_FILE.exists():
        raise SystemExit(f"找不到 BIOM 文件：{BIOM_FILE}")

    print("读取 BIOM 文件：")
    print(BIOM_FILE)

    with BIOM_FILE.open("r", encoding="utf-8") as f:
        first_char = f.read(1)
        f.seek(0)

        if first_char != "{":
            raise SystemExit(
                "这个脚本目前用于 JSON 格式 BIOM。\n"
                "你的文件开头不是 '{'，可能是 HDF5 BIOM。\n"
                "如果遇到这种情况，把报错发我，我再给你 HDF5 版提取脚本。"
            )

        biom = json.load(f)

    rows = biom.get("rows", [])
    columns = biom.get("columns", [])
    shape = biom.get("shape", [])

    print(f"BIOM shape: {shape}")
    print(f"SH 行数: {len(rows)}")
    print(f"样本列数: {len(columns)}")

    if len(rows) == 0:
        raise SystemExit("BIOM 中没有 rows，无法提取 SH taxonomy。")

    rank_nonempty_counter = Counter()
    kingdom_counter = Counter()
    phylum_counter = Counter()
    genus_nonempty = 0
    species_nonempty = 0
    metadata_missing = 0

    with OUT_FUNGUILD.open("w", encoding="utf-8", newline="") as fg_out, \
         OUT_TAXONOMY.open("w", encoding="utf-8", newline="") as tax_out:

        fg_out.write("OTU_ID\tdummy\ttaxonomy\n")
        tax_out.write(
            "OTU_ID\tkingdom\tphylum\tclass\torder\tfamily\tgenus\tspecies\tfunguild_taxonomy\n"
        )

        for row in rows:
            sh_id = str(row.get("id", "")).strip()
            metadata = row.get("metadata", None)

            if sh_id == "":
                continue

            if metadata is None:
                metadata = {}
                metadata_missing += 1

            cleaned = {}
            for rank in RANKS:
                cleaned[rank] = clean_taxon_value(metadata.get(rank, ""))

            if cleaned["kingdom"] == "":
                cleaned["kingdom"] = "Fungi"

            for rank in RANKS:
                if cleaned[rank] != "":
                    rank_nonempty_counter[rank] += 1

            kingdom_counter[cleaned["kingdom"]] += 1
            phylum_counter[cleaned["phylum"] if cleaned["phylum"] != "" else "missing"] += 1

            if cleaned["genus"] != "":
                genus_nonempty += 1
            if cleaned["species"] != "":
                species_nonempty += 1

            funguild_taxonomy = build_funguild_taxonomy(cleaned)

            fg_out.write(f"{sh_id}\t1\t{funguild_taxonomy}\n")

            tax_out.write(
                f"{sh_id}\t"
                f"{cleaned['kingdom']}\t"
                f"{cleaned['phylum']}\t"
                f"{cleaned['class']}\t"
                f"{cleaned['order']}\t"
                f"{cleaned['family']}\t"
                f"{cleaned['genus']}\t"
                f"{cleaned['species']}\t"
                f"{funguild_taxonomy}\n"
            )

    with OUT_SUMMARY.open("w", encoding="utf-8") as s:
        s.write("BIOM taxonomy extraction summary for FUNGuild\n")
        s.write("================================================\n\n")
        s.write(f"Input BIOM: {BIOM_FILE}\n")
        s.write(f"BIOM shape: {shape}\n")
        s.write(f"Rows / SH number: {len(rows)}\n")
        s.write(f"Columns / sample number: {len(columns)}\n\n")

        s.write("Output files:\n")
        s.write(f"FUNGuild input: {OUT_FUNGUILD}\n")
        s.write(f"SH taxonomy table: {OUT_TAXONOMY}\n\n")

        s.write("Non-empty taxonomy ranks:\n")
        for rank in RANKS:
            s.write(f"{rank}: {rank_nonempty_counter[rank]}\n")

        s.write("\nMissing metadata rows:\n")
        s.write(f"{metadata_missing}\n\n")

        s.write("Genus non-empty SH number:\n")
        s.write(f"{genus_nonempty}\n\n")

        s.write("Species non-empty SH number:\n")
        s.write(f"{species_nonempty}\n\n")

        s.write("Kingdom summary:\n")
        for k, v in kingdom_counter.most_common():
            s.write(f"{k}\t{v}\n")

        s.write("\nTop phylum summary:\n")
        for k, v in phylum_counter.most_common(30):
            s.write(f"{k}\t{v}\n")

    print("\n完成 BIOM taxonomy 提取。")
    print("FUNGuild 输入文件：")
    print(OUT_FUNGUILD)
    print("SH taxonomy 明细表：")
    print(OUT_TAXONOMY)
    print("摘要文件：")
    print(OUT_SUMMARY)


if __name__ == "__main__":
    main()
PY

