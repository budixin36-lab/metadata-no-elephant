plot_stacked <- function(df, x_col, fill_col, y_col, fill_values, out_png, out_pdf,
                         legend_text_size = 10.5, width_cm = 24, height_cm = 14) {

  p <- ggplot(
    df,
    aes(
      x = .data[[x_col]],
      y = .data[[y_col]],
      fill = .data[[fill_col]]
    )
  ) +
    geom_col(
      width = 0.72,
      color = "grey35",
      linewidth = 0.12
    ) +
    scale_fill_manual(
      values = fill_values,
      breaks = names(fill_values),
      drop = FALSE
    ) +
    scale_y_continuous(
      breaks = seq(0, 100, 20),
      expand = expansion(mult = c(0, 0.01))
    ) +
    coord_cartesian(ylim = c(0, 100), clip = "off") +
    labs(
      x = NULL,
      y = "平均相对多度（%）"
    ) +
    theme_classic(base_size = 15, base_family = base_family) +
    theme(
      axis.line = element_line(color = "black", linewidth = 0.8),
      axis.ticks = element_line(color = "black", linewidth = 0.8),
      axis.ticks.length = unit(0.20, "cm"),
      axis.text.x = element_text(size = 16, color = "black", family = base_family),
      axis.text.y = element_text(size = 13, color = "black", family = base_family),
      axis.title.y = element_text(size = 16, color = "black", family = base_family),
      legend.position = "right",
      legend.title = element_blank(),
      legend.text = element_text(size = legend_text_size, color = "black", family = base_family),
      legend.key.size = unit(0.42, "cm"),
      legend.spacing.y = unit(0.03, "cm"),
      legend.background = element_rect(fill = "white", colour = NA),
      legend.key = element_rect(fill = "white", colour = NA),
      plot.background = element_rect(fill = "white", colour = NA),
      panel.background = element_rect(fill = "white", colour = NA),
      plot.margin = margin(8, 8, 8, 8)
    )

  ggsave(out_png, p, width = width_cm, height = height_cm, units = "cm", dpi = 600, bg = "white")
  ggsave(out_pdf, p, width = width_cm, height = height_cm, units = "cm", bg = "white")
}

