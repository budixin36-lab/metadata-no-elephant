    "Ericoid Mycorrhizal" = "杜鹃菌根菌",
    "Orchid Mycorrhizal" = "兰科菌根菌",
    "Lichenized" = "地衣型真菌",

    "Sooty Mold" = "煤污菌",
    "Bacterivore" = "食细菌型"
  )

  if (x %in% names(guild_map)) {
    return(unname(guild_map[x]))
  } else {
    return(x)
  }
}

translate_guild <- function(x) {
  x <- clean_fg_field(x)
  if (is.na(x)) return("未分类")

  parts <- unlist(strsplit(x, "-", fixed = TRUE))
  parts <- trimws(parts)
  parts <- parts[parts != ""]
  if (length(parts) == 0) return("未分类")

  parts_cn <- vapply(parts, translate_guild_token, character(1))
  paste(parts_cn, collapse = "-")
}

make_fill_colors <- function(levels_use) {
  cols <- grDevices::hcl.colors(length(levels_use), palette = "Dark 3")
