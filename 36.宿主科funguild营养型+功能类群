fix_guild_cn <- function(x) {
  x <- as.character(x)

  ## 补齐上版漏翻译的 FUNGuild guild token
  x <- stringr::str_replace_all(x, fixed("Animal Symbiotroph"), "动物共生菌")
  x <- stringr::str_replace_all(x, fixed("Plant Symbiotroph"), "植物共生菌")
  x <- stringr::str_replace_all(x, fixed("Fungal Symbiotroph"), "真菌共生菌")
  x <- stringr::str_replace_all(x, fixed("Algal Symbiotroph"), "藻类共生菌")
  x <- stringr::str_replace_all(x, fixed("Bryophyte Symbiotroph"), "苔藓共生菌")

  ## 保险：如果 CSV 中仍混入少数英文 token，也在重画时补译
  x <- stringr::str_replace_all(x, fixed("Animal Pathogen"), "动物病原菌")
  x <- stringr::str_replace_all(x, fixed("Animal Parasite"), "动物寄生菌")
  x <- stringr::str_replace_all(x, fixed("Plant Pathogen"), "植物病原菌")
  x <- stringr::str_replace_all(x, fixed("Plant Saprotroph"), "植物腐生菌")
  x <- stringr::str_replace_all(x, fixed("Undefined Saprotroph"), "未定义腐生菌")
  x <- stringr::str_replace_all(x, fixed("Wood Saprotroph"), "木材腐生菌")
  x <- stringr::str_replace_all(x, fixed("Dung Saprotroph"), "粪生腐生菌")
  x <- stringr::str_replace_all(x, fixed("Litter Saprotroph"), "凋落物腐生菌")
  x <- stringr::str_replace_all(x, fixed("Soil Saprotroph"), "土壤腐生菌")
  x <- stringr::str_replace_all(x, fixed("Endophyte"), "内生菌")
  x <- stringr::str_replace_all(x, fixed("Ectomycorrhizal"), "外生菌根菌")
  x <- stringr::str_replace_all(x, fixed("Lichenized"), "地衣型真菌")

  x
}

wrap_legend_label <- function(x, width = 24) {
  ## 对中文/中英混合图例按字符宽度换行
  ## width 越小，换行越积极
  stringr::str_wrap(x, width = width)
}

make_guild_colors <- function(levels_use) {
  cols <- grDevices::hcl.colors(length(levels_use), palette = "Dark 3")
  names(cols) <- levels_use

  if ("其他功能类群" %in% names(cols)) cols["其他功能类群"] <- "#9E9E9E"
  if ("未分类" %in% names(cols)) cols["未分类"] <- "#D9D9D9"

  cols
}

## -----------------------------
## 5. 稳定输出 PNG / PDF
## -----------------------------
save_plot_cairo <- function(p, png_file, pdf_file, width_cm, height_cm, dpi = 600) {
  ## PNG：不用 ggsave 默认 png，显式 cairo 位图设备
  if (isTRUE(capabilities("cairo"))) {
    grDevices::png(
      filename = png_file,
      width = width_cm,
      height = height_cm,
      units = "cm",
      res = dpi,
      type = "cairo",
      bg = "white"
    )
  } else {
    grDevices::png(
      filename = png_file,
      width = width_cm,
      height = height_cm,
      units = "cm",
      res = dpi,
      bg = "white"
    )
  }
  print(p)
  grDevices::dev.off()

  ## PDF：优先 cairo_pdf，保证字体和中文更稳定
  if (isTRUE(capabilities("cairo"))) {
    grDevices::cairo_pdf(
      filename = pdf_file,
      width = width_cm / 2.54,
      height = height_cm / 2.54,
      bg = "white"
    )
  } else {
    grDevices::pdf(
      file = pdf_file,
      width = width_cm / 2.54,
      height = height_cm / 2.54,
      bg = "white"
    )
  }
  print(p)
  grDevices::dev.off()
}

