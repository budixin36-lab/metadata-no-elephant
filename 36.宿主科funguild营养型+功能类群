summarise_by_category <- function(category_vec, category_name) {
  category_vec <- as.character(category_vec)
  category_vec[is.na(category_vec) | category_vec == ""] <- "未分类"

  group_abund <- rowsum(ab_mat, group = category_vec, reorder = FALSE, na.rm = TRUE)

  rel_mat <- sweep(group_abund, 2, sample_total_reads, FUN = "/") * 100
  rel_mat[, sample_total_reads <= 0] <- 0
  rel_mat[is.na(rel_mat)] <- 0

  sample_df <- as.data.frame(t(rel_mat), check.names = FALSE)
  sample_df$sample_id <- rownames(sample_df)

  sample_long <- sample_df %>%
    pivot_longer(
      cols = -sample_id,
      names_to = category_name,
      values_to = "relative_abundance"
    ) %>%
    left_join(meta_use, by = "sample_id")

  family_mean <- sample_long %>%
    group_by(host_family, host_family_cn, .data[[category_name]]) %>%
    summarise(
      mean_relative_abundance = mean(relative_abundance, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    mutate(
      host_family = factor(host_family, levels = host_family_order),
      host_family_cn = factor(host_family_cn, levels = host_family_cn_map[host_family_order])
    ) %>%
    arrange(host_family)

  list(
    sample_long = sample_long,
    family_mean = family_mean
  )
}

