normalize_name <- function(x) {
  x <- as.character(x)
  x <- trimws(x)
  x <- gsub("^g__", "", x, ignore.case = TRUE)
  x <- gsub("^.*;\\s*g__", "", x, ignore.case = TRUE)
  x <- gsub("^.*;\\s*", "", x)
  x <- gsub("_", " ", x)
  x <- gsub("\\s+", " ", x)
  x <- gsub("\\bsp\\.?$", "", x, ignore.case = TRUE)
  x <- gsub("\\bspp\\.?$", "", x, ignore.case = TRUE)
  x <- trimws(x)

  ## 对于 Aspergillus flavus 这类，取第一个词作为属名
  x <- sapply(strsplit(x, "\\s+"), function(v) {
    if (length(v) == 0) return(NA_character_)
    v[1]
  }, USE.NAMES = FALSE)

  x <- tolower(x)

  x[x %in% c(
    "",
    "na",
    "nan",
    "null",
    "unassigned",
    "unclassified",
    "uncultured",
    "unknown",
    "fungi",
    "fungal",
    "incertae",
    "incertae sedis"
  )] <- NA_character_

  return(x)
}

normalize_colname <- function(x) {
  tolower(gsub("[^a-z0-9]+", "", x))
}

find_col <- function(df, patterns, required = TRUE) {
  nm <- names(df)
  nm2 <- normalize_colname(nm)

  idx <- integer(0)

  for (p in patterns) {
    idx <- c(idx, which(grepl(p, nm2)))
  }

  idx <- unique(idx)

  if (length(idx) == 0) {
    if (required) {
      stop(
        "无法识别所需列。现有列名为：\n",
        paste(names(df), collapse = " | ")
      )
    } else {
      return(NA_character_)
    }
  }

  nm[idx[1]]
}

clean_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c(
    "",
    "NA", "N/A", "na", "n/a",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded",
    "not_reported", "not reported",
    "unknown", "Unknown", "UNKNOWN"
  )] <- NA_character_

  x
}

extract_synonym_target <- function(comment) {
  comment <- as.character(comment)
  comment[is.na(comment)] <- ""

  hit <- stringr::str_match(
    comment,
    regex("synonym of\\s+([A-Za-z][A-Za-z.-]*)", ignore_case = TRUE)
  )[, 2]

  normalize_name(hit)
}

normalize_lifestyle <- function(x) {
  x <- tolower(as.character(x))
  x <- gsub("_", " ", x)
  x <- gsub("-", " ", x)
  x <- gsub("/", " / ", x)
  x <- gsub("\\s+", " ", x)
  x <- trimws(x)
  x
}

map_primary_lifestyle <- function(x) {
  if (is.na(x) || trimws(x) == "") return("未分类")

  y <- normalize_lifestyle(x)

  ## 腐生类
  if (y %in% c("wood saprotroph")) return("木材腐生型")
  if (y %in% c("litter saprotroph")) return("凋落物腐生型")
  if (y %in% c("soil saprotroph")) return("土壤腐生型")
  if (y %in% c("undefined saprotroph", "unspecified saprotroph")) return("未明确腐生型")
  if (y %in% c("dung saprotroph")) return("粪生腐生型")
  if (y %in% c(
    "nectar saprotroph",
    "tap saprotroph",
    "nectar / tap saprotroph",
    "nectar tap saprotroph",
    "nectar/tap saprotroph"
  )) return("花蜜/树液腐生型")
  if (y %in% c("pollen saprotroph")) return("花粉腐生型")

  ## 病原/寄生类
  if (y %in% c("plant pathogen")) return("植物病原型")
  if (y %in% c("animal parasite", "animal pathogen")) return("动物寄生型")
  if (y %in% c("algal parasite")) return("藻类寄生型")
  if (y %in% c("protozoan parasite", "protistan parasite")) return("原生生物寄生型")
  if (y %in% c("lichen parasite")) return("地衣寄生型")
  if (y %in% c("fungal parasite", "mycoparasite")) return("真菌寄生型")
  if (y %in% c("undefined pathogen", "unspecified pathotroph")) return("未定义病原菌")

  ## 共生类
  if (y %in% c("lichenized", "lichenised")) return("地衣型真菌")
  if (y %in% c("ectomycorrhizal")) return("外生菌根型")
  if (y %in% c("arbuscular mycorrhizal")) return("丛枝菌根型")
  if (y %in% c("bryophilous", "moss symbiont")) return("苔藓共生型")
  if (y %in% c("undefined symbiotroph", "unspecified symbiotroph")) return("未明确共生型")
  if (y %in% c("animal endosymbiont")) return("动物内共生型")
  if (y %in% c("algal epibiont", "algal ectosymbiont")) return("藻类外共生型")

  ## 内生/附生
  if (y %in% c("foliar endophyte", "leaf endophyte")) return("叶内生型")
  if (y %in% c("root endophyte")) return("根内生型")
  if (y %in% c("epiphyte")) return("附生型")

  ## 其他
  if (y %in% c("sooty mold", "sooty mould")) return("煤烟菌")
  if (y %in% c("animal associated", "animal-associated")) return("动物相关型")
  if (y %in% c("arthropod associated", "arthropod-associated")) return("节肢动物相关型")
  if (y %in% c("bacterivore", "bacterivorous")) return("食细菌型")
  if (y %in% c("algivorous", "protistivorous", "algivorous / protistivorous", "algivorous/protistivorous")) return("食藻/食原生生物型")

  ## generic undefined 合并进未分类
  if (y %in% c("undefined", "unspecified", "unassigned", "unknown")) return("未分类")

  ## 遇到未覆盖类型，先归未分类，避免错误英文直接进入图例
  return("未分类")
}

