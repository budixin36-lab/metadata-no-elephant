}

resolve_cn_to_genus <- function(genus_cn, genus_table_names) {
  genus_cn <- as.character(genus_cn)

  candidates <- cn_to_genus_candidates[[genus_cn]]

  if (is.null(candidates)) {
    ## 如果中文名不在映射表中，尝试直接用中文名或原名匹配
    candidates <- genus_cn
  }

  ## 1. 直接精确匹配
  hit <- candidates[candidates %in% genus_table_names]
  if (length(hit) >= 1) return(hit[1])

  ## 2. 规范化匹配：处理空格/下划线差异
  genus_norm <- norm_genus_name(genus_table_names)
  cand_norm <- norm_genus_name(candidates)

  idx <- match(cand_norm, genus_norm)
  idx <- idx[!is.na(idx)]
  if (length(idx) >= 1) return(genus_table_names[idx[1]])

  ## 3. 匹配不到则返回 NA
  NA_character_
}

make_letters_from_dunn <- function(dunn_df, groups, alpha = 0.05) {
  groups <- as.character(groups)

  if (length(groups) <= 1) {
    return(setNames("a", groups))
  }

  if (is.null(dunn_df) || nrow(dunn_df) == 0) {
    return(setNames(rep("a", length(groups)), groups))
  }

  p_vec <- dunn_df$p_adj_BH
  names(p_vec) <- paste(dunn_df$group1, dunn_df$group2, sep = "-")

  letters_obj <- multcompView::multcompLetters(
    p_vec,
    threshold = alpha,
    Letters = letters
  )

  letters_raw <- letters_obj$Letters

  missing_groups <- setdiff(groups, names(letters_raw))
  if (length(missing_groups) > 0) {
    letters_raw <- c(
      letters_raw,
      setNames(rep("a", length(missing_groups)), missing_groups)
    )
  }

  letters_raw[groups]
}

run_dunn_one_genus <- function(df_one, genus_name) {
  df_one <- df_one %>%
    filter(!is.na(relative_abundance), !is.na(host_family_cn)) %>%
    mutate(
      host_family_cn = factor(host_family_cn, levels = host_family_order_cn)
    )

  groups_present <- df_one %>%
    pull(host_family_cn) %>%
    as.character() %>%
    unique()

  groups_present <- host_family_order_cn[host_family_order_cn %in% groups_present]

  if (length(groups_present) < 2) {
    return(data.frame())
  }

  dt <- dunn.test::dunn.test(
    x = df_one$relative_abundance,
    g = df_one$host_family_cn,
    method = "bh",
    kw = FALSE,
    label = TRUE,
    wrap = FALSE,
    table = FALSE,
    list = TRUE
  )

  dunn_out <- data.frame(
    genus_cn = genus_name,
    comparison = dt$comparisons,
    Z = dt$Z,
    p_value = dt$P,
    p_adj_BH = dt$P.adjusted,
    stringsAsFactors = FALSE
  )

  parts <- strsplit(dunn_out$comparison, " - ", fixed = TRUE)

  dunn_out$group1 <- vapply(parts, function(x) x[1], character(1))
  dunn_out$group2 <- vapply(parts, function(x) x[2], character(1))

  dunn_out %>%
    select(
      genus_cn,
      group1,
      group2,
      comparison,
      Z,
      p_value,
      p_adj_BH
    ) %>%
    mutate(
      p_value_format = format_p(p_value),
      p_adj_BH_format = format_p(p_adj_BH),
      significance = p_to_sig(p_adj_BH)
    )
}

