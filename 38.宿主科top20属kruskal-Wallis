find_col <- function(df, patterns, label) {
  nms <- colnames(df)
  for (p in patterns) {
    hit <- grep(p, nms, ignore.case = TRUE, value = TRUE)
    if (length(hit) >= 1) return(hit[1])
  }
  stop(
    "无法识别列：", label,
    "\n当前列名为：\n",
    paste(nms, collapse = " | ")
  )
}

clean_genus_name <- function(x) {
  x <- as.character(x)
  x <- gsub("^g__", "", x)
  x <- trimws(x)
  x
}

norm_genus_name <- function(x) {
  x <- clean_genus_name(x)
  x <- gsub("_", " ", x)
  x <- stringr::str_squish(x)
  tolower(x)
}

p_to_sig <- function(p) {
  dplyr::case_when(
    is.na(p) ~ "",
    p < 0.001 ~ "***",
    p < 0.01 ~ "**",
    p < 0.05 ~ "*",
    TRUE ~ "ns"
  )
}

format_p <- function(p) {
  dplyr::case_when(
    is.na(p) ~ NA_character_,
    p < 0.001 ~ "<0.001",
    TRUE ~ sprintf("%.4f", p)
  )
}

map_genus_cn_from_en <- function(x) {
