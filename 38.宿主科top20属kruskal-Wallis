)

cat("\n作图数据预览：\n")
print(
  plot_df %>%
    select(genus_cn, host_family_cn, mean_relative_abundance, se_relative_abundance, letter) %>%
    head(30)
)

## -----------------------------
## 8. 作图
## -----------------------------
pd <- position_dodge(width = 0.78)

genus_labels_wrapped <- setNames(
  wrap_genus_label(selected_genera),
  selected_genera
)

p <- ggplot(
  plot_df,
  aes(
    x = mean_relative_abundance,
    y = genus_cn,
    fill = host_family_cn
  )
) +
  geom_col(
    position = pd,
    width = 0.68,
    color = "grey30",
    linewidth = 0.15
  ) +
  geom_errorbar(
    aes(
      xmin = pmax(mean_relative_abundance - se_relative_abundance, 0),
      xmax = mean_relative_abundance + se_relative_abundance
    ),
    position = pd,
    width = 0.18,
    linewidth = 0.4,
    color = "black"
  ) +
  geom_text(
    aes(
      x = label_x,
      y = genus_cn,
      label = letter,
      group = host_family_cn
    ),
    position = pd,
    hjust = 0,
    size = 3.2,
    family = base_family,
    color = "black"
  ) +
  scale_fill_manual(
    values = family_colors,
    breaks = host_family_order_cn,
    drop = FALSE
  ) +
  scale_y_discrete(
    labels = genus_labels_wrapped
  ) +
  scale_x_continuous(
    expand = expansion(mult = c(0, 0.16))
  ) +
  labs(
    x = "平均相对多度（%）",
    y = NULL,
    fill = NULL
  ) +
  theme_classic(base_size = 11, base_family = base_family) +
  theme(
    axis.line = element_line(color = "black", linewidth = 0.8),
    axis.ticks = element_line(color = "black", linewidth = 0.8),
    axis.ticks.length = unit(0.18, "cm"),
    axis.text.x = element_text(size = 10.5, color = "black", family = base_family),
    axis.text.y = element_text(size = 10.2, color = "black", family = base_family, lineheight = 0.95),
    axis.title.x = element_text(size = 11, color = "black", family = base_family),
    legend.position = "bottom",
    legend.direction = "horizontal",
    legend.title = element_blank(),
    legend.text = element_text(size = 10, color = "black", family = base_family),
    legend.key.size = unit(0.42, "cm"),
    legend.spacing.x = unit(0.20, "cm"),
    panel.background = element_rect(fill = "white", colour = NA),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(6, 10, 6, 6)
  )

## -----------------------------
## 9. 输出
## -----------------------------
save_plot_cairo(
  p = p,
  png_file = out_png,
  pdf_file = out_pdf,
  width_mm = 190,
  height_mm = 130,
  dpi = 600
)

cat("\n完成！\n")
cat("PNG: ", out_png, "\n", sep = "")
cat("PDF: ", out_pdf, "\n", sep = "")
cat("plot data: ", out_plotdata_csv, "\n", sep = "")
cat("selected genera: ", out_selected_csv, "\n", sep = "")
EOF

