  ) %>%
  tidyr::pivot_wider(
    names_from = host_family_cn,
    values_from = mean_relative_abundance
  )

## -----------------------------
## 9. Kruskal-Wallis 检验
## -----------------------------
kw_list <- list()

for (g in top20_genus_cn) {
  df_one <- genus_long %>%
    filter(as.character(genus_cn) == g) %>%
    mutate(
      host_family_cn = factor(host_family_cn, levels = host_family_order_cn)
    )

  groups_present <- df_one %>%
    pull(host_family_cn) %>%
    as.character() %>%
    unique()

  groups_present <- groups_present[!is.na(groups_present)]

  if (length(groups_present) < 2) {
    kw_list[[g]] <- data.frame(
      genus_cn = g,
      n_total = nrow(df_one),
      group_number = length(groups_present),
      statistic_H = NA_real_,
      df = NA_real_,
      p_value = NA_real_,
      stringsAsFactors = FALSE
    )
    next
  }

  kt <- kruskal.test(relative_abundance ~ host_family_cn, data = df_one)

  kw_list[[g]] <- data.frame(
    genus_cn = g,
    n_total = nrow(df_one),
    group_number = length(groups_present),
    statistic_H = unname(kt$statistic),
    df = unname(kt$parameter),
    p_value = kt$p.value,
    stringsAsFactors = FALSE
  )
}

kw_df <- bind_rows(kw_list) %>%
  mutate(
    p_adj_BH_across_genera = p.adjust(p_value, method = "BH"),
    p_value_format = format_p(p_value),
    p_adj_BH_across_genera_format = format_p(p_adj_BH_across_genera),
    significance_raw = p_to_sig(p_value),
    significance_BH = p_to_sig(p_adj_BH_across_genera),
    genus_cn = factor(genus_cn, levels = top20_genus_cn)
  ) %>%
  left_join(group_mean_wide, by = "genus_cn") %>%
  arrange(genus_cn)

write.csv(
  kw_df,
  out_kw_csv,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

## -----------------------------
## 10. Dunn's test 两两比较
## -----------------------------
dunn_list <- list()

for (g in top20_genus_cn) {
