#!/usr/bin/env Rscript

############################################################
## Chapter 5 - Fig5-1 Venn 图重画脚本 v4
##
## 目的：
##   保持第一版图的整体布局不变，
##   只将“圈养野生”这个底部标签单独向下移动一点，
##   避免与圆圈重叠。
##
## 注意：
##   本脚本不重新计算任何数据；
##   只读取已有 macrofungi_SH_status_presence_absence.csv 重画图。
############################################################

rm(list = ls())

options(stringsAsFactors = FALSE)
options(scipen = 999)

cat("============================================================\n")
cat("Redraw Fig5-1 status macrofungi SH Venn, v4 move only bottom label\n")
cat("============================================================\n\n")

## =========================
## 0. R 包路径与依赖检查
## =========================

RVER <- paste0(
  R.version$major,
  ".",
  strsplit(R.version$minor, "\\.")[[1]][1]
)

user_lib <- file.path(Sys.getenv("HOME"), "Rlibs", paste0("R-", RVER))

.libPaths(c(
  user_lib,
  "/mnt/d/Rlibs",
  "/usr/local/lib/R/site-library",
  "/usr/lib/R/site-library",
  "/usr/lib/R/library"
))

need_pkgs <- c(
  "VennDiagram",
  "grid",
  "showtext",
  "sysfonts"
)

pkg_check <- data.frame(
  package = need_pkgs,
  installed = sapply(need_pkgs, requireNamespace, quietly = TRUE),
  stringsAsFactors = FALSE
)

cat("========== Package check ==========\n")
print(pkg_check)

if (any(!pkg_check$installed)) {
  cat("\n以下 R 包尚未安装，请先安装后再运行本脚本：\n")
  print(pkg_check$package[!pkg_check$installed])
  stop("Package check failed.")
}

suppressPackageStartupMessages({
  library(VennDiagram)
  library(grid)
  library(showtext)
  library(sysfonts)
})

## =========================
## 1. 输入与输出路径
## =========================

project_dir <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant"

in_dir <- file.path(
  project_dir,
  "results",
  "chapter5_macrofungi_no_elephant",
  "status_macrofungi_SH_venn_v1"
)

pa_file <- file.path(
  in_dir,
  "macrofungi_SH_status_presence_absence.csv"
)

out_png <- file.path(
  in_dir,
  "Fig5_1_status_macrofungi_SH_Venn_no_elephant_CN_v4_move_only_bottom_label.png"
)

out_pdf <- file.path(
  in_dir,
  "Fig5_1_status_macrofungi_SH_Venn_no_elephant_CN_v4_move_only_bottom_label.pdf"
)

out_log <- file.path(
  in_dir,
  "Fig5_1_status_macrofungi_SH_Venn_no_elephant_CN_v4_move_only_bottom_label_log.txt"
)

if (!file.exists(pa_file)) {
  stop("Presence/absence input file not found: ", pa_file)
}

cat("\nInput presence/absence file:\n")
cat(pa_file, "\n\n")

cat("Output PNG:\n")
cat(out_png, "\n\n")

## =========================
## 2. 字体设置
## =========================

simsun_file <- "/mnt/c/Windows/Fonts/simsun.ttc"

if (!file.exists(simsun_file)) {
  warning("SimSun font not found: ", simsun_file)
} else {
  sysfonts::font_add(
    family = "SimSun",
    regular = simsun_file
  )
}

showtext::showtext_auto(enable = TRUE)
showtext::showtext_opts(dpi = 600)

## =========================
## 3. 读取已有 SH × status presence/absence 矩阵
## =========================

pa_df <- read.csv(
  pa_file,
  check.names = FALSE,
  stringsAsFactors = FALSE,
  fileEncoding = "UTF-8"
)

if (!"SH" %in% colnames(pa_df)) {
  stop("Input presence/absence file must contain column: SH")
}

status_order_CN <- c("家养", "野生", "圈养野生")

missing_cols <- setdiff(status_order_CN, colnames(pa_df))

if (length(missing_cols) > 0) {
  stop(
    "以下分组列在 presence/absence 文件中不存在： ",
    paste(missing_cols, collapse = ", ")
  )
}

pa_df <- pa_df[, c("SH", status_order_CN), drop = FALSE]

for (st in status_order_CN) {
  pa_df[[st]] <- as.integer(pa_df[[st]])
  pa_df[[st]][is.na(pa_df[[st]])] <- 0
}

set_list <- list()

for (st in status_order_CN) {
  set_list[[st]] <- pa_df$SH[pa_df[[st]] == 1]
}

cat("SH set sizes:\n")
print(sapply(set_list, length))

## =========================
## 4. 按第一版参数生成 Venn grob
## =========================

fill_cols <- c(
  "家养" = "#E64B35",
  "野生" = "#00A087",
  "圈养野生" = "#4DBBD5"
)

make_venn_grob_v1_style <- function() {
  ## 这里严格沿用第一版参数
  VennDiagram::venn.diagram(
    x = set_list,
    filename = NULL,
    fill = fill_cols[names(set_list)],
    alpha = 0.42,
    col = "grey25",
    lwd = 1.4,

    ## 区域数字
    cex = 1.55,
    fontface = "bold",
    fontfamily = "SimSun",
    fontcol = "black",

    ## 分组标签
    cat.cex = 1.55,
    cat.fontface = "bold",
    cat.fontfamily = "SimSun",
    cat.col = "black",

    ## 第一版保留的边距
    margin = 0.045
  )
}

venn_grob <- make_venn_grob_v1_style()

## =========================
## 5. 仅移动“圈养野生”这个标签
## =========================

all_labels <- c()
match_idx <- integer(0)

for (i in seq_along(venn_grob)) {
  g <- venn_grob[[i]]

  if (!is.null(g$label)) {
    lab <- as.character(g$label)
    all_labels <- c(all_labels, lab)

    if (identical(lab, "圈养野生")) {
      match_idx <- c(match_idx, i)
    }
  }
}

cat("\nAll text labels found in venn grob:\n")
print(all_labels)

if (length(match_idx) == 0) {
  stop("未找到标签“圈养野生”，脚本停止。请检查 grob 结构。")
}

if (length(match_idx) > 1) {
  stop("找到多个“圈养野生”标签，脚本停止，以避免误改多个对象。")
}

bottom_idx <- match_idx[1]

cat("\nBottom label grob index:\n")
print(bottom_idx)

cat("\nOriginal bottom label y:\n")
print(venn_grob[[bottom_idx]]$y)

## 只向下移动一点点：
## 这里用 mm 做微调，不影响其他标签。
venn_grob[[bottom_idx]]$y <- venn_grob[[bottom_idx]]$y - unit(2.8, "mm")

cat("\nAdjusted bottom label y:\n")
print(venn_grob[[bottom_idx]]$y)

## =========================
## 6. 输出 PNG / PDF
## =========================

png(
  filename = out_png,
  width = 15.0,
  height = 12.0,
  units = "cm",
  res = 600,
  bg = "white",
  type = "cairo"
)

showtext::showtext_begin()
grid.newpage()
grid.draw(venn_grob)
showtext::showtext_end()

dev.off()

pdf(
  file = out_pdf,
  width = 5.91,
  height = 4.72,
  bg = "white",
  family = "Helvetica"
)

showtext::showtext_begin()
grid.newpage()
grid.draw(venn_grob)
showtext::showtext_end()

dev.off()

## =========================
## 7. 输出 log
## =========================

sink(out_log)

cat("Redraw Fig5-1 status macrofungi SH Venn, v4 move only bottom label\n")
cat("============================================================\n\n")

cat("Input file:\n")
cat(pa_file, "\n\n")

cat("No recomputation performed.\n")
cat("Only the bottom label '圈养野生' was moved downward.\n\n")

cat("Status order:\n")
print(status_order_CN)
cat("\n")

cat("SH set sizes:\n")
print(sapply(set_list, length))
cat("\n")

cat("All text labels found in venn grob:\n")
print(all_labels)
cat("\n")

cat("Bottom label grob index:\n")
print(bottom_idx)
cat("\n")

cat("Original bottom label y:\n")
print(venn_grob[[bottom_idx]]$y + unit(2.8, "mm"))
cat("\n")

cat("Adjusted bottom label y:\n")
print(venn_grob[[bottom_idx]]$y)
cat("\n")

cat("Move distance:\n")
cat("2.8 mm downward\n\n")

cat("Output PNG:\n")
cat(out_png, "\n")
cat("Output PDF:\n")
cat(out_pdf, "\n")

sink()

cat("\nDone!\n")
cat("Adjusted Venn PNG:\n", out_png, "\n")
cat("Adjusted Venn PDF:\n", out_pdf, "\n")
cat("Log:\n", out_log, "\n")
#运行脚本
Rscript scripts/chapter5_macrofungi/06_redraw_status_macrofungi_SH_venn_v4_move_only_bottom_label.R
