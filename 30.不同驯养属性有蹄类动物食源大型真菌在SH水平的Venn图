clean_value <- function(x) {
  x <- trimws(as.character(x))

  x[x %in% c(
    "",
    "NA", "N/A", "na", "n/a",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded", "Not recorded", "NOT RECORDED",
    "not_reported", "not reported", "Not reported", "NOT REPORTED",
    "unknown", "Unknown", "UNKNOWN",
    "none", "None", "NONE",
    "null", "Null", "NULL"
  )] <- NA

  x
}

pick_col <- function(candidates, cols, label) {
  hit <- candidates[candidates %in% cols][1]

  if (is.na(hit)) {
    stop(
      "Cannot find column for ", label,
      ". Tried: ", paste(candidates, collapse = ", "),
      "\nExisting columns:\n", paste(cols, collapse = ", ")
    )
  }

  hit
}

clean_genus <- function(x) {
  x <- trimws(as.character(x))
  x <- gsub("^g__", "", x)
  x <- gsub("^genus__", "", x)
  x[x %in% c("", "NA", "N/A", "Unknown", "unknown", "Unclassified", "unclassified")] <- NA
  x
}

get_meta_value <- function(meta, key) {
  if (is.null(meta)) return(NA_character_)

  if (!is.null(meta[[key]])) {
    return(as.character(meta[[key]]))
  }

  return(NA_character_)
}

