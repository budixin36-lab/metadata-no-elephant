calc_exact_intersections <- function(pa_df, group_cols) {
  res <- list()
  k <- 1

  for (m in seq_along(group_cols)) {
    cmbs <- combn(group_cols, m, simplify = FALSE)

    for (cmb in cmbs) {
      out_sets <- setdiff(group_cols, cmb)

      in_all <- rowSums(pa_df[, cmb, drop = FALSE]) == length(cmb)

      if (length(out_sets) > 0) {
        out_none <- rowSums(pa_df[, out_sets, drop = FALSE]) == 0
      } else {
        out_none <- rep(TRUE, nrow(pa_df))
      }

      exact_SH <- pa_df$SH[in_all & out_none]

      res[[k]] <- data.frame(
        combination = paste(cmb, collapse = " & "),
        n_status = length(cmb),
        status_included = paste(cmb, collapse = "; "),
        status_excluded = paste(out_sets, collapse = "; "),
        n_SH = length(exact_SH),
        SH_list = paste(exact_SH, collapse = "; "),
        stringsAsFactors = FALSE
      )

      k <- k + 1
    }
  }

  out <- do.call(rbind, res)
  out <- out[order(out$n_status, -out$n_SH, out$combination), ]
  rownames(out) <- NULL

  out
}

make_sparse_macro_matrix <- function(biom, macro_row_index0, n_rows_total, n_samples_total) {
  ## 输出矩阵：大型真菌 SH × 样本
  ## macro_row_index0 为 BIOM 中 0-based row index

  macro_row_index0 <- sort(unique(macro_row_index0))
  macro_row_index1 <- macro_row_index0 + 1

  macro_mat <- matrix(
    0,
    nrow = length(macro_row_index1),
    ncol = n_samples_total
  )

  rownames(macro_mat) <- macro_row_index1
  colnames(macro_mat) <- seq_len(n_samples_total)

  if (!is.null(biom$matrix_type) && biom$matrix_type == "sparse") {
    cat("BIOM matrix type: sparse\n")

    dat <- biom$data

    if (length(dat) == 0) {
      return(macro_mat)
    }

    dat_mat <- do.call(rbind, dat)
    dat_mat <- as.data.frame(dat_mat, stringsAsFactors = FALSE)

    colnames(dat_mat) <- c("row", "col", "value")

    dat_mat$row <- as.integer(dat_mat$row)
    dat_mat$col <- as.integer(dat_mat$col)
    dat_mat$value <- as.numeric(dat_mat$value)

    dat_macro <- dat_mat[dat_mat$row %in% macro_row_index0, , drop = FALSE]

    if (nrow(dat_macro) == 0) {
      return(macro_mat)
    }

    row_map <- match(dat_macro$row + 1, macro_row_index1)
    col_map <- dat_macro$col + 1

    macro_mat[cbind(row_map, col_map)] <- dat_macro$value

    return(macro_mat)
  }

  if (!is.null(biom$matrix_type) && biom$matrix_type == "dense") {
    cat("BIOM matrix type: dense\n")

    full_mat <- do.call(rbind, biom$data)
    full_mat <- apply(full_mat, 2, as.numeric)

    macro_mat <- full_mat[macro_row_index1, , drop = FALSE]

    return(macro_mat)
  }

  stop("Unsupported or missing BIOM matrix_type.")
}

