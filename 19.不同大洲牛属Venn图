  set_list[[ct]] <- sh_present

  SH_count_list[[ct]] <- data.frame(
    continent = ct,
    n_samples = length(samples_ct),
    total_SH_richness = length(sh_present),
    total_SH_reads = sum(otu_ct),
    mean_SH_richness_per_sample = round(mean(rowSums(otu_ct > 0)), 3),
    mean_SH_reads_per_sample = round(mean(rowSums(otu_ct)), 3),
    stringsAsFactors = FALSE
  )
