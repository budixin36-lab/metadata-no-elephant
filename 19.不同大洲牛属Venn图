meta_bos <- meta_bos[match(common_samples, meta_bos$sample_id), , drop = FALSE]
rownames(meta_bos) <- meta_bos$sample_id

# 去掉全 0 样本和全 0 SH
otu <- otu[rowSums(otu) > 0, , drop = FALSE]
