common_row_samples <- sum(rownames(mat) %in% meta_bos$sample_id)

if (common_col_samples >= common_row_samples) {
  otu <- t(mat)
} else {
  otu <- mat
}

common_samples <- intersect(rownames(otu), meta_bos$sample_id)

