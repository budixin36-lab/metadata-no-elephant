clean_value <- function(x) {
  x <- trimws(as.character(x))

  x[x %in% c(
    "",
    "NA", "N/A", "na", "n/a",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded", "Not recorded", "NOT RECORDED",
    "not_reported", "not reported", "Not reported", "NOT REPORTED",
    "not applicable", "Not applicable", "NOT APPLICABLE",
    "unknown", "Unknown", "UNKNOWN",
    "none", "None", "NONE",
    "null", "Null", "NULL"
  )] <- NA

  x
}

pick_col <- function(candidates, cols, label) {
  hit <- candidates[candidates %in% cols][1]

  if (is.na(hit)) {
    stop(
      "Cannot find column for ", label,
      ". Tried: ", paste(candidates, collapse = ", "),
      "\nExisting columns:\n", paste(cols, collapse = ", ")
    )
  }

  hit
}

read_biom_tsv <- function(file) {
  if (!file.exists(file)) {
    stop("SH abundance table not found: ", file)
  }

  lines_head <- readLines(file, n = 20, warn = FALSE)
  header_line <- grep("^#OTU ID|^#OTUID|^#Feature ID|^Feature ID", lines_head)[1]

  if (is.na(header_line)) {
    tab <- read.delim(
      file,
      check.names = FALSE,
      stringsAsFactors = FALSE,
      comment.char = "",
      quote = ""
    )
  } else {
    tab <- read.delim(
      file,
      skip = header_line - 1,
      check.names = FALSE,
      stringsAsFactors = FALSE,
      comment.char = "",
      quote = ""
    )
  }

  colnames(tab)[1] <- "SH"

  taxonomy_cols <- which(tolower(colnames(tab)) %in% c(
    "taxonomy",
    "consensus.lineage",
    "consensus lineage"
  ))

  if (length(taxonomy_cols) > 0) {
    tab <- tab[, -taxonomy_cols, drop = FALSE]
  }

  tab
}

calc_exact_intersections <- function(pa_df, group_cols) {
  res <- list()
  k <- 1

  for (m in seq_along(group_cols)) {
    cmbs <- combn(group_cols, m, simplify = FALSE)

    for (cmb in cmbs) {
      out_sets <- setdiff(group_cols, cmb)

      in_all <- rowSums(pa_df[, cmb, drop = FALSE]) == length(cmb)

      if (length(out_sets) > 0) {
        out_none <- rowSums(pa_df[, out_sets, drop = FALSE]) == 0
      } else {
        out_none <- rep(TRUE, nrow(pa_df))
      }

      exact_SH <- pa_df$SH[in_all & out_none]

      res[[k]] <- data.frame(
        combination = paste(cmb, collapse = " & "),
        n_continents = length(cmb),
        continents_included = paste(cmb, collapse = "; "),
        continents_excluded = paste(out_sets, collapse = "; "),
        n_SH = length(exact_SH),
        SH_list = paste(exact_SH, collapse = "; "),
        stringsAsFactors = FALSE
      )

      k <- k + 1
    }
  }

  out <- do.call(rbind, res)
  out <- out[order(-out$n_SH, out$n_continents, out$combination), ]
  rownames(out) <- NULL
  out
}

make_venn_plot <- function(set_list, out_png, out_pdf) {
  # 与论文图风格保持一致：白底、简体中文标签、无图内标题
  fill_cols <- c(
    "亚洲" = "#E64B35",
    "欧洲" = "#4DBBD5",
    "非洲" = "#00A087",
    "北美洲" = "#F39B7F"
  )

  fill_use <- fill_cols[names(set_list)]

  venn_grob <- VennDiagram::venn.diagram(
    x = set_list,
    filename = NULL,
    fill = fill_use,
    alpha = 0.45,
    col = "grey30",
    lwd = 1.2,
    cex = 1.20,
    fontface = "bold",
    fontfamily = "SimSun",
    cat.cex = 1.30,
    cat.fontface = "bold",
    cat.fontfamily = "SimSun",
    cat.col = "black",
    margin = 0.08
  )

  png(
    filename = out_png,
    width = 8.5,
    height = 7.5,
    units = "in",
    res = 600,
    bg = "white",
    type = "cairo"
  )
  if (has_showtext) showtext::showtext_begin()
  grid.newpage()
  grid.draw(venn_grob)
  if (has_showtext) showtext::showtext_end()
  dev.off()

  pdf(
    file = out_pdf,
    width = 8.5,
    height = 7.5,
    bg = "white",
    family = "Helvetica"
  )
  if (has_showtext) showtext::showtext_begin()
  grid.newpage()
  grid.draw(venn_grob)
  if (has_showtext) showtext::showtext_end()
  dev.off()
}

