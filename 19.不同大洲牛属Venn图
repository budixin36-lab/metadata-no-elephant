fix_text_grob <- function(g, number_fontsize = 18, label_fontsize = 16) {
  if (inherits(g, "text")) {
    lab <- as.character(g$label)

    is_number_label <- all(grepl("^[0-9]+$", lab))

    if (is_number_label) {
      g$gp <- grid::gpar(
        fontsize = number_fontsize,
        fontfamily = "SimSun",
        fontface = "bold",
        col = "black"
      )
    } else {
      g$gp <- grid::gpar(
        fontsize = label_fontsize,
        fontfamily = "SimSun",
        fontface = "bold",
        col = "black"
      )
    }
  }

  if (!is.null(g$children)) {
    g$children <- do.call(
      grid::gList,
      lapply(
        g$children,
        fix_text_grob,
        number_fontsize = number_fontsize,
        label_fontsize = label_fontsize
      )
    )
  }

  g
}

make_fixed_venn_grob <- function(number_fontsize = 18, label_fontsize = 16) {
  fill_cols <- c(
    "亚洲" = "#E64B35",
    "欧洲" = "#4DBBD5",
    "非洲" = "#00A087",
    "北美洲" = "#F39B7F"
  )

  # 这里 x 的顺序非常重要：
  # 1 亚洲，2 欧洲，3 非洲，4 北美洲
  # VennDiagram 的 4 组图位置会对应为：
  # 亚洲左侧，欧洲右侧，非洲左上，北美洲右上。
  venn_grobs <- VennDiagram::venn.diagram(
    x = set_list,
    filename = NULL,
    fill = fill_cols[names(set_list)],
    alpha = 0.38,
    col = "grey25",
    lwd = 1.5,

    # 这里先给基础值，真正字号在后面用 grob 修改
    cex = 1,
    cat.cex = 1,
    fontface = "bold",
    cat.fontface = "bold",
    fontfamily = "SimSun",
    cat.fontfamily = "SimSun",
    fontcol = "black",
    cat.col = "black",

    # 保持图形占画布比例，减少空白
    margin = 0.035
  )

  venn_grobs <- lapply(
    venn_grobs,
    fix_text_grob,
    number_fontsize = number_fontsize,
    label_fontsize = label_fontsize
  )

  do.call(grid::gList, venn_grobs)
}

