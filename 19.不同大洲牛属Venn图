png(
  filename = out_png,
  width = 15.5,
  height = 13.0,
  units = "cm",
  res = 600,
  bg = "white",
  type = "cairo"
)

showtext::showtext_begin()
grid.newpage()
grid.draw(make_venn_grob())
showtext::showtext_end()

dev.off()

# =========================
# 7. 输出 PDF
# =========================
# PDF 也输出一份，但这次重点检查 PNG。
# PDF 为矢量图，字号一般不会出现 PNG 那种 dpi 缩放问题。
pdf(
  file = out_pdf,
  width = 6.10,
  height = 5.12,
  bg = "white",
  family = "Helvetica"
)

showtext::showtext_begin()
grid.newpage()
grid.draw(make_venn_grob())
showtext::showtext_end()

dev.off()

# =========================
# 8. log
# =========================
sink(out_log)

cat("Bos continent SH Venn plot, showtext dpi fixed\n")
cat("==============================================\n\n")

cat("Input PA matrix:\n", pa_file, "\n\n")

cat("Fixed continent order:\n")
print(continent_order)

cat("\nVenn layout:\n")
cat("亚洲: left ellipse\n")
cat("欧洲: right ellipse\n")
cat("非洲: upper-left ellipse\n")
cat("北美洲: upper-right ellipse\n\n")

cat("SH numbers by continent:\n")
print(sapply(set_list, length))

if (!is.null(sample_counts)) {
  cat("\nSample counts by continent:\n")
  print(sample_counts)
}

cat("\nshowtext dpi:\n")
print(showtext::showtext_opts())

cat("\nOutput PNG:\n", out_png, "\n")
cat("Output PDF:\n", out_pdf, "\n")

sink()

cat("\nDone!\n")
cat("PNG:\n", out_png, "\n")
cat("PDF:\n", out_pdf, "\n")
cat("Log:\n", out_log, "\n")

EOF

