format_anova_label <- function(p) {
  if (length(p) == 0 || is.na(p)) {
    return("ANOVA: P = NA")
  }

  if (p < 0.001) {
    return("ANOVA: P < 0.001")
  }

  paste0("ANOVA: P = ", sprintf("%.4f", p))
}

extract_letters_from_paper_table <- function(paper_df, metrics) {
  out <- paper_df %>%
    filter(
      !is.na(group),
      group != "",
      !grepl("^ANOVA", group)
    ) %>%
    select(group, all_of(metrics))

  for (m in metrics) {
    out[[m]] <- str_extract(as.character(out[[m]]), "[A-Za-z]+$")
  }

  out
}

get_upper_whisker <- function(x) {
  x <- x[is.finite(x)]
  if (length(x) == 0) return(NA_real_)
  boxplot.stats(x)$stats[5]
}

plot_alpha_box_letters <- function(alpha_df, letters_df, anova_df, metric, out_png) {

  dat <- alpha_df %>%
    select(host_family, value = all_of(metric)) %>%
    filter(!is.na(host_family), !is.na(value), host_family %in% family_order)

  dat$host_family <- factor(dat$host_family, levels = family_order)

  letter_dat <- letters_df %>%
    select(group, letter = all_of(metric)) %>%
    rename(host_family = group) %>%
    filter(host_family %in% family_order)

  letter_dat$host_family <- factor(letter_dat$host_family, levels = family_order)

  whisker_df <- dat %>%
    group_by(host_family) %>%
    summarise(
      upper_whisker = get_upper_whisker(value),
      .groups = "drop"
    ) %>%
    left_join(letter_dat, by = "host_family") %>%
    arrange(host_family)

  y_min <- min(dat$value, na.rm = TRUE)
  y_max <- max(dat$value, na.rm = TRUE)
  y_range <- y_max - y_min

  if (!is.finite(y_range) || y_range == 0) {
    y_range <- max(abs(y_max), 1)
  }

  whisker_df <- whisker_df %>%
    mutate(
      err_ymin = upper_whisker + 0.02 * y_range,
      err_ymax = upper_whisker + 0.10 * y_range,
      letter_y = err_ymax + 0.025 * y_range
    )

  max_letter_y <- max(whisker_df$letter_y, na.rm = TRUE)

  anova_p <- anova_df %>%
    filter(metric == !!metric) %>%
    pull(P_value_raw)

  anova_label <- format_anova_label(anova_p[1])

  anova_y <- max_letter_y + 0.10 * y_range
  y_top <- anova_y + 0.10 * y_range

  p <- ggplot(
    dat,
    aes(
      x = host_family,
      y = value,
      fill = host_family
    )
  ) +
    geom_boxplot(
      width = 0.56,
      outlier.shape = NA,
      linewidth = 0.40,
      color = "black"
    ) +
    geom_errorbar(
      data = whisker_df,
      aes(
        x = host_family,
        ymin = err_ymin,
        ymax = err_ymax
      ),
      width = 0.18,
      linewidth = 0.35,
      inherit.aes = FALSE
    ) +
    geom_text(
      data = whisker_df,
      aes(
        x = host_family,
        y = letter_y,
        label = letter
      ),
      family = "songti",
      size = 3.2,
      vjust = 0,
      inherit.aes = FALSE
    ) +
    scale_fill_manual(
      values = family_colors,
      drop = FALSE
    ) +
    scale_x_discrete(
      labels = family_label_map
    ) +
    coord_cartesian(
      ylim = c(y_min, y_top),
      clip = "off"
    ) +
    labs(
      x = NULL,
      y = metric_y_labels[[metric]]
    ) +
    theme_classic(base_family = "songti") +
    theme(
      axis.title.y = element_text(
        size = 10.5,
        family = "songti",
        colour = "black"
      ),
      axis.text.x = element_text(
        size = 10,
        family = "songti",
        colour = "black"
      ),
      axis.text.y = element_text(
        size = 9,
        family = "songti",
        colour = "black"
      ),
      axis.line = element_line(
        linewidth = 0.40,
        colour = "black"
      ),
      axis.ticks = element_line(
        linewidth = 0.40,
        colour = "black"
      ),
      legend.position = "none",
      plot.margin = margin(t = 8, r = 8, b = 6, l = 8)
    ) +
    annotate(
      "text",
      x = 0.62,
      y = anova_y,
      label = anova_label,
      hjust = 0,
      vjust = 1,
      family = "songti",
      size = 2.8
    )

  ggsave(
    filename = out_png,
    plot = p,
    width = 7.1,
    height = 5.2,
    units = "cm",
    dpi = 600,
    bg = "white"
  )

  ggsave(
    filename = sub("\\.png$", ".pdf", out_png),
    plot = p,
    width = 7.1,
    height = 5.2,
    units = "cm",
    bg = "white"
  )
}

