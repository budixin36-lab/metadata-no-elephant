        linewidth = 0.40,
        colour = "black"
      ),
      legend.position = "none",
      plot.margin = margin(t = 8, r = 8, b = 6, l = 8)
    ) +
    annotate(
      "text",
      x = 0.62,
      y = anova_y,
      label = anova_label,
      hjust = 0,
      vjust = 1,
      family = "songti",
      size = 2.8
    )

  ggsave(
    filename = out_png,
    plot = p,
    width = 7.1,
    height = 5.2,
    units = "cm",
    dpi = 600,
    bg = "white"
  )

  ggsave(
    filename = sub("\\.png$", ".pdf", out_png),
    plot = p,
    width = 7.1,
    height = 5.2,
    units = "cm",
    bg = "white"
  )
