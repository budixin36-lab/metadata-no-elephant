        accepted_name_joined,
        direct_primary_lifestyle = primary_lifestyle_joined,
        direct_lifestyle_cn = primary_lifestyle_cn,
        direct_status,
        direct_comment = comment_joined
      ),
    by = "genus_key"
  ) %>%
  left_join(
    synonym_map %>%
      select(
        synonym_target_key,
        synonym_source_genera,
        synonym_lifestyle_joined,
        synonym_lifestyle_cn = primary_lifestyle_cn,
        synonym_comments
      ),
    by = c("genus_key" = "synonym_target_key")
  ) %>%
  mutate(
    match_method = case_when(
      !is.na(direct_lifestyle_cn) & direct_lifestyle_cn != "未分类" ~ "direct_GENUS",
      (is.na(direct_lifestyle_cn) | direct_lifestyle_cn == "未分类") &
        !is.na(synonym_lifestyle_cn) &
        synonym_lifestyle_cn != "未分类" ~ "synonym_comment_fallback",
      !is.na(direct_status) & direct_status == "direct_missing_or_ambiguous" ~ "direct_missing_or_ambiguous",
      TRUE ~ "unmatched"
    ),
    primary_lifestyle_cn = case_when(
      !is.na(direct_lifestyle_cn) & direct_lifestyle_cn != "未分类" ~ direct_lifestyle_cn,
      (is.na(direct_lifestyle_cn) | direct_lifestyle_cn == "未分类") &
        !is.na(synonym_lifestyle_cn) &
        synonym_lifestyle_cn != "未分类" ~ synonym_lifestyle_cn,
      TRUE ~ "未分类"
    ),
    primary_lifestyle_cn = ifelse(
      primary_lifestyle_cn %in% c("未定义型", "未分类"),
      "未分类",
      primary_lifestyle_cn
    )
  )

