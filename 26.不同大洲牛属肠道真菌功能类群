missing_color <- setdiff(present_groups, names(function_colors))

if (length(missing_color) > 0) {
  stop(
    "以下功能类群缺少颜色，请补充：",
    paste(missing_color, collapse = ", ")
  )
}

used_colors <- function_colors[present_groups]

