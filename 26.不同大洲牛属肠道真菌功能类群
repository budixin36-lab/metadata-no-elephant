      n_distinct(primary_lifestyle_cn[!is.na(primary_lifestyle_cn)]) == 1,
      unique(primary_lifestyle_cn[!is.na(primary_lifestyle_cn)])[1],
      "未分类"
    ),
    synonym_comments = paste(unique(na.omit(comment_on_genus)), collapse = "; "),
    .groups = "drop"
  ) %>%
  filter(primary_lifestyle_cn != "未分类")

