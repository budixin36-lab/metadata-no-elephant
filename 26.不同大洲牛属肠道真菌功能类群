  "节肢动物相关型" = "节肢动物相关菌",
  "节肢动物相关菌" = "节肢动物相关菌",

  "食细菌型" = "食细菌型",
  "食细菌型" = "食细菌型",

  "食藻/食原生生物型" = "食藻/食原生生物型",
  "食藻/食原生生物型" = "食藻/食原生生物型",

  ## 未分类
  "未定义型" = "未分类",
  "未分类" = "未分类"
)

df$function_group_cn <- ifelse(
  df$primary_lifestyle_cn %in% names(label_map),
  unname(label_map[df$primary_lifestyle_cn]),
  df$primary_lifestyle_cn
)

df$function_group_cn[is.na(df$function_group_cn) | df$function_group_cn == ""] <- "未分类"

## 合并映射后同名功能类群
plot_df0 <- df %>%
  group_by(continent_CN, function_group_cn) %>%
  summarise(
    mean_relative_abundance = sum(mean_relative_abundance, na.rm = TRUE),
    .groups = "drop"
  )

