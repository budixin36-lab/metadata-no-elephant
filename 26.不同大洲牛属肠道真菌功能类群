## 如果出现旧误写“从枝菌根真菌”，统一成“丛枝菌根真菌”
plot_df0$function_group_cn[plot_df0$function_group_cn == "从枝菌根真菌"] <- "丛枝菌根真菌"

function_order <- unique(function_order)
function_order <- function_order[function_order != "从枝菌根真菌"]

## 补齐所有大洲 × 功能类群
present_all <- unique(plot_df0$function_group_cn)
extra_groups <- setdiff(present_all, function_order)
function_order_all <- c(function_order, sort(extra_groups))

plot_df <- expand.grid(
  continent_CN = continent_order,
  function_group_cn = function_order_all,
  stringsAsFactors = FALSE
) %>%
  left_join(
    plot_df0,
    by = c("continent_CN", "function_group_cn")
  ) %>%
  mutate(
    mean_relative_abundance = ifelse(is.na(mean_relative_abundance), 0, mean_relative_abundance)
  )

## 只保留实际出现的功能类群
present_groups <- plot_df %>%
  group_by(function_group_cn) %>%
  summarise(total_mean = sum(mean_relative_abundance), .groups = "drop") %>%
  filter(total_mean > 0) %>%
  pull(function_group_cn)

present_groups <- function_order_all[function_order_all %in% present_groups]

plot_df <- plot_df %>%
  filter(function_group_cn %in% present_groups) %>%
  mutate(
    continent_CN = factor(continent_CN, levels = continent_order),
    function_group_cn = factor(function_group_cn, levels = present_groups)
  ) %>%
  arrange(continent_CN, function_group_cn)

