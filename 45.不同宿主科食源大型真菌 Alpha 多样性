)

write.csv(family_paper_no_n, out_paper_no_n_csv, row.names = FALSE, fileEncoding = "UTF-8")
write.csv(family_paper_with_n, out_paper_with_n_csv, row.names = FALSE, fileEncoding = "UTF-8")
write.csv(family_mean_sd_detail, out_mean_sd_csv, row.names = FALSE, fileEncoding = "UTF-8")
