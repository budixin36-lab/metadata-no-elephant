## =========================
## 5. 读取 metadata
## =========================

cat("读取 metadata ...\n")

meta <- read.csv(
  metadata_file,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "UTF-8"
)

needed_meta_cols <- c("sampleid", "host_family")
missing_meta_cols <- setdiff(needed_meta_cols, colnames(meta))

if (length(missing_meta_cols) > 0) {
  stop(
    "metadata 缺少必要列：",
    paste(missing_meta_cols, collapse = ", "),
    "\n当前列名为：",
    paste(colnames(meta), collapse = " | ")
  )
}

meta2 <- meta %>%
  transmute(
    sample_id = clean_value(sampleid),
    host_family = clean_value(host_family),
    host_family_CN = unname(family_label_map[host_family])
  ) %>%
  filter(
    !is.na(sample_id),
    sample_id != "",
    !is.na(host_family),
    host_family %in% family_order_en,
    !is.na(host_family_CN)
  ) %>%
  distinct(sample_id, .keep_all = TRUE)

meta2$host_family_CN <- factor(meta2$host_family_CN, levels = family_order_cn)

cat("metadata 有效 host_family 样本数：", nrow(meta2), "\n", sep = "")
cat("host_family 样本数：\n")
print(table(meta2$host_family_CN))

## =========================
## 6. 读取食源大型真菌 SH abundance table
## =========================

cat("\n读取食源大型真菌 SH abundance table ...\n")

macro_tab <- read.delim(
  macrofungi_SH_abundance_file,
  header = TRUE,
  sep = "\t",
  check.names = FALSE,
  stringsAsFactors = FALSE,
  comment.char = "",
  quote = ""
)

if (!"SH" %in% colnames(macro_tab)) {
  stop(
    "大型真菌 SH abundance table 缺少 SH 列。\n当前列名为：",
    paste(colnames(macro_tab), collapse = " | ")
  )
}

feature_ids <- as.character(macro_tab$SH)

mat_df <- macro_tab[, setdiff(colnames(macro_tab), "SH"), drop = FALSE]

for (cc in colnames(mat_df)) {
  mat_df[[cc]] <- suppressWarnings(as.numeric(as.character(mat_df[[cc]])))
  mat_df[[cc]][is.na(mat_df[[cc]])] <- 0
}

mat <- as.matrix(mat_df)
rownames(mat) <- feature_ids
storage.mode(mat) <- "numeric"

## 目标方向：SH × sample
common_samples <- intersect(colnames(mat), meta2$sample_id)

if (length(common_samples) == 0) {
  stop("食源大型真菌 SH abundance table 和 metadata 没有匹配到共同样本。")
}

mat <- mat[, common_samples, drop = FALSE]

meta_use <- meta2 %>%
  filter(sample_id %in% common_samples)

meta_use <- meta_use[match(colnames(mat), meta_use$sample_id), ]

if (!all(meta_use$sample_id == colnames(mat))) {
  stop("metadata 与丰度表样本顺序匹配失败。")
}

sample_total <- colSums(mat, na.rm = TRUE)

zero_samples <- data.frame(
  sample_id = names(sample_total)[sample_total <= 0],
  total_macrofungi_reads = sample_total[sample_total <= 0],
  stringsAsFactors = FALSE
)

write.csv(
  zero_samples,
  out_zero_samples,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

valid_samples <- names(sample_total)[sample_total > 0]

if (length(valid_samples) == 0) {
  stop("所有样本的大型真菌 reads 均为 0，无法计算 alpha 多样性。")
}

mat <- mat[, valid_samples, drop = FALSE]

meta_use <- meta_use %>%
  filter(sample_id %in% valid_samples)

meta_use <- meta_use[match(colnames(mat), meta_use$sample_id), ]

cat("共同样本数：", length(common_samples), "\n", sep = "")
cat("大型真菌 reads = 0 样本数：", nrow(zero_samples), "\n", sep = "")
cat("进入 alpha 分析样本数：", ncol(mat), "\n", sep = "")
cat("大型真菌 SH 数：", nrow(mat), "\n", sep = "")
cat("进入 alpha 分析的宿主科样本数：\n")
print(table(meta_use$host_family_CN))

## vegan 要求 sample × feature
comm <- t(mat)

## =========================
## 7. 计算 alpha 多样性
## =========================

cat("\nCalculating alpha diversity ...\n")

est <- estimateR(comm)

alpha_df <- data.frame(
  sample_id = rownames(comm),
  Observed_macrofungi_SH = specnumber(comm),
  ACE = as.numeric(est["S.ACE", ]),
  Chao1 = as.numeric(est["S.chao1", ]),
  Shannon = diversity(comm, index = "shannon"),
  Simpson = diversity(comm, index = "simpson"),
  stringsAsFactors = FALSE
)

alpha_df <- alpha_df %>%
  left_join(
    meta_use %>% select(sample_id, host_family_CN),
    by = "sample_id"
  ) %>%
  relocate(sample_id, host_family_CN)

alpha_df$host_family_CN <- factor(alpha_df$host_family_CN, levels = family_order_cn)

write.csv(
  alpha_df,
  out_alpha_sample,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

## =========================
## 8. 统计检验与表格
## =========================

alpha_family <- alpha_df %>%
  filter(!is.na(host_family_CN), host_family_CN != "")

alpha_family$host_family_CN <- factor(alpha_family$host_family_CN, levels = family_order_cn)

family_sample_count <- alpha_family %>%
  count(host_family_CN, name = "n") %>%
  mutate(host_family_CN = factor(host_family_CN, levels = family_order_cn)) %>%
  arrange(host_family_CN) %>%
  mutate(host_family_CN = as.character(host_family_CN))

write.csv(
  family_sample_count,
  out_sample_count_csv,
  row.names = FALSE,
