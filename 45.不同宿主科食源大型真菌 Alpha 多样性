plot_alpha_box_letters <- function(alpha_df, letters_df, anova_df, metric, out_file) {

  dat <- alpha_df %>%
    select(host_family_CN, value = all_of(metric)) %>%
    filter(
      !is.na(host_family_CN),
      !is.na(value),
      host_family_CN %in% family_order_cn
    )

  dat$host_family_CN <- factor(dat$host_family_CN, levels = family_order_cn)

  letter_dat <- letters_df %>%
    select(group, letter = all_of(metric)) %>%
    rename(host_family_CN = group) %>%
    filter(host_family_CN %in% family_order_cn)

  letter_dat$host_family_CN <- factor(letter_dat$host_family_CN, levels = family_order_cn)

  letter_pos_df <- dat %>%
    group_by(host_family_CN) %>%
    summarise(
      upper_whisker = get_upper_whisker(value),
      .groups = "drop"
    ) %>%
    left_join(letter_dat, by = "host_family_CN") %>%
    arrange(host_family_CN)

  y_min <- min(dat$value, na.rm = TRUE)
  y_max <- max(dat$value, na.rm = TRUE)
  y_range <- y_max - y_min

  if (!is.finite(y_range) || y_range == 0) {
    y_range <- max(abs(y_max), 1)
  }

  letter_pos_df <- letter_pos_df %>%
    mutate(
      letter_y = upper_whisker + 0.050 * y_range
    )

  max_letter_y <- max(letter_pos_df$letter_y, na.rm = TRUE)

  anova_p <- anova_df %>%
    filter(metric == !!metric) %>%
    pull(P_value_raw)

  anova_label <- format_anova_label(anova_p[1])

  anova_y <- max_letter_y + 0.13 * y_range
  y_top <- anova_y + 0.10 * y_range

  p <- ggplot(
    dat,
    aes(
      x = host_family_CN,
      y = value,
      fill = host_family_CN
    )
  ) +
    geom_boxplot(
