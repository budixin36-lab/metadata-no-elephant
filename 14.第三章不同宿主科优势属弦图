fmt_tick <- function(x) {
  ifelse(
    abs(x - round(x)) < 1e-6,
    as.character(round(x)),
    sprintf("%.1f", x)
  )
}

nice_axis_at <- function(sector, xmax, drop_sectors) {
  if (is.na(xmax) || xmax <= 0) return(NULL)

  if (xmax > 20) {
    at <- seq(0, floor(xmax / 20) * 20, by = 20)
    if (length(at) == 0) at <- 0
    if (abs(max(at) - xmax) > 1e-6) {
      at <- c(at, xmax)
    }
  } else if (xmax >= 15) {
    at <- c(0, 10, xmax)
  } else {
    at <- c(0, xmax)
  }

  at <- at[at >= 0 & at <= xmax]
  at <- unique(round(at, 6))

  ## 对容易重叠的扇区删除倒数第二个刻度，但保留最大值
  if (sector %in% drop_sectors && length(at) >= 3) {
    at <- at[-(length(at) - 1)]
  }

  at
}

nice_axis_lab <- function(at) {
  if (is.null(at) || length(at) == 0) return(character(0))
  fmt_tick(at)
}

