## -----------------------------
## 0. Helper functions
## -----------------------------
clean_taxon_name <- function(x) {
  x <- as.character(x)
  x <- str_trim(x)
  x <- str_replace_all(x, "^['\"]|['\"]$", "")
  x <- str_replace(x, "^[a-z]__", "")
  x <- str_replace_all(x, "_", " ")
  x[is.na(x) | x == "" | tolower(x) %in% c("na", "unassigned", "unidentified", "uncultured")] <- "Unclassified"
  x
}

extract_rank_from_taxonomy <- function(taxonomy, rank = "p") {
  x <- str_extract(as.character(taxonomy), paste0(rank, "__[^;|]+"))
  x <- str_replace(x, paste0("^", rank, "__"), "")
  clean_taxon_name(x)
}

calc_group_mean <- function(abund_mat, meta_df, group_col = "host_family", group_levels = NULL) {
  if (is.null(group_levels)) group_levels <- unique(meta_df[[group_col]])
  out <- sapply(group_levels, function(g) {
    samp <- meta_df$sample_id[meta_df[[group_col]] == g]
    if (length(samp) == 1) {
      abund_mat[, samp]
    } else {
      rowMeans(abund_mat[, samp, drop = FALSE])
    }
  })
  out <- as.matrix(out)
  colnames(out) <- group_levels
  out
}

## -----------------------------
## 1. Paths
## -----------------------------
base_dir <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant"

metadata_file <- file.path(
  base_dir,
  "metadata/metadata_valid_globalfungi_SH_nozero_no_elephant.csv"
)

sh_table_file <- file.path(
  base_dir,
  "abundance_tables/SH_abundance_table_no_elephant.tsv"
)

## no_elephant 目录可能没有单独复制 taxonomy 文件，因此自动回退到原目录
taxonomy_candidates <- c(
  file.path(base_dir, "taxonomy/SH_taxonomy_matched.tsv"),
  "/mnt/d/ITS_SH_pipeline/globalfungi_style_test/taxonomy/SH_taxonomy_matched.tsv"
)

taxonomy_file <- taxonomy_candidates[file.exists(taxonomy_candidates)][1]

if (is.na(taxonomy_file)) {
  stop(
    "找不到 SH_taxonomy_matched.tsv。已尝试：\n",
    paste(taxonomy_candidates, collapse = "\n")
  )
}

out_dir <- file.path(
  base_dir,
  "results/chapter3_family_composition_no_elephant"
)

dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)

cat("Using taxonomy file: ", taxonomy_file, "\n", sep = "")

## -----------------------------
## 2. Read metadata
## -----------------------------
meta <- read.csv(
  metadata_file,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

possible_sample_cols <- c("sample_id", "SampleID", "sampleid", "sample_name", "id", "#SampleID")
sample_col <- possible_sample_cols[possible_sample_cols %in% colnames(meta)][1]

if (is.na(sample_col)) {
  stop("没有找到样本 ID 列，请检查 metadata。")
}

if (!"host_family" %in% colnames(meta)) {
  stop("metadata 中没有 host_family 列。")
}

meta <- meta %>%
  mutate(
    sample_id = .data[[sample_col]],
    host_family = trimws(as.character(host_family))
  ) %>%
  filter(
    !is.na(sample_id),
    sample_id != "",
    !is.na(host_family),
    host_family != "",
    host_family != "NA",
    host_family != "missing",
    host_family != "not_recorded",
    host_family != "not reported"
  ) %>%
  distinct(sample_id, .keep_all = TRUE)

## -----------------------------
## 3. Read SH abundance table
## -----------------------------
if (!file.exists(sh_table_file)) {
  stop("找不到 SH abundance table：", sh_table_file)
}

sh_lines <- readLines(sh_table_file, warn = FALSE)
sh_lines <- sh_lines[nchar(trimws(sh_lines)) > 0]

if (grepl("^# Constructed from biom file", sh_lines[1])) {
  sh_lines <- sh_lines[-1]
}

if (!grepl("^#OTU ID\t|^#OTU ID$", sh_lines[1])) {
  stop(
    "SH abundance table 表头异常。文件前几行：\n",
    paste(head(sh_lines, 5), collapse = "\n")
  )
}

sh_raw <- read.delim(
  text = paste(sh_lines, collapse = "\n"),
  header = TRUE,
  sep = "\t",
  check.names = FALSE,
  stringsAsFactors = FALSE,
  quote = "",
  comment.char = ""
)

colnames(sh_raw)[1] <- "SH_ID"

taxonomy_cols <- grep("taxonomy|metadata", colnames(sh_raw), ignore.case = TRUE, value = TRUE)
if (length(taxonomy_cols) > 0) {
  sh_raw <- sh_raw[, !colnames(sh_raw) %in% taxonomy_cols, drop = FALSE]
}

rownames(sh_raw) <- sh_raw$SH_ID
mat <- as.matrix(sh_raw[, -1, drop = FALSE])
mode(mat) <- "numeric"

## -----------------------------
## 4. Match samples
## -----------------------------
common_samples <- intersect(colnames(mat), meta$sample_id)

if (length(common_samples) == 0) {
  stop("SH abundance table 样本名与 metadata 样本名没有交集。")
}

mat <- mat[, common_samples, drop = FALSE]

meta2 <- meta %>%
  filter(sample_id %in% common_samples) %>%
  distinct(sample_id, .keep_all = TRUE)

meta2 <- meta2[match(colnames(mat), meta2$sample_id), ]

## 宿主科顺序：按样本数从大到小
family_sample_counts <- meta2 %>%
  count(host_family, name = "sample_n") %>%
  arrange(desc(sample_n))

host_families <- family_sample_counts$host_family

cat("Matched samples: ", ncol(mat), "\n", sep = "")
cat("Host family sample numbers:\n")
print(family_sample_counts)

## -----------------------------
## 5. Convert to relative abundance (%)
## -----------------------------
sample_sums <- colSums(mat)

if (any(sample_sums == 0)) {
  stop("仍存在总 reads = 0 的样本，请检查。")
}

mat_rel <- sweep(mat, 2, sample_sums, FUN = "/") * 100

## -----------------------------
## 6. Read taxonomy and parse phylum
## -----------------------------
tax_raw <- read.delim(
  taxonomy_file,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

possible_id_cols <- c("SH", "SH_ID", "Feature.ID", "FeatureID", "feature_id", "ID", "id", "#OTUID", "OTUID")
id_col <- possible_id_cols[possible_id_cols %in% colnames(tax_raw)][1]
if (is.na(id_col)) {
  id_col <- colnames(tax_raw)[1]
  message("未识别标准 SH 列，默认使用第一列：", id_col)
}

possible_tax_cols <- c("taxonomy", "Taxon", "taxon", "Taxonomy", "UNITE_taxonomy")
tax_col <- possible_tax_cols[possible_tax_cols %in% colnames(tax_raw)][1]

if (!is.na(tax_col)) {
  tax_df <- tax_raw %>%
    transmute(
      SH_ID = .data[[id_col]],
      taxonomy = as.character(.data[[tax_col]])
    ) %>%
    mutate(
      phylum = extract_rank_from_taxonomy(taxonomy, "p")
    )
} else {
  if (!"phylum" %in% colnames(tax_raw)) {
    stop("taxonomy 文件中既没有 taxonomy 列，也没有 phylum 列。")
  }
  tax_df <- tax_raw %>%
    transmute(
      SH_ID = .data[[id_col]],
      phylum = clean_taxon_name(phylum)
    )
}

tax_df <- tax_df %>%
  mutate(
    phylum = ifelse(is.na(phylum) | phylum == "", "Unclassified", phylum)
  ) %>%
  distinct(SH_ID, .keep_all = TRUE)

tax_match <- tax_df[match(rownames(mat_rel), tax_df$SH_ID), ]

if (nrow(tax_match) != nrow(mat_rel)) {
  stop("taxonomy 与丰度表 feature 行数不匹配。")
}

tax_match$phylum[is.na(tax_match$phylum)] <- "Unclassified"

## -----------------------------
## 7. Aggregate to phylum
## -----------------------------
phylum_mat <- rowsum(mat_rel, group = tax_match$phylum, reorder = FALSE)

## -----------------------------
## 8. Mean composition by host_family
## -----------------------------
phylum_family_mean <- calc_group_mean(phylum_mat, meta2, "host_family", host_families)

write.csv(
  as.data.frame(phylum_family_mean) %>% rownames_to_column("phylum"),
  file.path(out_dir, "host_family_phylum_mean_relative_abundance_no_elephant.csv"),
  row.names = FALSE
)

## -----------------------------
## 9. Plot all phyla (no Others)
## -----------------------------
phylum_plot_df <- as.data.frame(phylum_family_mean) %>%
  rownames_to_column("phylum") %>%
  pivot_longer(
    cols = all_of(host_families),
    names_to = "host_family",
    values_to = "relative_abundance"
  )

## 门顺序：按整体平均相对多度从高到低
phylum_order <- phylum_plot_df %>%
  group_by(phylum) %>%
  summarise(mean_abund = mean(relative_abundance), .groups = "drop") %>%
  arrange(desc(mean_abund)) %>%
  pull(phylum)

phylum_plot_df$phylum <- factor(phylum_plot_df$phylum, levels = phylum_order)
phylum_plot_df$host_family <- factor(phylum_plot_df$host_family, levels = host_families)

## 保存长表，便于后续写正文
write.csv(
  phylum_plot_df,
  file.path(out_dir, "host_family_phylum_mean_relative_abundance_long_no_elephant.csv"),
  row.names = FALSE
)

## 配色
n_phyla <- length(phylum_order)
fill_cols <- setNames(hcl.colors(n_phyla, palette = "Dynamic"), phylum_order)

p_phylum <- ggplot(phylum_plot_df, aes(x = host_family, y = relative_abundance, fill = phylum)) +
