all_cols <- rep(cycle_cols, length.out = length(phylum_order))
phylum_cols <- setNames(all_cols, phylum_order)

## =========================
## 8. 作图
## =========================
p <- ggplot(
  family_phylum_mean,
  aes(x = host_family, y = mean_rel_abundance, fill = phylum)
) +
