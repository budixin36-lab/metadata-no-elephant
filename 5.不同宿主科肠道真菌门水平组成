## =========================
cycle_cols <- c(
  "#E64B35",  # 红
  "#4DBBD5",  # 蓝青
  "#00A087",  # 绿
  "#F39B7F",  # 橙粉
  "#3C5488",  # 深蓝
  "#91D1C2",  # 浅青绿
  "#DCB000",  # 金黄
  "#7E6148",  # 棕
  "#B24745",  # 酒红
  "#7E57C2",  # 紫
  "#00BFC4",  # 青
  "#F8766D",  # 亮红粉
  "#619CFF",  # 蓝
  "#C77CFF",  # 紫粉
  "#A3A500",  # 橄榄
  "#00BA38",  # 鲜绿
  "#FF61C3",  # 粉
  "#B79F00"   # 黄褐
