#!/usr/bin/env Rscript

## ============================================================
## 图3-3 不同宿主科肠道真菌门水平组成
## no_elephant 版
##
## 说明：
## 1. 参考最终版 04d_plot_host_family_all_phylum_bar.R；
## 2. 使用 no_elephant 的 phylum_abundance_table.tsv；
## 3. 每个样本内重新计算门水平相对多度；
## 4. 再计算各宿主科平均相对多度；
## 5. 所有门全部保留，不合并 Others；
## 6. 非渐变高区分度颜色；
## 7. 输出 600 dpi 白底 PNG。
## ============================================================

suppressPackageStartupMessages({
  library(dplyr)
  library(tidyr)
  library(ggplot2)
  library(readr)
  library(stringr)
  library(grid)
})

## =========================
## 1. 路径设置
## =========================
project_dir <- "/mnt/d/ITS_SH_pipeline"

base_dir <- file.path(
  project_dir,
  "globalfungi_style_test_no_elephant"
)

metadata_file <- file.path(
  base_dir,
  "metadata/metadata_valid_globalfungi_SH_nozero_no_elephant.csv"
)

phylum_table_file <- file.path(
  base_dir,
  "taxonomy/phylum_abundance_table.tsv"
)

out_dir <- file.path(
  base_dir,
  "results/chapter3_family_composition_no_elephant"
)

dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)

if (!file.exists(metadata_file)) {
  stop("找不到 metadata 文件：", metadata_file)
}

if (!file.exists(phylum_table_file)) {
  stop("找不到 no_elephant 门水平丰度表：", phylum_table_file)
}

## =========================
## 2. 读取 metadata
## =========================
meta <- read.csv(
  metadata_file,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

sample_id_candidates <- c("#SampleID", "sample_id", "SampleID", "sampleid", "sample")
sample_id_col <- sample_id_candidates[sample_id_candidates %in% colnames(meta)][1]

if (is.na(sample_id_col)) {
  stop("metadata 中未找到样本ID列。请检查是否包含 #SampleID / sample_id / SampleID / sampleid 等列名。")
}

if (!"host_family" %in% colnames(meta)) {
  stop("metadata 中未找到 host_family 列。")
}

meta2 <- meta %>%
  dplyr::select(all_of(sample_id_col), host_family) %>%
  dplyr::rename(sample_id = all_of(sample_id_col)) %>%
  dplyr::mutate(
    sample_id = as.character(sample_id),
    host_family = trimws(as.character(host_family))
  ) %>%
  dplyr::filter(
    !is.na(sample_id),
    sample_id != "",
    !is.na(host_family),
    host_family != ""
  )

## no_elephant 版只保留 5 个宿主科
## 顺序按你的旧图和当前章节习惯：牛科、猪科、马科、鹿科、犀科
family_order <- c("Bovidae", "Suidae", "Equidae", "Cervidae", "Rhinocerotidae")

meta2 <- meta2 %>%
  dplyr::filter(host_family %in% family_order) %>%
  dplyr::mutate(host_family = factor(host_family, levels = family_order))

## =========================
## 3. 读取 phylum abundance table
##    默认格式：第一列为 phylum，后面每列为样本
## =========================
phylum_tab <- read.delim(
  phylum_table_file,
  sep = "\t",
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

if (ncol(phylum_tab) < 2) {
  stop("phylum_abundance_table.tsv 列数异常，至少应为 2 列。")
}

colnames(phylum_tab)[1] <- "phylum"

phylum_tab$phylum <- as.character(phylum_tab$phylum)
phylum_tab$phylum[is.na(phylum_tab$phylum) | phylum_tab$phylum == ""] <- "Unclassified"

## 转成长表
phylum_long <- phylum_tab %>%
  pivot_longer(
    cols = -phylum,
    names_to = "sample_id",
    values_to = "abundance"
  ) %>%
  mutate(
    abundance = suppressWarnings(as.numeric(abundance)),
    sample_id = as.character(sample_id),
    phylum = as.character(phylum)
  ) %>%
  filter(!is.na(abundance))

## 只保留共有样本
common_samples <- intersect(meta2$sample_id, unique(phylum_long$sample_id))

if (length(common_samples) == 0) {
  stop("metadata 与 phylum_abundance_table.tsv 之间没有匹配到共同样本ID。")
}

meta2 <- meta2 %>% filter(sample_id %in% common_samples)
phylum_long <- phylum_long %>% filter(sample_id %in% common_samples)

cat("Matched samples:", length(common_samples), "\n")
cat("Host family sample numbers:\n")
print(table(meta2$host_family))

## =========================
## 4. 每个样本内重新计算相对丰度 (%)
## =========================
phylum_rel <- phylum_long %>%
  group_by(sample_id) %>%
  mutate(total_abundance = sum(abundance, na.rm = TRUE)) %>%
  ungroup() %>%
  mutate(
    rel_abundance = ifelse(total_abundance > 0, abundance / total_abundance * 100, 0)
  )

## 合并宿主科信息
plot_df <- phylum_rel %>%
  left_join(meta2, by = "sample_id") %>%
  filter(!is.na(host_family))

## =========================
## 5. 计算宿主科平均相对丰度
## =========================
family_phylum_mean <- plot_df %>%
  group_by(host_family, phylum) %>%
  summarise(
    mean_rel_abundance = mean(rel_abundance, na.rm = TRUE),
    .groups = "drop"
  )

## 所有门都保留；按整体平均丰度从高到低排序
phylum_order <- family_phylum_mean %>%
  group_by(phylum) %>%
  summarise(overall_mean = mean(mean_rel_abundance, na.rm = TRUE), .groups = "drop") %>%
  arrange(desc(overall_mean)) %>%
  pull(phylum)

family_phylum_mean <- family_phylum_mean %>%
  complete(
    host_family = family_order,
    phylum = phylum_order,
    fill = list(mean_rel_abundance = 0)
  ) %>%
  mutate(
    host_family = factor(host_family, levels = family_order),
    phylum = factor(phylum, levels = phylum_order)
  )

## =========================
## 6. 检查每个宿主科合计是否为 100%
## =========================
family_total_check <- family_phylum_mean %>%
  group_by(host_family) %>%
  summarise(
    total_mean_rel_abundance = sum(mean_rel_abundance, na.rm = TRUE),
    .groups = "drop"
  )

write.csv(
  family_total_check,
  file.path(out_dir, "host_family_phylum_total_check_no_elephant.csv"),
  row.names = FALSE
)

cat("Family total check:\n")
print(family_total_check)

if (any(abs(family_total_check$total_mean_rel_abundance - 100) > 0.01)) {
  warning("有宿主科门水平平均相对多度合计明显不等于100%，请检查输出的 total_check 表。")
}

## 输出汇总表
write.csv(
  family_phylum_mean,
  file.path(out_dir, "host_family_all_phylum_mean_relative_abundance_no_elephant.csv"),
  row.names = FALSE
)

## =========================
## 7. 高区分度非渐变轮换配色
