## ---- 画图函数 ----
draw_upset_base <- function() {
  oldpar <- par(no.readonly = TRUE)
  on.exit(par(oldpar))

  layout(
    matrix(c(0, 1,
             2, 3), nrow = 2, byrow = TRUE),
    widths = c(1.70, 8.20),
    heights = c(3.10, 4.05)
  )

  ## ---------- 顶部交集柱状图 ----------
  par(mar = c(0.15, 4.8, 0.35, 1.0), family = base_family)
  ylim_top <- max(plot_df$SH_n) * 1.18

  plot(
    x = seq_len(n_comb),
    y = plot_df$SH_n,
    type = "n",
    xlim = c(0.5, n_comb + 0.5),
    ylim = c(0, ylim_top),
    xaxt = "n",
    xlab = "",
    ylab = "交集数目",
    cex.lab = 1.25,
    cex.axis = 1.0,
    bty = "l"
  )

  rect(
    xleft = seq_len(n_comb) - 0.32,
    ybottom = 0,
    xright = seq_len(n_comb) + 0.32,
    ytop = plot_df$SH_n,
    col = bar_cols,
    border = bar_cols
  )

  text(
    x = seq_len(n_comb),
    y = plot_df$SH_n + ylim_top * 0.018,
    labels = plot_df$SH_n,
    cex = 0.55,
    xpd = NA
  )

  ## ---------- 左下角集合大小柱状图 ----------
  par(mar = c(4.8, 0.6, 0.15, 0.10), family = base_family)
  y_pos <- seq_along(set_order_bottom_to_top)
  max_set <- max(set_sizes_display)

  plot(
    x = c(max_set * 1.12, -max_set * 0.04),
    y = c(0.5, length(set_order_bottom_to_top) + 0.5),
    type = "n",
    xaxt = "n",
    yaxt = "n",
    xlab = "",
    ylab = "",
    bty = "n"
  )

  rect(
    xleft = 0,
    ybottom = y_pos - 0.22,
    xright = set_sizes_display,
    ytop = y_pos + 0.22,
    col = col_other,
    border = col_other
  )

  ## 横轴：左侧为大值，右侧靠近 0，参照标准 UpSet 图
  axis(
    side = 1,
    at = pretty(c(0, max_set)),
    labels = pretty(c(0, max_set)),
    cex.axis = 0.9,
    las = 1
  )

  mtext("SH数目", side = 1, line = 3.0, cex = 1.15)

  ## 宿主科名放在左下柱状图右边，紧贴点线矩阵左侧
  ## 这里用 xpd 允许文字伸到右侧 panel 边界外
  text(
    x = -max_set * 0.025,
    y = y_pos,
    labels = set_order_bottom_to_top,
    adj = 1,
    xpd = NA,
    cex = 1.05
  )

  ## ---------- 点线矩阵 ----------
  par(mar = c(4.8, 0.05, 0.15, 0.8), family = base_family)

  plot(
    x = c(0.5, n_comb + 0.5),
    y = c(0.5, length(set_order_bottom_to_top) + 0.5),
    type = "n",
    xaxt = "n",
    yaxt = "n",
    xlab = "",
    ylab = "",
    bty = "n"
  )

  ## 背景交替浅灰带
  for (i in seq_along(set_order_bottom_to_top)) {
    if (i %% 2 == 1) {
      rect(
        xleft = 0.5,
        ybottom = i - 0.5,
        xright = n_comb + 0.5,
        ytop = i + 0.5,
        col = col_band,
        border = NA
      )
    }
  }

  ## 所有浅灰点
  for (j in seq_len(n_comb)) {
    points(
      rep(j, length(set_order_bottom_to_top)),
      y_pos,
      pch = 16,
      col = col_empty,
      cex = 0.75
    )
  }

  ## 连线和实心点
  for (j in seq_len(n_comb)) {
    active <- which(plot_mat_display[j, ] == 1)

    if (length(active) > 1) {
      segments(
        x0 = j,
        y0 = min(active),
        x1 = j,
        y1 = max(active),
        col = line_cols[j],
        lwd = 1.4
      )
    }

    points(
      rep(j, length(active)),
      active,
      pch = 16,
      col = line_cols[j],
      cex = 0.85
    )
  }
}

