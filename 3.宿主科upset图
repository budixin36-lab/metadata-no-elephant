#也就是说，第一行不是正式表头，第二行 #OTU ID 才是真正的表头。
#我上一版脚本没有跳过第一行，所以 R 误读，导致“列数比列名多”。
#这个问题不用重做 BIOM，也不用重新生成 abundance table，只要把 UpSet 脚本里的读表方式改稳就行。
#3. 直接用代码修改脚本，不用你手动粘贴缩进
#在 WSL 终端运行下面整段。它只会修改 plot_host_family_upset_no_elephant.R 中读取 SH 表的部分，不会动你的数据文件。
python3 - <<'PY'
from pathlib import Path

script = Path("/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/scripts/plot_host_family_upset_no_elephant.R")
txt = script.read_text(encoding="utf-8")

start_marker = "## ---- 读取 biom convert 导出的 SH abundance table ----"
end_marker = "common_samples <- intersect(colnames(sh_mat), meta_use$sampleid)"

start = txt.index(start_marker)
end = txt.index(end_marker)

new_block = r'''## ---- 读取 biom convert 导出的 SH abundance table ----
## biom convert --to-tsv 导出的文件第一行通常是说明行：
## # Constructed from biom file
## 第二行 #OTU ID 才是真正表头，所以这里做稳健读取。

sh_lines <- readLines(sh_table_file, warn = FALSE)

## 去掉空行
sh_lines <- sh_lines[nchar(trimws(sh_lines)) > 0]

## 如果第一行是 biom 说明行，则跳过
if (grepl("^# Constructed from biom file", sh_lines[1])) {
  sh_lines <- sh_lines[-1]
}

## 现在第一行应为 #OTU ID 开头的表头
if (!grepl("^#OTU ID\t|^#OTU ID$", sh_lines[1])) {
  stop("SH abundance table 表头异常。请检查文件前几行：\n",
       paste(head(sh_lines, 5), collapse = "\n"))
}

sh_raw <- read.delim(
  text = paste(sh_lines, collapse = "\n"),
  header = TRUE,
  sep = "\t",
  check.names = FALSE,
  stringsAsFactors = FALSE,
  quote = "",
  comment.char = ""
)

## 第一列通常是 #OTU ID，改名为 SH_ID
colnames(sh_raw)[1] <- "SH_ID"

## 去掉可能存在的 taxonomy/metadata 列，只保留样本列
taxonomy_cols <- grep("taxonomy|metadata", colnames(sh_raw), ignore.case = TRUE, value = TRUE)
if (length(taxonomy_cols) > 0) {
  sh_raw <- sh_raw[, !colnames(sh_raw) %in% taxonomy_cols, drop = FALSE]
}

rownames(sh_raw) <- sh_raw$SH_ID
sh_mat <- as.matrix(sh_raw[, -1, drop = FALSE])
mode(sh_mat) <- "numeric"

'''

txt2 = txt[:start] + new_block + txt[end:]
script.write_text(txt2, encoding="utf-8")

print("已修改脚本中的 SH abundance table 读取部分：")
print(script)
PY
