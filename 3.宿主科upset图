#基于 no_elephant 数据
#做 宿主科间共有/独有 SH 的 UpSet 图
#左下角轴名：SH数目
#左上方纵轴名：交集数目
#不显示图例
#仅将 5 科共有 SH 标记为红色
#其余所有交集柱统一为深灰色
#交集顺序按：5科共有 → 4科共有 → 3科共有 → 2科共有 → 1科特有
#输出 高清 PNG + PDF
#同时输出 summary 文件，方便你后面改正文
#输入文件
#/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/metadata/metadata_valid_globalfungi_SH_nozero_no_elephant.csv
#/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/taxonomy/merged_SH_globalfungi_style_nozero_no_elephant_with_taxonomy.biom
#输出目录
#/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/results/host_family_upset
#直接覆盖脚本
#你在 WSL 终端 里整段复制运行：
cat > /mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/scripts/plot_host_family_upset_no_elephant.R <<'EOF'
## =========================
## 图3-1 宿主科间共有/独有 SH 的 UpSet 图（no_elephant版）
## 仅5科共有标红；其余为深灰色；无图例
## =========================

RVER <- paste0(R.version$major, ".", strsplit(R.version$minor, "\\.")[[1]][1])
user_lib <- file.path(Sys.getenv("HOME"), "Rlibs", paste0("R-", RVER))

.libPaths(c(
  user_lib,
  "/mnt/d/Rlibs",
  "/usr/local/lib/R/site-library",
  "/usr/lib/R/site-library",
  "/usr/lib/R/library"
))

suppressPackageStartupMessages({
  library(dplyr)
  library(biomformat)
  library(ComplexHeatmap)
  library(grid)
})

## ---- 输入输出路径 ----
meta_file <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/metadata/metadata_valid_globalfungi_SH_nozero_no_elephant.csv"
biom_file <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/taxonomy/merged_SH_globalfungi_style_nozero_no_elephant_with_taxonomy.biom"
out_dir   <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/results/host_family_upset"

dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)

## ---- 宿主科顺序 ----
## 统计顺序（用于summary）
family_order <- c("Bovidae", "Equidae", "Cervidae", "Suidae", "Rhinocerotidae")

## 图中左侧从上到下顺序
set_order_plot <- c("Rhinocerotidae", "Suidae", "Cervidae", "Equidae", "Bovidae")

## ---- 颜色 ----
col_5_shared <- "#D73027"   # 5科共有：红色
col_other    <- "#4D4D4D"   # 其余：深灰色

## ---- 读取 metadata ----
meta <- read.csv(meta_file, stringsAsFactors = FALSE, check.names = FALSE)

need_cols <- c("sampleid", "host_family")
missing_cols <- setdiff(need_cols, colnames(meta))
if (length(missing_cols) > 0) {
  stop("metadata缺少必要列：", paste(missing_cols, collapse = ", "))
}

meta_use <- meta %>%
  filter(host_family %in% family_order)

## ---- 读取 BIOM ----
biom_obj <- read_biom(biom_file)
sh_mat <- as.matrix(biom_data(biom_obj))

## 补行列名并判断方向
obs_ids  <- observation_names(biom_obj)
samp_ids <- sample_names(biom_obj)

if (nrow(sh_mat) == length(obs_ids) && ncol(sh_mat) == length(samp_ids)) {
  rownames(sh_mat) <- obs_ids
  colnames(sh_mat) <- samp_ids
} else if (ncol(sh_mat) == length(obs_ids) && nrow(sh_mat) == length(samp_ids)) {
  sh_mat <- t(sh_mat)
  rownames(sh_mat) <- obs_ids
  colnames(sh_mat) <- samp_ids
} else {
  stop("无法确定 BIOM 矩阵方向，请检查 biom 文件。")
}

## ---- 对齐样本 ----
common_samples <- intersect(colnames(sh_mat), meta_use$sampleid)
if (length(common_samples) == 0) {
  stop("metadata 与 BIOM 没有共同样本。")
}

meta_use <- meta_use %>%
  filter(sampleid %in% common_samples)

sh_mat <- sh_mat[, common_samples, drop = FALSE]

## ---- 计算每个宿主科检出的 SH 集合 ----
family_list <- lapply(family_order, function(fam) {
  fam_samples <- meta_use$sampleid[meta_use$host_family == fam]

  if (length(fam_samples) == 0) {
    character(0)
  } else if (length(fam_samples) == 1) {
    rownames(sh_mat)[sh_mat[, fam_samples] > 0]
  } else {
    rownames(sh_mat)[rowSums(sh_mat[, fam_samples, drop = FALSE] > 0) > 0]
  }
})
names(family_list) <- family_order

## ---- 构建 presence/absence 表 ----
all_sh <- sort(unique(unlist(family_list)))

pa <- sapply(family_list, function(x) as.integer(all_sh %in% x))
pa <- as.matrix(pa)
rownames(pa) <- all_sh
colnames(pa) <- family_order

## ---- 统计 summary，用于正文 ----
family_sample_counts <- meta_use %>%
  count(host_family, name = "sample_n") %>%
  mutate(host_family = factor(host_family, levels = family_order)) %>%
  arrange(host_family)

family_sh_counts <- data.frame(
  host_family = family_order,
  SH_n = colSums(pa),
  stringsAsFactors = FALSE
)

family_unique_counts <- data.frame(
  host_family = family_order,
  unique_SH_n = sapply(family_order, function(fam) {
    sum(pa[, fam] == 1 & rowSums(pa) == 1)
  }),
  stringsAsFactors = FALSE
)

## 所有 5 科共有 SH 数目
all_5_shared <- sum(rowSums(pa) == 5)

## 交集模式统计
pa_df <- as.data.frame(pa)
pa_df$pattern <- apply(pa_df[, family_order, drop = FALSE], 1, paste0, collapse = "")

intersection_summary <- pa_df %>%
  count(pattern, name = "SH_n") %>%
  filter(SH_n > 0)

pattern_mat <- do.call(rbind, strsplit(intersection_summary$pattern, split = ""))
pattern_mat <- matrix(pattern_mat, ncol = length(family_order), byrow = FALSE)
colnames(pattern_mat) <- family_order

intersection_summary$degree <- rowSums(pattern_mat == "1")

intersection_summary$families <- apply(pattern_mat, 1, function(x) {
  fams <- family_order[x == "1"]
  paste(fams, collapse = " & ")
})

intersection_summary$share_type <- ifelse(
  intersection_summary$degree == 1,
  "1科特有",
  paste0(intersection_summary$degree, "科共有")
)

## 交集排序：5科共有 -> 4科共有 -> 3科共有 -> 2科共有 -> 1科特有
intersection_summary <- intersection_summary %>%
  arrange(desc(degree), desc(SH_n))

write.csv(
  intersection_summary,
  file.path(out_dir, "host_family_SH_intersection_summary_no_elephant.csv"),
  row.names = FALSE
)

degree_summary <- intersection_summary %>%
  group_by(degree, share_type) %>%
  summarise(SH_n_total = sum(SH_n), .groups = "drop") %>%
  arrange(desc(degree))

write.csv(
  degree_summary,
  file.path(out_dir, "host_family_SH_degree_summary_no_elephant.csv"),
  row.names = FALSE
)

## summary 文本
summary_lines <- c(
  paste0("total_samples\t", nrow(meta_use)),
  paste0("total_SH\t", nrow(pa)),
  "",
  "family_sample_counts:"
)

for (i in seq_len(nrow(family_sample_counts))) {
  summary_lines <- c(
    summary_lines,
    paste0(
      family_sample_counts$host_family[i], "\t",
      family_sample_counts$sample_n[i]
    )
  )
}

summary_lines <- c(summary_lines, "", "family_SH_counts:")
for (i in seq_len(nrow(family_sh_counts))) {
  summary_lines <- c(
    summary_lines,
    paste0(
      family_sh_counts$host_family[i], "\t",
      family_sh_counts$SH_n[i]
    )
  )
}

summary_lines <- c(summary_lines, "", "family_unique_SH_counts:")
for (i in seq_len(nrow(family_unique_counts))) {
  summary_lines <- c(
    summary_lines,
    paste0(
      family_unique_counts$host_family[i], "\t",
      family_unique_counts$unique_SH_n[i]
    )
  )
}

summary_lines <- c(
  summary_lines,
  "",
  paste0("all_5_families_shared_SH\t", all_5_shared),
  "",
  "degree_summary:"
)

for (i in seq_len(nrow(degree_summary))) {
  summary_lines <- c(
    summary_lines,
    paste0(
      degree_summary$share_type[i], "\t",
      degree_summary$SH_n_total[i]
    )
  )
}

writeLines(
  summary_lines,
  file.path(out_dir, "host_family_SH_summary_no_elephant.txt")
)

## ---- 绘制 UpSet 图 ----
m <- make_comb_mat(family_list, mode = "distinct")

comb_degree_vec <- comb_degree(m)
comb_size_vec   <- comb_size(m)

## 排序：先按 degree（5->1），再按交集大小降序
comb_order <- order(-comb_degree_vec, -comb_size_vec)

## 仅 5 科共有标红，其余深灰
comb_col <- ifelse(comb_degree_vec == 5, col_5_shared, col_other)

top_anno <- upset_top_annotation(
  m,
  gp = gpar(fill = comb_col, col = comb_col),
  add_numbers = TRUE,
  numbers_gp = gpar(fontsize = 7),
  height = unit(8.2, "cm"),
  annotation_name = "交集数目",
  annotation_name_gp = gpar(fontsize = 12, fontface = "plain")
)

left_anno <- upset_left_annotation(
  m,
  gp = gpar(fill = col_other),
  width = unit(5.3, "cm"),
  annotation_name = "SH数目",
  annotation_name_gp = gpar(fontsize = 12, fontface = "plain")
)

ht <- UpSet(
  m,
  comb_order = comb_order,
  set_order = set_order_plot,
  comb_col = comb_col,
  top_annotation = top_anno,
  left_annotation = left_anno,
  pt_size = unit(3, "mm"),
  lwd = 1.5
)

## ---- 输出高清 PNG ----
png(
  filename = file.path(out_dir, "host_family_upset_no_elephant.png"),
  width = 16,
  height = 9,
  units = "in",
  res = 600,
  type = "cairo",
  bg = "white"
)
draw(
  ht,
  heatmap_legend_side = "right",
  annotation_legend_side = "right"
)
dev.off()

## ---- 输出 PDF ----
cairo_pdf(
  filename = file.path(out_dir, "host_family_upset_no_elephant.pdf"),
  width = 16,
  height = 9,
  bg = "white"
)
draw(
  ht,
  heatmap_legend_side = "right",
  annotation_legend_side = "right"
)
dev.off()

cat("Done!\n")
cat("PNG saved to: ", file.path(out_dir, "host_family_upset_no_elephant.png"), "\n", sep = "")
cat("PDF saved to: ", file.path(out_dir, "host_family_upset_no_elephant.pdf"), "\n", sep = "")
cat("Summary saved to: ", file.path(out_dir, "host_family_SH_summary_no_elephant.txt"), "\n", sep = "")
cat("Intersection summary saved to: ", file.path(out_dir, "host_family_SH_intersection_summary_no_elephant.csv"), "\n", sep = "")
EOF
