clean_text <- function(x) {
  x %>%
    as.character() %>%
    stringr::str_trim() %>%
    stringr::str_replace_all("\\s+", " ")
}

clean_genus_name <- function(x) {
  x %>%
    clean_text() %>%
    stringr::str_replace_all("×", "x")
}

extract_genus_from_taxon <- function(x) {
  ## 从物种名、属级记录或带 sp./aff. 的记录中提取第一个拉丁属名
  ## 示例：
  ## "Agaricus sp. GAL12215" -> "Agaricus"
  ## "Albatrellus caeruleoporus" -> "Albatrellus"
  ## "Amphinema aff. byssoides UC2022834" -> "Amphinema"
  ## "Agaricus sp.;Agaricus sp." 会先拆分，再分别提取
  x %>%
    clean_text() %>%
    stringr::str_extract("^[A-Z][A-Za-z-]+")
}

filter_valid_genus <- function(df, genus_col = "Genus") {
  df %>%
    mutate(
      Genus = clean_genus_name(.data[[genus_col]])
    ) %>%
    filter(
      !is.na(Genus),
      Genus != "",
      !Genus %in% c(
        "Total",
        "Other",
        "Others",
        "Unclassified",
        "Unidentified",
        "Unknown",
        "uncultured",
        "Uncultured",
        "Fungi",
        "Fungal",
        "NA",
        "N/A"
      ),
      stringr::str_detect(Genus, "^[A-Z][A-Za-z-]+$")
    )
}

write_csv_utf8 <- function(x, path) {
