    source_Lee_boar = any(source_Lee_boar),
    .groups = "drop"
  ) %>%
  mutate(
    source_count =
      as.integer(source_MSTEM) +
      as.integer(source_Cadotte_deer) +
      as.integer(source_Lee_boar),
    source_detail = purrr::pmap_chr(
      list(source_MSTEM, source_Cadotte_deer, source_Lee_boar),
      function(mstem, cadotte, lee) {
        src <- c()
        if (mstem) src <- c(src, "MSTEM")
        if (cadotte) src <- c(src, "Cadotte_deer")
        if (lee) src <- c(src, "Lee_boar")
        paste(src, collapse = "; ")
      }
    )
  ) %>%
  arrange(Genus)

