  mst_clean %>%
    transmute(
      Genus,
      source_MSTEM = TRUE,
      source_Cadotte_deer = FALSE,
      source_Lee_boar = FALSE
    ),
  cadotte_clean %>%
    transmute(
      Genus,
      source_MSTEM = FALSE,
      source_Cadotte_deer = TRUE,
      source_Lee_boar = FALSE
    ),
  lee_clean %>%
    transmute(
      Genus,
      source_MSTEM = FALSE,
      source_Cadotte_deer = FALSE,
      source_Lee_boar = TRUE
    )
)

macrofungi_union <- all_genera %>%
  group_by(Genus) %>%
  summarise(
    source_MSTEM = any(source_MSTEM),
    source_Cadotte_deer = any(source_Cadotte_deer),
    source_Lee_boar = any(source_Lee_boar),
    .groups = "drop"
  ) %>%
  mutate(
    source_count =
      as.integer(source_MSTEM) +
      as.integer(source_Cadotte_deer) +
      as.integer(source_Lee_boar),
    source_detail = purrr::pmap_chr(
      list(source_MSTEM, source_Cadotte_deer, source_Lee_boar),
      function(mstem, cadotte, lee) {
        src <- c()
        if (mstem) src <- c(src, "MSTEM")
        if (cadotte) src <- c(src, "Cadotte_deer")
        if (lee) src <- c(src, "Lee_boar")
        paste(src, collapse = "; ")
      }
    )
  ) %>%
  arrange(Genus)

write_csv_utf8(
