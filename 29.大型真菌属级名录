clean_text <- function(x) {
  x %>%
    as.character() %>%
    stringr::str_trim() %>%
    stringr::str_replace_all("\\s+", " ")
}

clean_genus_name <- function(x) {
  x %>%
    clean_text() %>%
    stringr::str_replace_all("×", "x")
}

extract_genus_from_taxon <- function(x) {
  ## 从物种名、属级记录或带 sp./aff. 的记录中提取第一个拉丁属名
  ## 示例：
  ## "Agaricus sp. GAL12215" -> "Agaricus"
  ## "Albatrellus caeruleoporus" -> "Albatrellus"
  ## "Acarospora sp." -> "Acarospora"
  x %>%
    clean_text() %>%
    stringr::str_extract("^[A-Z][A-Za-z-]+")
}

filter_valid_genus <- function(df, genus_col = "Genus") {
  df %>%
    mutate(
      Genus = clean_genus_name(.data[[genus_col]])
    ) %>%
    filter(
      !is.na(Genus),
      Genus != "",
      !Genus %in% c(
        "Total",
        "Other",
        "Others",
        "Unclassified",
        "Unidentified",
        "Unknown",
        "uncultured",
        "Uncultured",
        "Fungi",
        "Fungal",
        "NA",
        "N/A"
      ),
      stringr::str_detect(Genus, "^[A-Z][A-Za-z-]+$")
    )
}

is_non_genus_name <- function(x) {
  ## 用于 Cadotte S1/S2：剔除明显不是属级名称的记录
  ## 例如目级 -ales，科级 -aceae，亚门级 -mycotina，以及描述性词
  x_clean <- clean_genus_name(x)

  stringr::str_detect(x_clean, "ales$") |
    stringr::str_detect(x_clean, "aceae$") |
    stringr::str_detect(x_clean, "mycotina$") |
    x_clean %in% c(
      "Mycorrhizal",
      "Thelephoroid",
      "Fungal",
      "Fungi",
      "Unidentified",
      "Unclassified",
      "Unknown"
    )
}

write_csv_utf8 <- function(x, path) {
  readr::write_csv(x, path)
  cat("Saved: ", path, "\n", sep = "")
}

