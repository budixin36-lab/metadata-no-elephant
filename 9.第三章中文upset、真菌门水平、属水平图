clean_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c(
    "", "NA", "N/A", "na", "n/a",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded",
    "not_reported", "not reported",
    "not applicable", "Not applicable",
    "unknown", "Unknown", "UNKNOWN"
  )] <- NA
  x
}

pick_col <- function(candidates, cols, label) {
  hit <- candidates[candidates %in% cols][1]
  if (is.na(hit)) {
    stop(
      "Cannot find column for ", label,
      ". Tried: ", paste(candidates, collapse = ", "),
      "\nExisting columns:\n", paste(cols, collapse = ", ")
    )
  }
  hit
}

clean_genus <- function(x) {
  x <- trimws(as.character(x))
  x <- sub("^.*g__", "g__", x)
  x <- sub("^g__", "", x)
  x <- sub("^Genus__", "", x)
  x[x == "" | is.na(x)] <- "Unassigned"
  x[x %in% c("NA", "N/A", "na", "n/a", "unknown", "Unknown")] <- "Unassigned"
  x
}

fmt_tick <- function(x) {
  ifelse(abs(x - round(x)) < 1e-6, as.character(round(x)), sprintf("%.1f", x))
}

## 大于20：每20标一次，另加最大值；
## 15-20：0、10、最大值；
## 小于15：0、最大值。
nice_axis_at <- function(sector, xmax, drop_sectors) {
  if (is.na(xmax) || xmax <= 0) return(NULL)

  if (xmax > 20) {
    at <- seq(0, floor(xmax / 20) * 20, by = 20)
    if (length(at) == 0) at <- 0
    if (abs(max(at) - xmax) > 1e-6) {
      at <- c(at, xmax)
    }
  } else if (xmax >= 15) {
    at <- c(0, 10, xmax)
  } else {
    at <- c(0, xmax)
  }

  at <- at[at >= 0 & at <= xmax]
  at <- unique(round(at, 6))

  ## 对容易重叠的扇区删除倒数第二个刻度标签
  if (sector %in% drop_sectors && length(at) >= 3) {
    at <- at[-(length(at) - 1)]
  }

  at
}

nice_axis_lab <- function(at) {
  if (is.null(at) || length(at) == 0) return(character(0))
  fmt_tick(at)
}

read_sh_table <- function(sh_table_file) {
  sh_lines <- readLines(sh_table_file, warn = FALSE)
  sh_lines <- sh_lines[nchar(trimws(sh_lines)) > 0]

  if (length(sh_lines) == 0) {
    stop("SH abundance table 为空。")
  }

  ## biom convert --to-tsv 第一行通常是说明行，第二行才是 #OTU ID 表头
  if (grepl("^# Constructed from biom file", sh_lines[1])) {
    sh_lines <- sh_lines[-1]
  }

  if (!grepl("^#OTU ID\t|^#OTU ID$", sh_lines[1])) {
    stop(
      "SH abundance table 表头异常。文件前几行是：\n",
      paste(head(sh_lines, 5), collapse = "\n")
    )
  }

  sh_raw <- read.delim(
    text = paste(sh_lines, collapse = "\n"),
    header = TRUE,
    sep = "\t",
    check.names = FALSE,
    stringsAsFactors = FALSE,
    quote = "",
    comment.char = ""
  )

  colnames(sh_raw)[1] <- "SH_ID"

  taxonomy_cols <- grep("taxonomy|metadata", colnames(sh_raw), ignore.case = TRUE, value = TRUE)
  if (length(taxonomy_cols) > 0) {
    sh_raw <- sh_raw[, !colnames(sh_raw) %in% taxonomy_cols, drop = FALSE]
  }

  rownames(sh_raw) <- sh_raw$SH_ID
  mat <- as.matrix(sh_raw[, -1, drop = FALSE])
  mode(mat) <- "numeric"
  mat[is.na(mat)] <- 0

  mat
}

