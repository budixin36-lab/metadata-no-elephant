# =========================
# 4. 工具函数
# =========================
clean_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c(
    "", "NA", "N/A", "na", "n/a",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded",
    "not_reported", "not reported",
    "not applicable", "Not applicable",
    "unknown", "Unknown", "UNKNOWN"
  )] <- NA
  x
}

pick_col <- function(candidates, cols, label) {
  hit <- candidates[candidates %in% cols][1]
  if (is.na(hit)) {
    stop(
      "找不到列：", label,
      "\n尝试列名：", paste(candidates, collapse = ", "),
      "\n现有列名：", paste(cols, collapse = " | ")
    )
  }
  hit
}

read_sh_table <- function(sh_table_file) {
  sh_lines <- readLines(sh_table_file, warn = FALSE)
  sh_lines <- sh_lines[nchar(trimws(sh_lines)) > 0]

  if (length(sh_lines) == 0) {
    stop("SH abundance table 为空。")
  }

  # biom 转出的 TSV 第一行通常是说明文字
  if (grepl("^# Constructed from biom file", sh_lines[1])) {
    sh_lines <- sh_lines[-1]
  }

  sh_raw <- read.delim(
    text = paste(sh_lines, collapse = "\n"),
    header = TRUE,
    sep = "\t",
    check.names = FALSE,
    stringsAsFactors = FALSE,
    quote = "",
    comment.char = ""
  )

  colnames(sh_raw)[1] <- "SH_ID"

  taxonomy_cols <- grep(
    "taxonomy|metadata",
    colnames(sh_raw),
    ignore.case = TRUE,
    value = TRUE
  )

  if (length(taxonomy_cols) > 0) {
    sh_raw <- sh_raw[, !colnames(sh_raw) %in% taxonomy_cols, drop = FALSE]
  }

  rownames(sh_raw) <- sh_raw$SH_ID

  mat <- as.matrix(sh_raw[, -1, drop = FALSE])
  storage.mode(mat) <- "numeric"
  mat[is.na(mat)] <- 0

  mat
}

get_iqr_range <- function(x, k = 7) {
  q1 <- unname(quantile(x, 0.25, na.rm = TRUE))
  q3 <- unname(quantile(x, 0.75, na.rm = TRUE))
  iqr <- q3 - q1
  c(lower = q1 - k * iqr, upper = q3 + k * iqr)
}

fmt_decimal <- function(x) {
  x[abs(x) < 1e-12] <- 0
  sprintf("%.5f", x)
}

format_p <- function(p) {
  if (is.na(p)) {
    return("NA")
  }
  if (p < 0.001) {
    return("<0.001")
  }
  sprintf("%.3f", p)
}

