get_iqr_range <- function(x, k = 7) {
  q1 <- unname(quantile(x, 0.25, na.rm = TRUE))
  q3 <- unname(quantile(x, 0.75, na.rm = TRUE))
  iqr <- q3 - q1

  c(
    lower = q1 - k * iqr,
    upper = q3 + k * iqr
  )
}

get_padded_range <- function(x, padding = 0.05) {
  r <- range(x, na.rm = TRUE)
  d <- diff(r)

  if (is.na(d) || d == 0) {
    d <- max(abs(r), 1e-6)
  }

  c(
    lower = r[1] - padding * d,
    upper = r[2] + padding * d
  )
}

# ------------------------------------------------------------
# 坐标轴刻度格式函数
#
# 逻辑：
# 1. 对当前轴全部刻度值先按 max_digits 位小数转为字符；
# 2. 去掉每个刻度末尾多余的 0；
# 3. 判断这一组刻度中最多需要保留几位小数；
# 4. 所有刻度统一保留这个位数。
#
# 例如：
#   0.00000, 0.00050, 0.00100
# 先变为：
#   0, 0.0005, 0.001
# 最多小数位数为 4；
# 最终显示：
#   0.0000, 0.0005, 0.0010
# ------------------------------------------------------------
fmt_decimal_align <- function(x, max_digits = 8) {
  out <- rep(NA_character_, length(x))

  ok <- !is.na(x)

  if (!any(ok)) {
    return(out)
  }

  x2 <- x[ok]
  x2[abs(x2) < 1e-12] <- 0

  raw <- sprintf(paste0("%.", max_digits, "f"), x2)

  trimmed <- sub("0+$", "", raw)
  trimmed <- sub("\\.$", "", trimmed)

  decimal_digits <- ifelse(
    grepl("\\.", trimmed),
    nchar(sub("^.*\\.", "", trimmed)),
    0
  )

  keep_digits <- max(decimal_digits, na.rm = TRUE)

  out[ok] <- sprintf(paste0("%.", keep_digits, "f"), x2)

  out
}

format_p <- function(p) {
  if (length(p) == 0 || is.na(p)) {
    return("NA")
  }

  if (p < 0.001) {
    return("<0.001")
  }

  sprintf("%.3f", p)
}

