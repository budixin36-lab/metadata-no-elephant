draw_species_nmds_ordibar <- function(out_file, device = c("png", "pdf")) {
  device <- match.arg(device)

  if (device == "png") {
    png(
      filename = out_file,
      width = 3400,
      height = 2500,
      res = 600,
      bg = "white"
    )
  } else {
    cairo_pdf(
      filename = out_file,
      width = 11.5,
      height = 8.2,
      bg = "white"
    )
  }

  par(
    mar = c(5.6, 5.2, 2.0, ifelse(show_species_legend, 13.5, 8.0)),
    xpd = NA,
    family = "CNFont"
  )

  # 先画空白 NMDS 坐标系
  plot(
    nmds,
    type = "n",
    display = "sites",
    xlim = x_range,
    ylim = y_range,
    xlab = "NMDS1",
    ylab = "NMDS2",
    cex.lab = 1.6,
    cex.axis = 1.1
  )

  # ordibar：按宿主物种画 SD 十字条
  # 颜色按宿主科
  ordibar(
    nmds,
    groups = plot_df$host_species_cn,
    display = "sites",
    kind = "sd",
    conf = NULL,
    label = FALSE,
    col = unname(centroid_df$color[match(levels(plot_df$host_species_cn), centroid_df$host_species_cn)]),
    lwd = bar_lwd
  )

  # 叠加质心点 + 中文标签
  for (i in seq_len(nrow(centroid_df))) {
    xi <- centroid_df$NMDS1_mean[i]
    yi <- centroid_df$NMDS2_mean[i]
    sp_key <- as.character(centroid_df$host_species_key[i])
    sp_cn  <- as.character(centroid_df$host_species_cn[i])
    fam_cn <- as.character(centroid_df$host_family_cn[i])

    pch_i <- unname(species_shape_map[sp_key])
    col_i <- unname(family_colors_cn[fam_cn])

    # 对于可填充点形状 21-25，用 bg 填色
    if (pch_i %in% 21:25) {
      points(
        xi, yi,
        pch = pch_i,
        col = col_i,
        bg = col_i,
        cex = point_cex,
        lwd = 1.0
      )
    } else {
      points(
        xi, yi,
        pch = pch_i,
        col = col_i,
        cex = point_cex,
        lwd = 1.1
      )
    }

    text(
      x = xi + label_offset_x,
      y = yi + label_offset_y,
      labels = sp_cn,
      col = col_i,
      cex = label_cex,
      pos = 4
    )
  }

  # 左上角 Adonis 标注
  x_anno <- x_range["lower"] + 0.03 * diff(x_range)
  y_anno <- y_range["upper"] - 0.05 * diff(y_range)
  text(
    x = x_anno,
    y = y_anno,
    labels = adonis_label,
    adj = c(0, 1),
    cex = 1.05
  )

  # 底部 stress
  mtext(
    side = 1,
    line = 3.9,
    adj = 0,
    text = paste0("Bray-Curtis NMDS stress = ", sprintf("%.8f", nmds$stress)),
    cex = 1.0
  )

  # 宿主科颜色图例
  legend(
    "right",
    inset = c(-0.12, 0),
    legend = family_order_cn,
    col = unname(family_colors_cn[family_order_cn]),
    pt.bg = unname(family_colors_cn[family_order_cn]),
    pch = 16,
    pt.cex = 1.4,
    bty = "n",
    cex = family_legend_cex,
    y.intersp = 1.15,
    title = NULL
  )

  # 可选：宿主物种图例（默认关闭，避免太挤）
  if (show_species_legend) {
    legend(
      "topright",
      inset = c(-0.42, 0),
      legend = unname(species_cn_map[species_order_key]),
      pch = unname(species_shape_map[species_order_key]),
      col = unname(family_colors_cn[species_family_map[species_order_key]]),
      pt.bg = unname(family_colors_cn[species_family_map[species_order_key]]),
      bty = "n",
      cex = species_legend_cex,
      ncol = 2,
      title = NULL
    )
  }

  dev.off()
}

