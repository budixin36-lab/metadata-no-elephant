# =========================
# 10. betadisper
# =========================
cat("\n开始计算 betadisper ...\n")

bd <- betadisper(bray, group = meta2$host_family)

bd_anova <- as.data.frame(anova(bd)) %>%
  rownames_to_column("term")

bd_perm <- permutest(bd, permutations = 999)

bd_perm_df <- as.data.frame(bd_perm$tab) %>%
  rownames_to_column("term")

