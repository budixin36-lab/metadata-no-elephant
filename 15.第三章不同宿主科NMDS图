clean_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c(
    "", "NA", "N/A", "na", "n/a",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded",
    "not_reported", "not reported",
    "not applicable", "Not applicable",
    "unknown", "Unknown", "UNKNOWN"
  )] <- NA
  x
}

pick_col <- function(candidates, cols, label) {
  hit <- candidates[candidates %in% cols][1]
  if (is.na(hit)) {
    stop(
      "找不到列：", label,
      "\n尝试列名：", paste(candidates, collapse = ", "),
      "\n现有列名：", paste(cols, collapse = " | ")
    )
  }
  hit
}

normalize_species_key <- function(x) {
  x <- clean_value(x)
  x <- gsub("×", "x", x)
  x <- gsub("\\s*[xX]\\s*", " x ", x)
  x <- gsub("\\s+", " ", x)
  x <- trimws(x)

  # 转成脚本统一使用的 key
  x <- gsub(" ", "_", x)
  x
}

format_p <- function(p) {
  if (length(p) == 0 || is.na(p)) return("NA")
  if (p < 0.001) return("<0.001")
  sprintf("%.3f", p)
}

extract_adonis_main_row <- function(adonis_df) {
  idx <- which(adonis_df$term == "host_species")
  if (length(idx) == 0) {
    idx <- which(!adonis_df$term %in% c("Residual", "Residuals", "Total"))
  }
  if (length(idx) == 0) {
    stop("无法从 adonis2 结果中识别模型项。")
  }
  idx[1]
}

get_padded_range <- function(lower_vec, upper_vec, padding = 0.08) {
  r <- c(min(lower_vec, na.rm = TRUE), max(upper_vec, na.rm = TRUE))
  d <- diff(r)
  if (is.na(d) || d == 0) d <- max(abs(r), 1e-6)
  c(
    lower = r[1] - padding * d,
    upper = r[2] + padding * d
  )
}

