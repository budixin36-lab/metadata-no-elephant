}

# 过滤总丰度为 0 的样本
sample_totals <- colSums(sh_mat, na.rm = TRUE)
valid_samples <- names(sample_totals)[sample_totals > 0]

sh_mat <- sh_mat[, valid_samples, drop = FALSE]
meta2 <- meta2[match(colnames(sh_mat), meta2$sample_id), ]

cat("最终匹配样本数：", ncol(sh_mat), "\n", sep = "")
cat("最终 SH 数：", nrow(sh_mat), "\n", sep = "")
cat("最终宿主科数：", length(unique(meta2$host_family)), "\n", sep = "")
cat("最终宿主科样本数：\n")
print(table(meta2$host_family))

# =========================
# 7. 样本内相对多度 + Bray-Curtis 距离
# =========================
comm <- t(sh_mat)  # sample x SH

comm_rel <- sweep(
  comm,
  1,
  rowSums(comm, na.rm = TRUE),
  FUN = "/"
)

comm_rel[is.na(comm_rel)] <- 0

bray <- vegdist(comm_rel, method = "bray")

saveRDS(bray, bray_rds)

# =========================
# 8. NMDS
# =========================
cat("\n开始计算 NMDS ...\n")

nmds <- metaMDS(
  bray,
  k = 2,
  trymax = 200,
  autotransform = FALSE,
  trace = 1
)

nmds_scores <- as.data.frame(scores(nmds, display = "sites"))
colnames(nmds_scores) <- c("NMDS1", "NMDS2")
nmds_scores$sample_id <- rownames(nmds_scores)

nmds_scores <- nmds_scores %>%
