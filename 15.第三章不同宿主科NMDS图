clean_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c(
    "", "NA", "N/A", "na", "n/a",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded",
    "not_reported", "not reported",
    "not applicable", "Not applicable",
    "unknown", "Unknown", "UNKNOWN"
  )] <- NA
  x
}

pick_col <- function(candidates, cols, label) {
  hit <- candidates[candidates %in% cols][1]
  if (is.na(hit)) {
    stop(
      "找不到列：", label,
      "\n尝试列名：", paste(candidates, collapse = ", "),
      "\n现有列名：", paste(cols, collapse = " | ")
    )
  }
  hit
}

get_iqr_range <- function(x, k = 7) {
  q1 <- unname(quantile(x, 0.25, na.rm = TRUE))
  q3 <- unname(quantile(x, 0.75, na.rm = TRUE))
  iqr <- q3 - q1
  c(lower = q1 - k * iqr, upper = q3 + k * iqr)
}

fmt_decimal <- function(x) {
  x[abs(x) < 1e-12] <- 0
  sprintf("%.5f", x)
}

format_p <- function(p) {
  if (is.na(p)) return("NA")
  if (p < 0.001) return("<0.001")
  sprintf("%.3f", p)
}

