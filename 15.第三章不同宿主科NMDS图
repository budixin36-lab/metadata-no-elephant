sh_mat <- sh_mat[, common_samples, drop = FALSE]

meta2 <- meta2 %>%
  filter(sample_id %in% common_samples)

meta2 <- meta2[match(colnames(sh_mat), meta2$sample_id), ]

if (!all(meta2$sample_id == colnames(sh_mat))) {
