plot_alpha_box_letters <- function(alpha_df, letters_df, anova_df, metric, out_png) {

  dat <- alpha_df %>%
    select(status_CN, value = all_of(metric)) %>%
    filter(!is.na(status_CN), !is.na(value), status_CN %in% status_order)

  dat$status_CN <- factor(dat$status_CN, levels = status_order)

  letter_dat <- letters_df %>%
    select(group, letter = all_of(metric)) %>%
    rename(status_CN = group) %>%
    filter(status_CN %in% status_order)

  letter_dat$status_CN <- factor(letter_dat$status_CN, levels = status_order)

  letter_pos_df <- dat %>%
    group_by(status_CN) %>%
    summarise(
      upper_whisker = get_upper_whisker(value),
      .groups = "drop"
    ) %>%
    left_join(letter_dat, by = "status_CN") %>%
    arrange(status_CN)

  y_min <- min(dat$value, na.rm = TRUE)
  y_max <- max(dat$value, na.rm = TRUE)
  y_range <- y_max - y_min

  if (!is.finite(y_range) || y_range == 0) {
    y_range <- max(abs(y_max), 1)
  }

  letter_pos_df <- letter_pos_df %>%
    mutate(
      letter_y = upper_whisker + 0.050 * y_range
    )

  max_letter_y <- max(letter_pos_df$letter_y, na.rm = TRUE)

  anova_p <- anova_df %>%
    filter(metric == !!metric) %>%
    pull(P_value_raw)

  anova_label <- format_anova_label(anova_p[1])

  anova_y <- max_letter_y + 0.13 * y_range
  y_top <- anova_y + 0.10 * y_range

  p <- ggplot(
    dat,
    aes(
      x = status_CN,
      y = value,
      fill = status_CN
    )
  ) +
    geom_boxplot(
      width = 0.56,
      outlier.shape = NA,
      linewidth = 0.40,
      color = "black"
    ) +
    geom_text(
      data = letter_pos_df,
      aes(
        x = status_CN,
        y = letter_y,
        label = letter
      ),
      family = "songti",
      size = 3.3,
      vjust = 0,
      inherit.aes = FALSE
    ) +
    scale_fill_manual(
      values = status_colors,
      drop = FALSE
    ) +
    coord_cartesian(
      ylim = c(y_min, y_top),
      clip = "off"
    ) +
    labs(
      x = NULL,
      y = metric_y_labels[[metric]]
    ) +
    theme_classic(base_family = "songti") +
    theme(
      axis.title.y = element_text(
        size = 10.5,
        family = "songti",
        colour = "black"
      ),
      axis.text.x = element_text(
        size = 10,
        family = "songti",
        colour = "black"
      ),
      axis.text.y = element_text(
        size = 9,
        family = "songti",
        colour = "black"
      ),
      axis.line = element_line(
        linewidth = 0.40,
        colour = "black"
      ),
      axis.ticks = element_line(
        linewidth = 0.40,
        colour = "black"
      ),
      legend.position = "none",
      plot.margin = margin(t = 8, r = 8, b = 6, l = 8)
    ) +
    annotate(
      "text",
      x = 0.60,
      y = anova_y,
      label = anova_label,
      hjust = 0,
      vjust = 1,
      family = "songti",
      size = 2.8
    )

  ggsave(
    filename = out_png,
    plot = p,
    width = 7.1,
    height = 5.2,
    units = "cm",
    dpi = 600,
    bg = "white"
  )

  ggsave(
    filename = sub("\\.png$", ".pdf", out_png),
    plot = p,
    width = 7.1,
    height = 5.2,
    units = "cm",
    bg = "white"
  )
}

