draw_species_ordibar <- function(out_file, device = c("png", "pdf")) {
  device <- match.arg(device)

  if (device == "png") {
    png(
      filename = out_file,
      width = 3900,
      height = 2800,
      res = 600,
      bg = "white"
    )
  } else {
    cairo_pdf(
      filename = out_file,
      width = 13.0,
      height = 9.3,
      bg = "white"
    )
  }

  par(
    mar = c(5.6, 5.6, 2.0, 12.5),
    xpd = NA,
    family = "CNFont"
  )

  # 空白坐标系
  plot(
    display_df$NMDS1,
    display_df$NMDS2,
    type = "n",
    xlim = x_range,
    ylim = y_range,
    xlab = "NMDS1",
    ylab = "NMDS2",
    cex.lab = 1.65,
    cex.axis = 1.15
  )

  coords_mat <- as.matrix(display_df[, c("NMDS1", "NMDS2")])
  rownames(coords_mat) <- display_df$sample_id

  group_factor <- factor(
    display_df$host_species_cn,
    levels = unname(species_cn_map[species_order_key])
  )

  # 每个物种一个颜色：颜色由宿主科决定
  species_col <- sapply(
    levels(group_factor),
    function(sp_cn) {
      key <- names(species_cn_map)[match(sp_cn, species_cn_map)]
      fam <- species_family_map[key]
      family_colors_cn[fam]
    }
  )

  # ordibar: kind = sd
  ordibar(
    coords_mat,
    groups = group_factor,
    kind = "sd",
    label = FALSE,
    col = species_col,
    lwd = bar_lwd
  )

  # 叠加质心点
  for (i in seq_len(nrow(centroid_df))) {
    xi <- centroid_df$NMDS1_mean[i]
    yi <- centroid_df$NMDS2_mean[i]
    sp_key <- as.character(centroid_df$host_species_key[i])
    fam_cn <- as.character(centroid_df$host_family_cn[i])

    pch_i <- unname(species_shape_map[sp_key])
    col_i <- unname(family_colors_cn[fam_cn])

    if (pch_i %in% 21:25) {
      points(
        xi, yi,
        pch = pch_i,
        col = col_i,
        bg = col_i,
        cex = point_cex,
        lwd = 1.1
      )
    } else {
      points(
        xi, yi,
        pch = pch_i,
        col = col_i,
        cex = point_cex,
        lwd = 1.2
      )
    }
  }

  # Adonis 标注
  x_anno <- x_range["lower"] + 0.03 * diff(x_range)
  y_anno <- y_range["upper"] - 0.05 * diff(y_range)

  text(
    x = x_anno,
    y = y_anno,
    labels = adonis_label,
    adj = c(0, 1),
    cex = 1.05
  )

  # stress 标注
  mtext(
    side = 1,
    line = 3.9,
    adj = 0,
    text = paste0("Bray-Curtis NMDS stress = ", sprintf("%.8f", nmds$stress)),
    cex = 1.0
  )

  # 宿主物种图例
  present_keys <- species_order_key[species_order_key %in% as.character(centroid_df$host_species_key)]

  legend_labels <- unname(species_cn_map[present_keys])
  legend_cols <- unname(family_colors_cn[species_family_map[present_keys]])
  legend_pch <- unname(species_shape_map[present_keys])

  legend(
    "right",
    inset = c(-0.24, 0),
    legend = legend_labels,
    col = legend_cols,
    pt.bg = legend_cols,
    pch = legend_pch,
    pt.cex = 1.15,
    bty = "n",
    cex = species_legend_cex,
    y.intersp = 1.05,
    ncol = species_legend_ncol,
    title = NULL
  )

  dev.off()
}

