make_symbol_legend <- function() {
  legend_df <- data.frame(
    host_species_cn = species_order_cn,
    host_family_cn = unname(species_family_map_cn[species_order_cn]),
    color = unname(species_color_map[species_order_cn]),
    symbol = unname(species_symbol_map[species_order_cn]),
    stringsAsFactors = FALSE
  )

  # 顶部到底部排列，并拉开一点点间距
  n <- nrow(legend_df)
  legend_df$y <- rev(seq(1, by = legend_step, length.out = n))
  legend_df$x_symbol <- 1.0
  legend_df$x_text   <- 1.55

  ggplot(legend_df) +
    geom_text(
      aes(x = x_symbol, y = y, label = symbol, color = host_species_cn),
      family = "CNFont",
      size = symbol_size_legend,
      show.legend = FALSE
    ) +
    geom_text(
      aes(x = x_text, y = y, label = host_species_cn),
      family = "CNFont",
      size = legend_text_size / 3.2,
      hjust = 0,
      color = "black"
    ) +
    scale_color_manual(
      values = species_color_map,
      breaks = species_order_cn,
      drop = FALSE
    ) +
    coord_cartesian(
      xlim = c(0.5, 4.4),
      ylim = c(min(legend_df$y) - 0.5, max(legend_df$y) + 0.5),
      clip = "off"
    ) +
    theme_void(base_family = "CNFont") +
    theme(
      plot.margin = margin(t = 20, r = 5, b = 20, l = 5)
    )
}

