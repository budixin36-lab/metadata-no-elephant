make_custom_legend <- function() {
  legend_df <- data.frame(
    host_species_cn = species_order_cn,
    host_family_cn = unname(species_family_map_cn[species_order_cn]),
    color = unname(species_color_map[species_order_cn]),
    fill = unname(species_color_map[species_order_cn]),
    shape = unname(species_shape_map[species_order_cn]),
    is_star = species_order_cn == star_species,
    stringsAsFactors = FALSE
  )

  n <- nrow(legend_df)
  legend_df$y <- rev(seq_len(n))
  legend_df$x_symbol <- 1.0
  legend_df$x_text   <- 1.45

  legend_point_df <- legend_df %>% filter(!is_star)
  legend_star_df  <- legend_df %>% filter(is_star)

  # 图例里的五角星大小
  legend_star_poly <- make_star_polygon(
    cx = legend_star_df$x_symbol[1],
    cy = legend_star_df$y[1],
    rx = 0.13,
    ry = 0.23,
    id = star_species
  )

  ggplot() +
    geom_point(
      data = legend_point_df,
      aes(
        x = x_symbol,
        y = y,
        shape = host_species_cn,
        color = host_species_cn,
        fill = host_species_cn
      ),
      size = 3.2,
      stroke = 0.8
    ) +
    geom_polygon(
      data = legend_star_poly,
      aes(
        x = x,
        y = y,
        group = id
      ),
      fill = unname(species_color_map[star_species]),
      color = unname(species_color_map[star_species]),
      linewidth = 0.4
    ) +
    geom_text(
      data = legend_df,
      aes(
        x = x_text,
        y = y,
        label = host_species_cn
      ),
      hjust = 0,
      family = "CNFont",
      size = 12.4 / 3.2,
      color = "black"
    ) +
    scale_shape_manual(
      values = species_shape_map,
      breaks = names(species_shape_map),
      drop = FALSE
    ) +
    scale_color_manual(
      values = species_color_map,
      breaks = species_order_cn,
      drop = FALSE
    ) +
    scale_fill_manual(
      values = species_color_map,
      breaks = species_order_cn,
      drop = FALSE
    ) +
    coord_cartesian(
      xlim = c(0.6, 4.2),
      ylim = c(0.3, n + 0.8),
      clip = "off"
    ) +
    theme_void(base_family = "CNFont") +
    theme(
      legend.position = "none",
      plot.margin = margin(t = 18, r = 4, b = 18, l = 2)
    )
}

