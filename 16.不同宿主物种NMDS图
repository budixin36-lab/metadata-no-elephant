make_main_plot <- function(segment_df) {
  ggplot() +
    geom_segment(
      data = segment_df,
      aes(
        x = x,
        xend = xend,
        y = y,
        yend = yend,
        color = host_species_cn
      ),
      linewidth = err_linewidth,
      lineend = "butt",
      show.legend = FALSE
    ) +
    geom_text(
      data = centroid_df,
      aes(
        x = NMDS1.mean,
        y = NMDS2.mean,
        label = symbol,
        color = host_species_cn
      ),
      family = "CNFont",
      size = symbol_size_main,
      show.legend = FALSE
    ) +
    annotate(
      "text",
      x = x_anno,
      y = y_anno,
      label = adonis_label,
      hjust = 0,
      vjust = 1,
      size = adonis_text_size,
      family = "CNFont",
      color = "black"
    ) +
    scale_color_manual(
      values = species_color_map,
      breaks = species_order_cn,
      drop = FALSE
    ) +
    scale_x_continuous(
      breaks = x_ticks,
      labels = fmt_decimal,
      expand = expansion(mult = c(0.04, 0.08))
    ) +
    scale_y_continuous(
      breaks = y_ticks,
      labels = fmt_decimal,
      expand = expansion(mult = c(0.05, 0.08))
    ) +
    labs(
      x = "NMDS1",
      y = "NMDS2",
      caption = stress_label
    ) +
    coord_cartesian(
      xlim = x_range,
      ylim = y_range,
      clip = "off"
    ) +
    theme_bw(base_size = 14, base_family = "CNFont") +
    theme(
      panel.grid = element_blank(),
      plot.title = element_blank(),
      legend.position = "none",

      axis.title = element_text(
        size = axis_title_size,
        colour = "black",
        family = "CNFont"
      ),
      axis.text = element_text(
        size = axis_text_size,
        colour = "black",
        family = "CNFont"
      ),

      plot.caption = element_text(
        size = caption_size,
        hjust = 0,
        colour = "black",
        family = "CNFont",
        lineheight = 1.15
      ),
      plot.caption.position = "plot",

      # 左边距加大，避免 NMDS2 与刻度重叠
      plot.margin = margin(t = 10, r = 8, b = 36, l = 22)
    )
}

# =========================
