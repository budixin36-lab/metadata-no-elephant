make_nmds_plot <- function(segment_df, mode_label = c("SD", "SE")) {
  mode_label <- match.arg(mode_label)

  ggplot() +
    geom_segment(
      data = segment_df,
      aes(
        x = x,
        xend = xend,
        y = y,
        yend = yend,
        color = host_species_cn
      ),
      linewidth = err_linewidth,
      lineend = "butt",
      show.legend = FALSE
    ) +
    geom_point(
      data = centroid_df,
      aes(
        x = NMDS1.mean,
        y = NMDS2.mean,
        color = host_species_cn,
        fill = host_species_cn,
        shape = host_species_cn
      ),
      size = point_size,
      stroke = point_stroke,
      alpha = 1
    ) +
    annotate(
      "text",
      x = x_anno,
      y = y_anno,
      label = adonis_label,
      hjust = 0,
      vjust = 1,
      size = adonis_text_size,
      family = "CNFont",
      color = "black"
    ) +
    scale_color_manual(
      values = species_color_map,
      breaks = unname(species_cn_map[species_order_key]),
      drop = FALSE,
      name = NULL
    ) +
    scale_fill_manual(
      values = species_fill_map,
      breaks = unname(species_cn_map[species_order_key]),
      drop = FALSE,
      guide = "none"
    ) +
    scale_shape_manual(
      values = species_shape_map_cn,
      breaks = unname(species_cn_map[species_order_key]),
      drop = FALSE,
      name = NULL
    ) +
    scale_x_continuous(
      breaks = x_ticks,
      labels = fmt_decimal,
      expand = expansion(mult = c(0.04, 0.08))
    ) +
    scale_y_continuous(
      breaks = y_ticks,
      labels = fmt_decimal,
      expand = expansion(mult = c(0.05, 0.08))
    ) +
    labs(
      x = "NMDS1",
      y = "NMDS2",
      caption = stress_label
    ) +
    coord_cartesian(
      xlim = x_range,
      ylim = y_range,
      clip = "off"
    ) +
    theme_bw(base_size = 14, base_family = "CNFont") +
    theme(
      panel.grid = element_blank(),
      plot.title = element_blank(),

      axis.title = element_text(
        size = axis_title_size,
        colour = "black",
        family = "CNFont"
      ),
      axis.text = element_text(
        size = axis_text_size,
        colour = "black",
        family = "CNFont"
      ),

      legend.title = element_blank(),
      legend.text = element_text(
        size = legend_text_size,
        colour = "black",
        family = "CNFont"
      ),
      legend.key = element_blank(),
      legend.background = element_blank(),
      legend.box.background = element_blank(),
      legend.key.height = unit(legend_key_size_cm, "cm"),
      legend.key.width = unit(legend_key_size_cm, "cm"),
      legend.spacing.y = unit(legend_spacing_y_cm, "cm"),
      legend.position = "right",

      plot.caption = element_text(
        size = caption_size,
        hjust = 0,
        colour = "black",
        family = "CNFont",
        lineheight = 1.15
      ),
      plot.caption.position = "plot",

      # 左边距加大，避免 NMDS2 与刻度重叠
      plot.margin = margin(t = 10, r = 22, b = 36, l = 22)
    ) +
    guides(
      color = guide_legend(
        ncol = 1,
        byrow = TRUE,
        override.aes = list(
          size = 3.8,
          alpha = 1,
          fill = species_fill_map
        )
      ),
      shape = guide_legend(
        ncol = 1,
        byrow = TRUE,
        override.aes = list(
          size = 3.8,
          alpha = 1
        )
      )
    )
}

