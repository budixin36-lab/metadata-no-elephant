make_main_plot <- function(segment_df) {
  ggplot() +
    geom_segment(
      data = segment_df,
      aes(
        x = x,
        xend = xend,
        y = y,
        yend = yend,
        color = host_species_cn
      ),
      linewidth = err_linewidth,
      lineend = "butt",
      show.legend = FALSE
    ) +
    geom_point(
      data = centroid_point_df,
      aes(
        x = NMDS1.mean,
        y = NMDS2.mean,
        shape = host_species_cn,
        color = host_species_cn,
        fill = host_species_cn
      ),
      size = 3.0,
      stroke = 0.8,
      show.legend = FALSE
    ) +
    geom_polygon(
      data = star_poly,
      aes(
        x = x,
        y = y,
        group = id
      ),
      fill = unname(species_color_map[star_species]),
      color = unname(species_color_map[star_species]),
      linewidth = 0.4,
      show.legend = FALSE
    ) +
    annotate(
      "text",
      x = x_anno,
      y = y_anno,
      label = adonis_label,
      hjust = 0,
      vjust = 1,
      size = 4.8,
      family = "CNFont",
      color = "black"
    ) +
    scale_shape_manual(
      values = species_shape_map,
      breaks = names(species_shape_map),
      drop = FALSE
    ) +
    scale_color_manual(
      values = species_color_map,
      breaks = species_order_cn,
      drop = FALSE
    ) +
    scale_fill_manual(
      values = species_color_map,
      breaks = species_order_cn,
      drop = FALSE
    ) +
    scale_x_continuous(
      breaks = x_ticks,
      labels = fmt_decimal,
      expand = expansion(mult = c(0.04, 0.08))
    ) +
    scale_y_continuous(
      breaks = y_ticks,
      labels = fmt_decimal,
      expand = expansion(mult = c(0.05, 0.08))
    ) +
    labs(
      x = "NMDS1",
      y = "NMDS2",
      caption = stress_label
    ) +
    coord_cartesian(
      xlim = x_range,
      ylim = y_range,
      clip = "off"
    ) +
    theme_bw(base_size = 14, base_family = "CNFont") +
    theme(
      panel.grid = element_blank(),
      plot.title = element_blank(),
      legend.position = "none",

      axis.title = element_text(
        size = 19,
        colour = "black",
        family = "CNFont"
      ),
      axis.text = element_text(
        size = 13,
        colour = "black",
        family = "CNFont"
      ),

      plot.caption = element_text(
        size = 13,
        hjust = 0,
        colour = "black",
        family = "CNFont",
        lineheight = 1.15
      ),
      plot.caption.position = "plot",

      plot.margin = margin(t = 10, r = 6, b = 36, l = 22)
    )
}

