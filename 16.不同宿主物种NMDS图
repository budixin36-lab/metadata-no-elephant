normalize_species_key <- function(x) {
  x <- as.character(x)
  x <- gsub("×", "x", x)
  x <- gsub("\\s*[xX]\\s*", " x ", x)
  x <- gsub("\\s+", " ", x)
  x <- trimws(x)
  x <- gsub(" ", "_", x)
  x
}

get_padded_range <- function(x, padding = 0.05) {
  r <- range(x, na.rm = TRUE)
  d <- diff(r)
  if (is.na(d) || d == 0) d <- max(abs(r), 1e-6)
  c(
    lower = r[1] - padding * d,
    upper = r[2] + padding * d
  )
}

fmt_decimal <- function(x) {
  x[abs(x) < 1e-12] <- 0
  sprintf("%.5f", x)
}

format_p <- function(p) {
  if (length(p) == 0 || is.na(p)) return("NA")
  if (p < 0.001) return("<0.001")
  sprintf("%.3f", p)
}

extract_adonis_main_row <- function(adonis_df) {
