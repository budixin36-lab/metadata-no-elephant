draw_species_ordibar <- function(out_file, device = c("png", "pdf")) {
  device <- match.arg(device)

  if (device == "png") {
    png(
      filename = out_file,
      width = fig_width_in,
      height = fig_height_in,
      units = "in",
      res = png_res,
      bg = "white",
      type = "cairo"
    )
  } else {
    cairo_pdf(
      filename = out_file,
      width = fig_width_in,
      height = fig_height_in,
      bg = "white"
    )
  }

  layout(
    matrix(c(1, 2), nrow = 1),
    widths = layout_widths
  )

  # -------------------------
  # 左侧 NMDS 图
  # -------------------------
  par(
    mar = c(5.2, 5.0, 1.8, 1.0),
    xpd = FALSE,
    family = "CNFont"
  )

  plot(
    display_df$NMDS1,
    display_df$NMDS2,
    type = "n",
    xlim = x_range,
    ylim = y_range,
    axes = FALSE,
    xlab = "",
    ylab = ""
  )

  box(lwd = 1.2)

  axis(
    side = 1,
    at = x_ticks,
    labels = fmt_decimal(x_ticks),
    cex.axis = 1.05,
    lwd = 1.0
  )

  axis(
    side = 2,
    at = y_ticks,
    labels = fmt_decimal(y_ticks),
    las = 1,
    cex.axis = 1.05,
    lwd = 1.0
  )

  title(
    xlab = "NMDS1",
    ylab = "NMDS2",
    cex.lab = 1.45,
    line = 3.2
  )

  coords_mat <- as.matrix(display_df[, c("NMDS1", "NMDS2")])
  rownames(coords_mat) <- display_df$sample_id

  group_factor <- factor(
    display_df$host_species_cn,
    levels = unname(species_cn_map[species_order_key])
  )

  species_col <- sapply(
    levels(group_factor),
    function(sp_cn) {
      key <- names(species_cn_map)[match(sp_cn, species_cn_map)]
      fam <- species_family_map[key]
      unname(family_colors_cn[fam])
    }
  )

  ordibar(
    coords_mat,
    groups = group_factor,
    kind = "sd",
    label = FALSE,
    col = species_col,
    lwd = bar_lwd
  )

  # 叠加质心点
  for (i in seq_len(nrow(centroid_df))) {
    xi <- centroid_df$NMDS1_mean[i]
    yi <- centroid_df$NMDS2_mean[i]
    sp_key <- as.character(centroid_df$host_species_key[i])
    fam_cn <- as.character(centroid_df$host_family_cn[i])

    pch_i <- unname(species_shape_map[sp_key])
    col_i <- unname(family_colors_cn[fam_cn])

    if (pch_i %in% 21:25) {
      points(
        xi, yi,
        pch = pch_i,
        col = col_i,
        bg = col_i,
        cex = point_cex,
        lwd = 1.0
      )
    } else {
      points(
        xi, yi,
        pch = pch_i,
        col = col_i,
        cex = point_cex,
        lwd = 1.1
      )
    }
  }

  # Adonis 标注
  x_anno <- x_range["lower"] + 0.03 * diff(x_range)
  y_anno <- y_range["upper"] - 0.06 * diff(y_range)

  text(
    x = x_anno,
    y = y_anno,
    labels = adonis_label,
    adj = c(0, 1),
    cex = 0.95
  )

  # stress 标注
  mtext(
    side = 1,
    line = 4.35,
    adj = 0,
    text = paste0("Bray-Curtis NMDS stress = ", sprintf("%.8f", nmds$stress)),
    cex = 0.92
  )

  # -------------------------
  # 右侧单独图例面板
  # -------------------------
  par(
    mar = c(5.2, 0.2, 1.8, 0.2),
    xpd = NA,
    family = "CNFont"
  )

  plot.new()
  plot.window(xlim = c(0, 1), ylim = c(0, 1))

  present_keys <- species_order_key[species_order_key %in% as.character(centroid_df$host_species_key)]

  legend_labels <- unname(species_cn_map[present_keys])
  legend_cols <- unname(family_colors_cn[species_family_map[present_keys]])
  legend_pch <- unname(species_shape_map[present_keys])

  # 两列图例，固定在右侧图例面板中间
  legend(
    x = 0.02,
    y = 0.88,
    legend = legend_labels,
    col = legend_cols,
    pt.bg = legend_cols,
    pch = legend_pch,
    pt.cex = legend_pt_cex,
    bty = "n",
    cex = species_legend_cex,
    y.intersp = 1.15,
    ncol = 2,
    x.intersp = 0.85,
    text.width = 0.28,
    title = NULL
  )

  dev.off()
}

