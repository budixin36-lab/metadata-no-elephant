get_iqr_range <- function(x, k = 7) {
  q1 <- unname(quantile(x, 0.25, na.rm = TRUE))
  q3 <- unname(quantile(x, 0.75, na.rm = TRUE))
  iqr <- q3 - q1
  c(lower = q1 - k * iqr, upper = q3 + k * iqr)
}

get_padded_range <- function(x, padding = 0.05) {
  r <- range(x, na.rm = TRUE)
  d <- diff(r)
  if (is.na(d) || d == 0) d <- max(abs(r), 1e-6)

  c(
    lower = r[1] - padding * d,
    upper = r[2] + padding * d
  )
}

format_p <- function(p) {
  if (length(p) == 0 || is.na(p)) return("NA")
  if (p < 0.001) return("<0.001")
  sprintf("%.3f", p)
}

extract_adonis_main_row <- function(adonis_df) {
  idx <- which(adonis_df$term == "host_species_key")
  if (length(idx) == 0) idx <- which(adonis_df$term == "host_species")
  if (length(idx) == 0) {
    idx <- which(!adonis_df$term %in% c("Residual", "Residuals", "Total"))
  }
  if (length(idx) == 0) stop("无法识别 Adonis 主效应行。")
  idx[1]
}

