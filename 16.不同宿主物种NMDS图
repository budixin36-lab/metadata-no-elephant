# =========================
get_padded_range <- function(x, padding = 0.05) {
  r <- range(x, na.rm = TRUE)
  d <- diff(r)
  if (is.na(d) || d == 0) d <- max(abs(r), 1e-6)

  c(
    lower = r[1] - padding * d,
    upper = r[2] + padding * d
  )
}

fmt_decimal <- function(x) {
  x[abs(x) < 1e-12] <- 0
  sprintf("%.5f", x)
}

format_p <- function(p) {
  if (length(p) == 0 || is.na(p)) return("NA")
  if (p < 0.001) return("<0.001")
  sprintf("%.3f", p)
}

extract_adonis_main_row <- function(adonis_df) {
  idx <- which(adonis_df$term == "host_species_key")
  if (length(idx) == 0) idx <- which(adonis_df$term == "host_species")
  if (length(idx) == 0) {
    idx <- which(!adonis_df$term %in% c("Residual", "Residuals", "Total"))
  }
  if (length(idx) == 0) stop("无法识别 Adonis 主效应行。")
  idx[1]
}

make_axis_ticks <- function(range_vec, target_ticks) {
  target_ticks[target_ticks >= range_vec["lower"] & target_ticks <= range_vec["upper"]]
}

make_ordibar_segments <- function(df_group, scale_factor = 1) {
  xy <- as.matrix(df_group[, c("NMDS1", "NMDS2")])
  center <- colMeans(xy, na.rm = TRUE)

  if (nrow(xy) < 2) {
    return(tibble(
      x = numeric(0), y = numeric(0),
      xend = numeric(0), yend = numeric(0)
    ))
  }

  S <- stats::cov(xy, use = "complete.obs")

  if (any(is.na(S)) || any(!is.finite(S))) {
    return(tibble(
      x = numeric(0), y = numeric(0),
      xend = numeric(0), yend = numeric(0)
    ))
  }

  eg <- eigen(S, symmetric = TRUE)

  out <- vector("list", 2)

  for (i in 1:2) {
    lambda <- max(eg$values[i], 0)
    vec <- eg$vectors[, i]
    half_len <- sqrt(lambda) * scale_factor

    p1 <- center - half_len * vec
    p2 <- center + half_len * vec

    out[[i]] <- tibble(
      x = p1[1],
      y = p1[2],
      xend = p2[1],
      yend = p2[2]
    )
  }

  bind_rows(out)
}

