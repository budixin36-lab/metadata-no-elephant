draw_species_centroid_se <- function(out_file, device = c("png", "pdf")) {
  device <- match.arg(device)

  if (device == "png") {
    png(
      filename = out_file,
      width = fig_width_in,
      height = fig_height_in,
      units = "in",
      res = png_res,
      bg = "white",
      type = "cairo"
    )
  } else {
    cairo_pdf(
      filename = out_file,
      width = fig_width_in,
      height = fig_height_in,
      bg = "white"
    )
  }

  layout(
    matrix(c(1, 2), nrow = 1),
    widths = layout_widths
  )

  # -------------------------
  # 左侧 NMDS 图
  # -------------------------
  par(
    mar = c(5.2, 5.0, 1.8, 0.6),
    xpd = FALSE,
    family = "CNFont"
  )

  plot(
    display_df$NMDS1,
    display_df$NMDS2,
    type = "n",
    xlim = x_range,
    ylim = y_range,
    axes = FALSE,
    xlab = "",
    ylab = ""
  )

  box(lwd = 1.2)

  axis(
    side = 1,
    at = x_ticks,
    labels = fmt_decimal(x_ticks),
    cex.axis = axis_cex,
    lwd = 1.0
  )

  axis(
    side = 2,
    at = y_ticks,
    labels = fmt_decimal(y_ticks),
    las = 1,
    cex.axis = axis_cex,
    lwd = 1.0
  )

  title(
    xlab = "NMDS1",
    ylab = "NMDS2",
    cex.lab = axis_title_cex,
    line = 3.1
  )

  cap_x <- cap_frac * diff(x_range)
  cap_y <- cap_frac * diff(y_range)

  # 先画误差条，再画点
  for (i in seq_len(nrow(centroid_df))) {
    xi <- centroid_df$NMDS1_mean[i]
    yi <- centroid_df$NMDS2_mean[i]
    xse <- centroid_df$NMDS1_se[i]
    yse <- centroid_df$NMDS2_se[i]
    col_i <- as.character(centroid_df$color[i])

    # 横向误差条：NMDS1 mean ± 1 SE
    segments(
      x0 = xi - xse, y0 = yi,
      x1 = xi + xse, y1 = yi,
      col = col_i, lwd = err_lwd
    )
    segments(
      x0 = xi - xse, y0 = yi - cap_y,
      x1 = xi - xse, y1 = yi + cap_y,
      col = col_i, lwd = err_lwd
    )
    segments(
      x0 = xi + xse, y0 = yi - cap_y,
      x1 = xi + xse, y1 = yi + cap_y,
      col = col_i, lwd = err_lwd
    )

    # 纵向误差条：NMDS2 mean ± 1 SE
    segments(
      x0 = xi, y0 = yi - yse,
      x1 = xi, y1 = yi + yse,
      col = col_i, lwd = err_lwd
    )
    segments(
      x0 = xi - cap_x, y0 = yi - yse,
      x1 = xi + cap_x, y1 = yi - yse,
      col = col_i, lwd = err_lwd
    )
    segments(
      x0 = xi - cap_x, y0 = yi + yse,
      x1 = xi + cap_x, y1 = yi + yse,
      col = col_i, lwd = err_lwd
    )
  }

  # 叠加质心点
  for (i in seq_len(nrow(centroid_df))) {
    xi <- centroid_df$NMDS1_mean[i]
    yi <- centroid_df$NMDS2_mean[i]
    sp_key <- as.character(centroid_df$host_species_key[i])
    fam_cn <- as.character(centroid_df$host_family_cn[i])

    pch_i <- unname(species_shape_map[sp_key])
    col_i <- unname(family_colors_cn[fam_cn])

    if (pch_i %in% 21:25) {
      points(
        xi, yi,
        pch = pch_i,
        col = col_i,
        bg = col_i,
        cex = point_cex,
        lwd = point_lwd
      )
    } else {
      points(
        xi, yi,
        pch = pch_i,
        col = col_i,
        cex = point_cex,
        lwd = point_lwd
      )
    }
  }

  # Adonis 标注
  x_anno <- x_range["lower"] + 0.03 * diff(x_range)
  y_anno <- y_range["upper"] - 0.06 * diff(y_range)

  text(
    x = x_anno,
    y = y_anno,
    labels = adonis_label,
    adj = c(0, 1),
    cex = adonis_cex
  )

  # stress 标注
  mtext(
    side = 1,
    line = 4.35,
    adj = 0,
    text = paste0("Bray-Curtis NMDS stress = ", sprintf("%.8f", nmds$stress)),
    cex = stress_cex
  )

  # -------------------------
  # 右侧单独图例面板
  # -------------------------
  par(
    mar = c(5.2, 0.2, 1.8, 0.2),
    xpd = NA,
    family = "CNFont"
  )

  plot.new()
  plot.window(xlim = c(0, 1), ylim = c(0, 1))

  present_keys <- species_order_key[species_order_key %in% as.character(centroid_df$host_species_key)]

  legend_labels <- unname(species_cn_map[present_keys])
  legend_cols   <- unname(family_colors_cn[species_family_map[present_keys]])
  legend_pch    <- unname(species_shape_map[present_keys])

  legend(
    x = 0.02,
    y = 0.50,
    legend = legend_labels,
    col = legend_cols,
    pt.bg = legend_cols,
    pch = legend_pch,
    pt.cex = legend_pt_cex,
    bty = "n",
    cex = legend_cex,
    y.intersp = 1.08,
    ncol = 1,
    xjust = 0,
    yjust = 0.5,
    title = NULL
  )

  dev.off()
}

