  if (length(idx) == 0) idx <- which(!adonis_df$term %in% c("Residual", "Residuals", "Total"))
  if (length(idx) == 0) stop("无法识别 Adonis 主效应行。")
  idx[1]
}

make_axis_ticks <- function(range_vec, target_ticks) {
  target_ticks[target_ticks >= range_vec["lower"] & target_ticks <= range_vec["upper"]]
}

make_cross_segments <- function(df, mode = c("SD", "SE")) {
  mode <- match.arg(mode)

  if (mode == "SD") {
    x_left  <- df$NMDS1.mean_minus_1SD
    x_right <- df$NMDS1.mean_plus_1SD
    y_down  <- df$NMDS2.mean_minus_1SD
    y_up    <- df$NMDS2.mean_plus_1SD
  } else {
    x_left  <- df$NMDS1.mean_minus_1SE
    x_right <- df$NMDS1.mean_plus_1SE
    y_down  <- df$NMDS2.mean_minus_1SE
    y_up    <- df$NMDS2.mean_plus_1SE
  }

  bind_rows(
    data.frame(
      host_species_cn = df$host_species_cn,
      host_family_cn = df$host_family_cn,
      segment_type = paste0("horizontal_", mode),
      x = x_left,
      xend = x_right,
      y = df$NMDS2.mean,
      yend = df$NMDS2.mean,
      stringsAsFactors = FALSE
    ),
    data.frame(
      host_species_cn = df$host_species_cn,
      host_family_cn = df$host_family_cn,
      segment_type = paste0("vertical_", mode),
      x = df$NMDS1.mean,
      xend = df$NMDS1.mean,
      y = y_down,
      yend = y_up,
      stringsAsFactors = FALSE
    )
  )
}

