  summarise(
    n_display = n(),
    NMDS1.mean = mean(NMDS1, na.rm = TRUE),
    NMDS2.mean = mean(NMDS2, na.rm = TRUE),
    NMDS1.sd = sd(NMDS1, na.rm = TRUE),
    NMDS2.sd = sd(NMDS2, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    NMDS1.sd = ifelse(is.na(NMDS1.sd), 0, NMDS1.sd),
    NMDS2.sd = ifelse(is.na(NMDS2.sd), 0, NMDS2.sd),

    NMDS1.se = ifelse(n_display > 1, NMDS1.sd / sqrt(n_display), 0),
    NMDS2.se = ifelse(n_display > 1, NMDS2.sd / sqrt(n_display), 0),

    NMDS1.mean_minus_1SD = NMDS1.mean - NMDS1.sd,
    NMDS1.mean_plus_1SD = NMDS1.mean + NMDS1.sd,
    NMDS2.mean_minus_1SD = NMDS2.mean - NMDS2.sd,
    NMDS2.mean_plus_1SD = NMDS2.mean + NMDS2.sd,

    NMDS1.mean_minus_1SE = NMDS1.mean - NMDS1.se,
    NMDS1.mean_plus_1SE = NMDS1.mean + NMDS1.se,
    NMDS2.mean_minus_1SE = NMDS2.mean - NMDS2.se,
    NMDS2.mean_plus_1SE = NMDS2.mean + NMDS2.se,

    NMDS1.sd_over_se = ifelse(NMDS1.se > 0, NMDS1.sd / NMDS1.se, NA_real_),
    NMDS2.sd_over_se = ifelse(NMDS2.se > 0, NMDS2.sd / NMDS2.se, NA_real_),

    shape = unname(species_shape_map[as.character(host_species_key)]),
    color = unname(family_colors_cn[as.character(host_family_cn)])
  ) %>%
  mutate(
    host_species_cn = factor(host_species_cn, levels = unname(species_cn_map[species_order_key])),
    host_family_cn = factor(host_family_cn, levels = family_order_cn)
  ) %>%
