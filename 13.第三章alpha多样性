format_p_for_paper <- function(p) {
  ifelse(
    is.na(p),
    NA_character_,
    ifelse(
      p < 0.001,
      "<0.001***",
      ifelse(
        p < 0.01,
        sprintf("%.4f**", p),
        ifelse(
          p < 0.05,
          sprintf("%.4f*", p),
          sprintf("%.4f", p)
        )
      )
    )
  )
}

format_p_plain <- function(p) {
  ifelse(
    is.na(p),
    NA_character_,
    ifelse(p < 0.001, "<0.001", sprintf("%.4f", p))
  )
}

sig_label <- function(p) {
  case_when(
    is.na(p) ~ NA_character_,
    p < 0.001 ~ "***",
    p < 0.01 ~ "**",
    p < 0.05 ~ "*",
    TRUE ~ "ns"
  )
}

clean_group_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c("", "NA", "Na", "na", "N/A", "n/a",
             "missing", "Missing",
             "not_recorded", "not recorded", "Not recorded",
             "not reported", "Not reported")] <- NA
  x
}

# 根据 TukeyHSD p adj 生成紧凑字母标注
get_tukey_letters <- function(df, group_col, metric) {
  dat <- df %>%
    select(
      group = all_of(group_col),
      value = all_of(metric)
    ) %>%
    filter(!is.na(group), !is.na(value))

  dat$group <- factor(dat$group)

  if (nlevels(dat$group) < 2) {
    groups <- levels(dat$group)
    return(setNames(rep("a", length(groups)), groups))
  }

  fit <- aov(value ~ group, data = dat)
  tk <- TukeyHSD(fit)$group

  pvals <- tk[, "p adj"]
  names(pvals) <- rownames(tk)

  letters <- multcompView::multcompLetters(pvals, threshold = 0.05)$Letters

  # 为了让均值最高的组优先显示为 a，这里按均值从高到低重新映射字母
  means <- dat %>%
    group_by(group) %>%
    summarise(mean_value = mean(value, na.rm = TRUE), .groups = "drop") %>%
    arrange(desc(mean_value))

  old_letters <- letters[as.character(means$group)]

  unique_old <- unique(old_letters)
  new_letters <- letters[as.character(means$group)]

  # 多字母组合可能出现 ab、bc 等，不能简单整体替换。
  # 这里保留 multcompLetters 的原始字母结果，不强行重排，
  # 避免复杂组合被错误映射。
  letters
}

run_anova_table <- function(df, group_col, metrics) {
  out <- list()

  for (m in metrics) {
    dat <- df %>%
      select(
        group = all_of(group_col),
        value = all_of(m)
      ) %>%
      filter(!is.na(group), !is.na(value))

    dat$group <- factor(dat$group)

    fit <- aov(value ~ group, data = dat)
    sm <- summary(fit)[[1]]

    p <- sm["group", "Pr(>F)"]

    out[[m]] <- data.frame(
      metric = m,
      group_variable = group_col,
      Df_between = sm["group", "Df"],
      Df_within = sm["Residuals", "Df"],
      F_value = sm["group", "F value"],
      P_value_raw = p,
      P_value_for_paper = format_p_for_paper(p),
      P_value_plain = format_p_plain(p),
      significance = sig_label(p),
      stringsAsFactors = FALSE
    )
  }

  bind_rows(out)
}

run_tukey_table <- function(df, group_col, metrics, only_significant = FALSE) {
  out <- list()

  for (m in metrics) {
    dat <- df %>%
      select(
        group = all_of(group_col),
        value = all_of(m)
      ) %>%
      filter(!is.na(group), !is.na(value))

    dat$group <- factor(dat$group)

    fit <- aov(value ~ group, data = dat)
    tk <- TukeyHSD(fit)$group

    tk_df <- as.data.frame(tk) %>%
      rownames_to_column("comparison") %>%
      mutate(
        metric = m,
        group_variable = group_col,
        p_adj_raw = `p adj`,
        p_adj_for_paper = format_p_for_paper(`p adj`),
        p_adj_plain = format_p_plain(`p adj`),
        significance = sig_label(`p adj`)
      ) %>%
      select(
        metric,
        group_variable,
        comparison,
        diff,
        lwr,
        upr,
        p_adj_raw,
        p_adj_for_paper,
        p_adj_plain,
        significance
      )

    if (only_significant) {
      tk_df <- tk_df %>% filter(p_adj_raw < 0.05)
    }

    out[[m]] <- tk_df
  }

  bind_rows(out)
}

make_mean_sd_detail <- function(df, group_col, metrics) {
  out <- df %>%
    group_by(.data[[group_col]]) %>%
    summarise(
      n = n(),
      across(
        all_of(metrics),
        list(
          mean = ~ mean(.x, na.rm = TRUE),
          sd = ~ sd(.x, na.rm = TRUE)
        ),
        .names = "{.col}_{.fn}"
      ),
      .groups = "drop"
    )

  # 增加 mean ± SD 文本列，方便自查
  for (m in metrics) {
    mean_col <- paste0(m, "_mean")
    sd_col <- paste0(m, "_sd")
    mean_sd_col <- paste0(m, "_mean_sd")

    if (m %in% c("Shannon", "Simpson")) {
      out[[mean_sd_col]] <- sprintf(
        "%.4f ± %.4f",
        out[[mean_col]],
        out[[sd_col]]
      )
    } else {
      out[[mean_sd_col]] <- sprintf(
        "%.2f ± %.2f",
        out[[mean_col]],
        out[[sd_col]]
      )
    }
  }

  out %>% arrange(desc(n))
}

make_paper_table <- function(df, group_col, metrics, anova_table) {
  sample_count <- df %>%
    count(.data[[group_col]], name = "n") %>%
    rename(group = all_of(group_col))

  mean_table <- df %>%
    group_by(.data[[group_col]]) %>%
    summarise(
      across(
        all_of(metrics),
        ~ mean(.x, na.rm = TRUE),
        .names = "{.col}_mean"
      ),
      .groups = "drop"
    ) %>%
    rename(group = all_of(group_col))

  paper <- sample_count %>%
    left_join(mean_table, by = "group")

  # 给每个指标加 TukeyHSD 字母
  for (m in metrics) {
    letters <- get_tukey_letters(df, group_col, m)

    mean_col <- paste0(m, "_mean")

    if (m %in% c("Shannon", "Simpson")) {
      paper[[m]] <- paste0(
        sprintf("%.4f", paper[[mean_col]]),
        letters[as.character(paper$group)]
      )
    } else {
      paper[[m]] <- paste0(
        sprintf("%.2f", paper[[mean_col]]),
        letters[as.character(paper$group)]
      )
    }
  }

  paper <- paper %>%
    select(group, n, all_of(metrics)) %>%
    arrange(desc(n))

  anova_row <- data.frame(
    group = "ANOVA（P-value）",
    n = NA_integer_,
    stringsAsFactors = FALSE
  )

  for (m in metrics) {
    p_show <- anova_table %>%
      filter(metric == m) %>%
      pull(P_value_for_paper)

    anova_row[[m]] <- ifelse(length(p_show) == 1, p_show, NA_character_)
  }

  bind_rows(paper, anova_row)
}

