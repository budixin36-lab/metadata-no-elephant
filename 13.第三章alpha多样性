format_p_for_paper <- function(p) {
  ifelse(
    is.na(p),
    NA_character_,
    ifelse(
      p < 0.001,
      "<0.001***",
      ifelse(
        p < 0.01,
        sprintf("%.4f**", p),
        ifelse(
          p < 0.05,
          sprintf("%.4f*", p),
          sprintf("%.4f", p)
        )
      )
    )
  )
}

format_p_plain <- function(p) {
  ifelse(
    is.na(p),
    NA_character_,
    ifelse(p < 0.001, "<0.001", sprintf("%.4f", p))
  )
}

sig_label <- function(p) {
  case_when(
    is.na(p) ~ NA_character_,
    p < 0.001 ~ "***",
    p < 0.01 ~ "**",
    p < 0.05 ~ "*",
    TRUE ~ "ns"
  )
}

clean_group_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c(
    "", "NA", "Na", "na", "N/A", "n/a",
    "missing", "Missing",
    "not_recorded", "not recorded", "Not recorded",
    "not reported", "Not reported"
  )] <- NA
  x
}

# ------------------------------------------------------------
# 自写 TukeyHSD 字母标注函数
#
# 逻辑：
# 1. 先计算每个组均值，按均值从高到低排序。
# 2. TukeyHSD p adj < 0.05 的组对视为显著不同。
# 3. 贪心分配字母：
#    - 同一个字母下的任意两组都不能显著不同。
#    - 某组可拥有多个字母。
#    - 尽量保证差异不显著的组至少共享一个字母。
#
# 解释：
# 同列含相同字母表示差异不显著；
# 不含相同字母表示差异显著。
# ------------------------------------------------------------
make_tukey_letters_no_package <- function(df, group_col, metric, alpha = 0.05) {
  dat <- df %>%
    select(
      group = all_of(group_col),
      value = all_of(metric)
    ) %>%
    filter(!is.na(group), !is.na(value))

  dat$group <- factor(dat$group)

  groups_ordered <- dat %>%
    group_by(group) %>%
    summarise(mean_value = mean(value, na.rm = TRUE), .groups = "drop") %>%
    arrange(desc(mean_value)) %>%
    pull(group) %>%
    as.character()

  if (length(groups_ordered) == 1) {
    return(setNames("a", groups_ordered))
  }

  fit <- aov(value ~ group, data = dat)
  tk <- TukeyHSD(fit)$group

  # 显著性矩阵：TRUE = 两组显著不同
  sig_mat <- matrix(
    FALSE,
    nrow = length(groups_ordered),
    ncol = length(groups_ordered),
    dimnames = list(groups_ordered, groups_ordered)
  )

  for (comp in rownames(tk)) {
    p <- tk[comp, "p adj"]

    # TukeyHSD comparison 形式通常是 group2-group1
    parts <- strsplit(comp, "-", fixed = TRUE)[[1]]

    if (length(parts) == 2) {
      g1 <- parts[1]
      g2 <- parts[2]

      if (g1 %in% groups_ordered && g2 %in% groups_ordered) {
        if (!is.na(p) && p < alpha) {
          sig_mat[g1, g2] <- TRUE
          sig_mat[g2, g1] <- TRUE
        }
      }
    }
  }

  letters_pool <- c(
    letters,
    paste0("a", letters),
    paste0("b", letters),
    paste0("c", letters),
    paste0("d", letters),
    paste0("e", letters),
    paste0("f", letters)
  )

  group_letters <- setNames(rep("", length(groups_ordered)), groups_ordered)
  letter_groups <- list()

  # 第一步：按均值从高到低分配至少一个字母
  for (g in groups_ordered) {
    assigned <- FALSE

    if (length(letter_groups) > 0) {
      for (li in seq_along(letter_groups)) {
        members <- letter_groups[[li]]

        # 当前组与这个字母已有所有成员都不能显著不同，才能共享字母
        can_share <- all(!sig_mat[g, members])

        if (can_share) {
          letter_groups[[li]] <- c(members, g)
          group_letters[g] <- paste0(group_letters[g], letters_pool[li])
          assigned <- TRUE
          break
        }
      }
    }

    if (!assigned) {
      new_i <- length(letter_groups) + 1
      letter_groups[[new_i]] <- g
      group_letters[g] <- paste0(group_letters[g], letters_pool[new_i])
    }
  }

  # 第二步：补充字母，尽量让所有“不显著”的组对共享至少一个字母
  for (i in seq_along(groups_ordered)) {
    for (j in seq_along(groups_ordered)) {
      if (j <= i) next

      g1 <- groups_ordered[i]
      g2 <- groups_ordered[j]

      if (!sig_mat[g1, g2]) {
        chars1 <- unlist(strsplit(group_letters[g1], split = ""))
        chars2 <- unlist(strsplit(group_letters[g2], split = ""))

        # 这里仅适用于单字符字母池前 26 个；
        # 对多数论文分组已经足够。
        # 若字母池出现 aa、ab 这类多字符，下面仍然不影响已有分配，
        # 只是补字母步骤不强行拆解多字符。
        shared <- length(intersect(chars1, chars2)) > 0

        if (!shared) {
          # 尝试把 g2 加入 g1 的某个字母组
          added <- FALSE

          for (li in seq_along(letter_groups)) {
            members <- letter_groups[[li]]

            if (g1 %in% members && !(g2 %in% members)) {
              can_add <- all(!sig_mat[g2, members])

              if (can_add) {
                letter_groups[[li]] <- c(members, g2)
                group_letters[g2] <- paste0(group_letters[g2], letters_pool[li])
                added <- TRUE
                break
              }
            }
          }

          # 如果不行，尝试把 g1 加入 g2 的某个字母组
          if (!added) {
            for (li in seq_along(letter_groups)) {
              members <- letter_groups[[li]]

              if (g2 %in% members && !(g1 %in% members)) {
                can_add <- all(!sig_mat[g1, members])

                if (can_add) {
                  letter_groups[[li]] <- c(members, g1)
                  group_letters[g1] <- paste0(group_letters[g1], letters_pool[li])
                  added <- TRUE
                  break
                }
              }
            }
          }
        }
      }
    }
  }

  group_letters
}

run_anova_table <- function(df, group_col, metrics) {
  out <- list()

  for (m in metrics) {
    dat <- df %>%
      select(
        group = all_of(group_col),
        value = all_of(m)
      ) %>%
      filter(!is.na(group), !is.na(value))

    dat$group <- factor(dat$group)

    fit <- aov(value ~ group, data = dat)
    sm <- summary(fit)[[1]]

    p <- sm["group", "Pr(>F)"]

    out[[m]] <- data.frame(
      metric = m,
      group_variable = group_col,
      Df_between = sm["group", "Df"],
      Df_within = sm["Residuals", "Df"],
      F_value = sm["group", "F value"],
      P_value_raw = p,
      P_value_for_paper = format_p_for_paper(p),
      P_value_plain = format_p_plain(p),
      significance = sig_label(p),
      stringsAsFactors = FALSE
    )
  }

  bind_rows(out)
}

run_tukey_table <- function(df, group_col, metrics, only_significant = FALSE) {
  out <- list()

  for (m in metrics) {
    dat <- df %>%
      select(
        group = all_of(group_col),
        value = all_of(m)
      ) %>%
      filter(!is.na(group), !is.na(value))

    dat$group <- factor(dat$group)

    fit <- aov(value ~ group, data = dat)
    tk <- TukeyHSD(fit)$group

    tk_df <- as.data.frame(tk) %>%
      rownames_to_column("comparison") %>%
      mutate(
        metric = m,
        group_variable = group_col,
        p_adj_raw = `p adj`,
        p_adj_for_paper = format_p_for_paper(`p adj`),
        p_adj_plain = format_p_plain(`p adj`),
        significance = sig_label(`p adj`)
      ) %>%
      select(
        metric,
        group_variable,
        comparison,
        diff,
        lwr,
        upr,
        p_adj_raw,
        p_adj_for_paper,
        p_adj_plain,
        significance
      )

    if (only_significant) {
      tk_df <- tk_df %>% filter(p_adj_raw < 0.05)
    }

    out[[m]] <- tk_df
  }

  bind_rows(out)
}

make_mean_sd_detail <- function(df, group_col, metrics) {
  out <- df %>%
    group_by(.data[[group_col]]) %>%
    summarise(
      n = n(),
      across(
        all_of(metrics),
        list(
          mean = ~ mean(.x, na.rm = TRUE),
          sd = ~ sd(.x, na.rm = TRUE)
        ),
        .names = "{.col}_{.fn}"
      ),
      .groups = "drop"
    )

  for (m in metrics) {
    mean_col <- paste0(m, "_mean")
    sd_col <- paste0(m, "_sd")
    mean_sd_col <- paste0(m, "_mean_sd")

    if (m %in% c("Shannon", "Simpson")) {
      out[[mean_sd_col]] <- sprintf(
        "%.4f ± %.4f",
        out[[mean_col]],
        out[[sd_col]]
      )
    } else {
      out[[mean_sd_col]] <- sprintf(
        "%.2f ± %.2f",
        out[[mean_col]],
        out[[sd_col]]
      )
    }
  }

  out %>% arrange(desc(n))
}

make_paper_table <- function(df, group_col, metrics, anova_table) {
  sample_count <- df %>%
    count(.data[[group_col]], name = "n") %>%
    rename(group = all_of(group_col))

  mean_table <- df %>%
    group_by(.data[[group_col]]) %>%
    summarise(
      across(
        all_of(metrics),
        ~ mean(.x, na.rm = TRUE),
        .names = "{.col}_mean"
      ),
      .groups = "drop"
    ) %>%
    rename(group = all_of(group_col))

  paper <- sample_count %>%
    left_join(mean_table, by = "group")

  for (m in metrics) {
    letter_vec <- make_tukey_letters_no_package(df, group_col, m, alpha = 0.05)
    mean_col <- paste0(m, "_mean")

    if (m %in% c("Shannon", "Simpson")) {
      paper[[m]] <- paste0(
        sprintf("%.4f", paper[[mean_col]]),
        letter_vec[as.character(paper$group)]
      )
    } else {
      paper[[m]] <- paste0(
        sprintf("%.2f", paper[[mean_col]]),
        letter_vec[as.character(paper$group)]
      )
    }
  }

  paper <- paper %>%
    select(group, n, all_of(metrics)) %>%
    arrange(desc(n))

  anova_row <- data.frame(
    group = "ANOVA（P-value）",
    n = NA_integer_,
    stringsAsFactors = FALSE
  )

  for (m in metrics) {
    p_show <- anova_table %>%
      filter(metric == m) %>%
      pull(P_value_for_paper)

    anova_row[[m]] <- ifelse(length(p_show) == 1, p_show, NA_character_)
  }

  bind_rows(paper, anova_row)
}

save_workbook_with_auto_width <- function(wb, file) {
  sheets <- names(wb)

  for (s in sheets) {
    try(
      setColWidths(wb, sheet = s, cols = 1:80, widths = "auto"),
      silent = TRUE
    )
  }

  saveWorkbook(wb, file, overwrite = TRUE)
}

