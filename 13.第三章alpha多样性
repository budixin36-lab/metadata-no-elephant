#我看了你上传的 SH_abundance_table_no_elephant.tsv，它开头是这种格式：
## Constructed from biom file
##OTU ID    CRR279953    CRR279954    CRR279955 ...
#SH1048232.10FU    0.0    0.0    0.0 ...
#也就是说，第 1 行只是说明文字，不是真正表头；第 2 行才是真正的列名。
#但我上一版脚本用了：read.delim(sh_table_file, header = TRUE, ...)
#R 会把第 1 行 # Constructed from biom file 当作表头。它只有 1 列，而第 2 行有 3238 列，所以就报错：more columns than column names
#你只需要把读取 SH 表的部分改成 跳过第 1 行，并保留第 2 行的 #OTU ID 作为表头。
#你可以直接用下面命令自动替换，不用手动找：
cd /mnt/d/ITS_SH_pipeline

python3 - <<'PY'
from pathlib import Path

script = Path("scripts/05_alpha_diversity_anova_tukey_no_elephant.R")
txt = script.read_text()

old = '''sh_tab <- read.delim(
  sh_table_file,
  header = TRUE,
  sep = "\\t",
  check.names = FALSE,
  stringsAsFactors = FALSE,
  comment.char = ""
)'''

new = '''sh_tab <- read.delim(
  sh_table_file,
  header = TRUE,
  sep = "\\t",
  skip = 1,
  check.names = FALSE,
  stringsAsFactors = FALSE,
  comment.char = ""
)'''

if old not in txt:
    raise SystemExit("没有找到需要替换的 read.delim 代码块，请检查脚本是否和上一版一致。")

script.write_text(txt.replace(old, new))
print("已修改：读取 SH abundance table 时跳过第 1 行说明文字。")
PY
#然后重新运行：
Rscript scripts/05_alpha_diversity_anova_tukey_no_elephant.R
