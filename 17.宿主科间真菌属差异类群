  "LEfSe_input_host_family_generation_summary_no_elephant.txt"
)

# -----------------------------
# helper
# -----------------------------
clean_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c(
    "", "NA", "N/A", "na", "n/a",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded",
    "not_reported", "not reported",
    "unknown", "Unknown", "UNKNOWN"
  )] <- NA
  x
}

clean_feature_name <- function(x) {
  x <- as.character(x)
  x <- trimws(x)
  x <- gsub("^g__", "", x)
  x <- gsub("^g_", "", x)
  x <- gsub("\\|", "_", x)
  x <- gsub("[[:space:]]+", "_", x)
  x <- gsub("[^A-Za-z0-9_]+", "_", x)
  x <- gsub("_+", "_", x)
  x <- gsub("^_|_$", "", x)
  x
}

is_pure_unclassified <- function(x) {
  y <- tolower(trimws(as.character(x)))
  y %in% c(
    "", "na", "n/a",
    "unclassified", "unassigned", "unknown",
    "unidentified", "uncultured",
    "not_assigned", "not assigned",
    "no_rank"
  )
}

read_genus_table <- function(file) {
  lines <- readLines(file, warn = FALSE)
  lines <- lines[nchar(trimws(lines)) > 0]

  if (length(lines) == 0) {
    stop("genus abundance table 为空：", file)
  }

  # 兼容 biom export 风格的第一行说明
  if (grepl("^# Constructed from biom file", lines[1])) {
    lines <- lines[-1]
  }

  tab <- read.delim(
    text = paste(lines, collapse = "\n"),
    header = TRUE,
    sep = "\t",
    check.names = FALSE,
    stringsAsFactors = FALSE,
    quote = "",
    comment.char = ""
  )

  colnames(tab)[1] <- "genus"

  # 去掉可能存在的 taxonomy / metadata 列
  drop_cols <- grep("taxonomy|metadata", colnames(tab), ignore.case = TRUE, value = TRUE)
  if (length(drop_cols) > 0) {
    tab <- tab[, !colnames(tab) %in% drop_cols, drop = FALSE]
  }

  tab
}

# -----------------------------
# 1. metadata
# -----------------------------
meta <- read.csv(
  metadata_file,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

possible_sample_cols <- c("sampleid", "sample_id", "#SampleID", "SampleID", "sample", "Run", "run")
sample_col <- possible_sample_cols[possible_sample_cols %in% colnames(meta)][1]

if (is.na(sample_col)) {
  stop("metadata 中找不到样本 ID 列。")
}

if (!"host_family" %in% colnames(meta)) {
  stop("metadata 中没有 host_family 列。")
}

family_order <- c(
  "Bovidae",
  "Suidae",
  "Cervidae",
  "Equidae",
  "Rhinocerotidae"
)

meta2 <- meta %>%
  mutate(
    sample_id = clean_value(.data[[sample_col]]),
    host_family = clean_value(host_family)
  ) %>%
  filter(
    !is.na(sample_id),
    !is.na(host_family),
    host_family %in% family_order
  ) %>%
  distinct(sample_id, .keep_all = TRUE)

# -----------------------------
# 2. genus abundance table
# -----------------------------
genus_tab <- read_genus_table(genus_file)

sample_cols_all <- setdiff(colnames(genus_tab), "genus")

common_samples <- intersect(sample_cols_all, meta2$sample_id)
common_samples <- sample_cols_all[sample_cols_all %in% common_samples]

if (length(common_samples) == 0) {
  stop("genus abundance table 和 metadata 没有匹配到共同样本。")
}

meta2 <- meta2 %>%
  filter(sample_id %in% common_samples)

meta2 <- meta2[match(common_samples, meta2$sample_id), ]

genus_tab <- genus_tab %>%
  select(genus, all_of(common_samples))

# 转数值
genus_mat <- genus_tab %>%
  column_to_rownames("genus") %>%
  as.matrix()

storage.mode(genus_mat) <- "numeric"
genus_mat[is.na(genus_mat)] <- 0

# 去掉纯 Unclassified，但保留 Fungi gen Incertae sedis 这类特征
keep_features <- !is_pure_unclassified(rownames(genus_mat))
genus_mat <- genus_mat[keep_features, , drop = FALSE]

# 如果特征名清洗后重名，合并
feature_clean <- clean_feature_name(rownames(genus_mat))

genus_mat2 <- rowsum(genus_mat, group = feature_clean, reorder = FALSE)

# 删除清洗后空名
genus_mat2 <- genus_mat2[rownames(genus_mat2) != "", , drop = FALSE]

# 转为样本内相对丰度百分比
sample_sums <- colSums(genus_mat2, na.rm = TRUE)

if (any(sample_sums == 0)) {
  stop("存在 genus 总丰度为 0 的样本，无法转相对丰度。")
}

genus_rel <- sweep(genus_mat2, 2, sample_sums, "/") * 100
genus_rel[is.na(genus_rel)] <- 0

# LEfSe feature 前缀
lefse_features <- paste0("k__Fungi|g__", rownames(genus_rel))
rownames(genus_rel) <- lefse_features

# -----------------------------
# 3. write LEfSe input
# -----------------------------
class_row <- c("class", as.character(meta2$host_family))
subclass_row <- c("subclass", rep("no_subclass", nrow(meta2)))
subject_row <- c("subject", as.character(meta2$sample_id))

feature_table <- as.data.frame(genus_rel) %>%
  rownames_to_column("ID")

feature_table <- feature_table[, c("ID", meta2$sample_id), drop = FALSE]
feature_table[] <- lapply(feature_table, as.character)

out <- rbind(
  class_row,
  subclass_row,
  subject_row,
  as.matrix(feature_table)
)

write.table(
  out,
  out_input,
  sep = "\t",
  quote = FALSE,
  row.names = FALSE,
  col.names = FALSE
)

# 记录样本量和特征数
write.csv(
  meta2 %>% count(host_family, sort = FALSE),
  file.path(out_dir, "LEfSe_host_family_sample_count_no_elephant.csv"),
  row.names = FALSE
)

write.csv(
  data.frame(
    lefse_feature = rownames(genus_rel),
    original_or_clean_genus = gsub("^k__Fungi\\|g__", "", rownames(genus_rel))
  ),
  file.path(out_dir, "LEfSe_host_family_genus_feature_list_no_elephant.csv"),
  row.names = FALSE
)

sink(summary_file)
cat("LEfSe input generation summary: host_family genus no-elephant\n")
cat("============================================================\n\n")
cat("Input metadata:\n", metadata_file, "\n\n", sep = "")
cat("Input genus abundance table:\n", genus_file, "\n\n", sep = "")
cat("Output LEfSe input:\n", out_input, "\n\n", sep = "")
cat("Matched samples:", nrow(meta2), "\n")
cat("Genus features for LEfSe:", nrow(genus_rel), "\n\n")
cat("Host family sample counts:\n")
print(meta2 %>% count(host_family, sort = FALSE))
sink()

cat("\nDone!\n")
cat("Matched samples:", nrow(meta2), "\n")
cat("Genus features for LEfSe:", nrow(genus_rel), "\n")
cat("Output:\n", out_input, "\n", sep = "")
EOF

