  group_by(sample_id) %>%
  summarise(
    total_abundance = sum(abundance, na.rm = TRUE),
    .groups = "drop"
  )

genus_rel <- genus_long %>%
  left_join(sample_total, by = "sample_id") %>%
  filter(total_abundance > 0) %>%
  mutate(
    rel_abundance = abundance / total_abundance * 100
  )

continent_genus_mean <- genus_rel %>%
  group_by(continent_CN, genus) %>%
  summarise(
    mean_relative_abundance = mean(rel_abundance, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    genus_cn = to_cn(genus, genus_cn_map)
  )

all_genera <- sort(unique(continent_genus_mean$genus))

continent_genus_mean_full <- expand.grid(
  continent_CN = continent_order_cn,
  genus = all_genera,
  stringsAsFactors = FALSE
) %>%
  left_join(
    continent_genus_mean %>%
      select(continent_CN, genus, genus_cn, mean_relative_abundance),
    by = c("continent_CN", "genus")
  ) %>%
  mutate(
    mean_relative_abundance = ifelse(
      is.na(mean_relative_abundance),
      0,
      mean_relative_abundance
    ),
    genus_cn = ifelse(
      is.na(genus_cn),
      to_cn(genus, genus_cn_map),
      genus_cn
    )
  )

write_csv(continent_genus_mean_full, out_all_genus_mean)

## =========================
## 10. 筛选 Top20 属
## =========================
message("筛选 Top20 优势属 ...")

top20_genus <- continent_genus_mean_full %>%
  group_by(genus, genus_cn) %>%
  summarise(
    sum_mean_relative_abundance = sum(mean_relative_abundance, na.rm = TRUE),
    mean_of_continent_means = mean(mean_relative_abundance, na.rm = TRUE),
    max_mean_relative_abundance = max(mean_relative_abundance, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(desc(sum_mean_relative_abundance), genus) %>%
  slice_head(n = top_n_genus)

write_csv(top20_genus, out_top20_list)

top_genus_order_en <- top20_genus$genus
top_genus_order_cn <- top20_genus$genus_cn

untranslated <- top20_genus %>%
  filter(genus == genus_cn) %>%
  select(genus, genus_cn, sum_mean_relative_abundance)

write_csv(untranslated, out_untranslated)

## =========================
## 11. 构建弦图矩阵：大洲 × Top20 属
## =========================
message("构建弦图矩阵 ...")

chord_df <- continent_genus_mean_full %>%
  filter(genus %in% top_genus_order_en) %>%
  mutate(
    continent_CN = factor(continent_CN, levels = continent_order_cn),
    genus = factor(genus, levels = top_genus_order_en),
    genus_cn = factor(genus_cn, levels = top_genus_order_cn)
  ) %>%
  arrange(continent_CN, genus)

mat_wide <- chord_df %>%
  select(continent_CN, genus_cn, mean_relative_abundance) %>%
  tidyr::pivot_wider(
    names_from = genus_cn,
    values_from = mean_relative_abundance,
    values_fill = 0
  ) %>%
  arrange(factor(continent_CN, levels = continent_order_cn))

mat <- as.matrix(mat_wide[, setdiff(colnames(mat_wide), "continent_CN"), drop = FALSE])
rownames(mat) <- as.character(mat_wide$continent_CN)
storage.mode(mat) <- "numeric"
mat[is.na(mat)] <- 0

mat_out <- as.data.frame(mat, check.names = FALSE)
mat_out <- cbind("大洲" = rownames(mat), mat_out)
write_csv_base(mat_out, out_chord_matrix)

mat_plot <- mat
mat_plot[mat_plot < min_link_value] <- 0

mat_plot <- mat_plot[rowSums(mat_plot) > 0, , drop = FALSE]
mat_plot <- mat_plot[, colSums(mat_plot) > 0, drop = FALSE]

continent_order_plot_cn <- rownames(mat_plot)
genus_order_plot_cn <- colnames(mat_plot)

mat_plot_out <- as.data.frame(mat_plot, check.names = FALSE)
mat_plot_out <- cbind("大洲" = rownames(mat_plot), mat_plot_out)
write_csv_base(mat_plot_out, out_chord_matrix_minlink)

if (nrow(mat_plot) < 2 || ncol(mat_plot) < 2) {
  stop("min_link_value 过滤后可绘制的大洲或属过少，请降低 min_link_value。")
}

## =========================
## 12. 属侧来源组成表
## =========================
genus_source_prop <- apply(mat_plot, 2, function(x) {
  if (sum(x) == 0) {
    rep(0, length(x))
  } else {
    x / sum(x)
  }
})

genus_source_prop <- as.matrix(genus_source_prop)
rownames(genus_source_prop) <- rownames(mat_plot)

source_out <- as.data.frame(t(genus_source_prop), check.names = FALSE)
source_out <- cbind("属" = rownames(source_out), source_out)
write_csv_base(source_out, out_source_composition)

## =========================
## 13. 弦图函数
## =========================
plot_chord_cn_radial <- function(outfile, type = c("png", "pdf")) {
  type <- match.arg(type)

  if (type == "png") {
    png(
      outfile,
      width = 12.5,
      height = 12.5,
      units = "in",
      res = 600,
      bg = "white",
      type = "cairo"
    )
  } else {
    cairo_pdf(
      outfile,
      width = 12.5,
      height = 12.5,
      family = cn_font,
      bg = "white"
    )
  }

  par(family = cn_font)

  circos.clear()

  genus_colors <- setNames(
    rep(genus_base_cols, length.out = length(genus_order_plot_cn)),
    genus_order_plot_cn
  )

  grid_cols <- c(
    genus_colors[genus_order_plot_cn],
    continent_colors[continent_order_plot_cn]
  )

  link_col_mat <- matrix(
    NA,
    nrow = nrow(mat_plot),
    ncol = ncol(mat_plot)
  )

  rownames(link_col_mat) <- rownames(mat_plot)
  colnames(link_col_mat) <- colnames(mat_plot)

  for (g in genus_order_plot_cn) {
    link_col_mat[, g] <- circlize::add_transparency(
      genus_colors[g],
      transparency = 0.45
    )
  }

  n_continent <- length(continent_order_plot_cn)
  n_genus <- length(genus_order_plot_cn)

  sector_order <- c(genus_order_plot_cn, continent_order_plot_cn)

  gap_after <- c(
    rep(1.4, n_genus - 1),
    18,
    rep(4.2, n_continent - 1),
    18
  )

  circos.par(
    start.degree = 92,
    gap.after = gap_after,
    track.margin = c(0.002, 0.002),
    cell.padding = c(0, 0, 0, 0),
    canvas.xlim = c(-1.55, 1.55),
    canvas.ylim = c(-1.55, 1.55),
    points.overflow.warning = FALSE
  )

  chordDiagram(
    x = mat_plot,
    order = sector_order,
    grid.col = grid_cols,
    col = link_col_mat,
    transparency = 0,
    directional = 0,
    annotationTrack = c("grid"),
    annotationTrackHeight = 0.038,
    preAllocateTracks = list(
      list(track.height = 0.160),
      list(track.height = 0.032)
    )
  )

  circos.trackPlotRegion(
    track.index = 1,
    ylim = c(0, 1),
    bg.border = NA,
    panel.fun = function(x, y) {
      sector <- get.cell.meta.data("sector.index")
      xlim <- get.cell.meta.data("xlim")
      xrange <- xlim[2] - xlim[1]

      axis_h <- 0.08

      at <- nice_axis_at(
        sector,
        xlim[2],
        drop_sectors = character(0)
      )

      circos.lines(
        x = c(xlim[1], xlim[2]),
        y = c(axis_h, axis_h),
        col = "grey30",
        lwd = 0.50
      )

      if (!is.null(at) && length(at) >= 2) {
        circos.axis(
          h = axis_h,
          major.at = at,
          labels = FALSE,
          major.tick.length = mm_y(0.45),
          col = "grey30",
          minor.ticks = 0,
          direction = "outside"
        )

        labs <- nice_axis_lab(at)

        for (ii in seq_along(at)) {
          xx <- at[ii]

          if (abs(xx - xlim[1]) < 1e-8) {
            xx2 <- xlim[1] + 0.020 * xrange
          } else if (abs(xx - xlim[2]) < 1e-8) {
            xx2 <- xlim[2] - 0.030 * xrange
          } else {
            xx2 <- xx
          }

          circos.text(
            x = xx2,
            y = 0.18,
            labels = labs[ii],
            facing = "clockwise",
            niceFacing = TRUE,
            adj = c(0.5, 0.5),
            cex = 0.44,
            col = "grey25"
          )
        }
      }

      if (sector %in% continent_order_plot_cn) {
        circos.text(
          x = mean(xlim),
          y = 0.58,
          labels = sector,
          facing = "clockwise",
          niceFacing = TRUE,
          adj = c(0, 0.5),
          cex = 1.18,
          font = 2,
          col = "black"
        )
      } else {
        circos.text(
          x = mean(xlim),
          y = 0.56,
          labels = sector,
          facing = "clockwise",
          niceFacing = TRUE,
          adj = c(0, 0.5),
          cex = 0.78,
          font = 1,
          col = "black"
        )
      }
    }
  )

  circos.trackPlotRegion(
    track.index = 2,
    ylim = c(0, 1),
    bg.border = NA,
    panel.fun = function(x, y) {
      sector <- get.cell.meta.data("sector.index")
      xlim <- get.cell.meta.data("xlim")

      if (sector %in% genus_order_plot_cn) {
        prop <- genus_source_prop[, sector]
        prop <- prop[continent_order_plot_cn]
        prop[is.na(prop)] <- 0

        if (sum(prop) > 0) {
          start <- xlim[1]
          total_width <- diff(xlim)

          for (ct in names(prop)) {
            w <- total_width * prop[ct]

            if (!is.na(w) && w > 0) {
              circos.rect(
                start,
                0,
                start + w,
                1,
                col = continent_colors[ct],
                border = NA
              )
              start <- start + w
            }
          }
        }
      }
    }
  )

  dev.off()
  circos.clear()
}

