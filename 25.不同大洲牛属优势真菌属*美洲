## =========================
## 14. 弦图函数：严格参考第三章最终径向标签版
## =========================
plot_chord_cn_radial <- function(outfile, type = c("png", "pdf")) {
  type <- match.arg(type)

  if (type == "png") {
    png(
      outfile,
      width = 11.5,
      height = 11.5,
      units = "in",
      res = 600,
      bg = "white",
      type = "cairo"
    )
  } else {
    cairo_pdf(
      outfile,
      width = 11.5,
      height = 11.5,
      family = cn_font,
      bg = "white"
    )
  }

  par(family = cn_font)

  circos.clear()

  genus_colors <- setNames(
    rep(genus_base_cols, length.out = length(genus_order_plot_cn)),
    genus_order_plot_cn
  )

  grid_cols <- c(
    genus_colors[genus_order_plot_cn],
    continent_colors[continent_order_plot_cn]
  )

  link_col_mat <- matrix(
    NA,
    nrow = nrow(mat_plot),
    ncol = ncol(mat_plot)
  )

  rownames(link_col_mat) <- rownames(mat_plot)
  colnames(link_col_mat) <- colnames(mat_plot)

  for (g in genus_order_plot_cn) {
    link_col_mat[, g] <- circlize::add_transparency(
      genus_colors[g],
      transparency = 0.45
    )
  }

  n_continent <- length(continent_order_plot_cn)
  n_genus <- length(genus_order_plot_cn)

  ## 关键：先属，后大洲，沿用第三章最终图样式
  sector_order <- c(genus_order_plot_cn, continent_order_plot_cn)

  gap_after <- c(
    rep(1.4, n_genus - 1),
    18,
    rep(4, n_continent - 1),
    18
  )

  circos.par(
    start.degree = 92,
    gap.after = gap_after,
    track.margin = c(0.002, 0.002),
    cell.padding = c(0, 0, 0, 0),
    canvas.xlim = c(-1.36, 1.36),
    canvas.ylim = c(-1.36, 1.36),
    points.overflow.warning = FALSE
  )

  chordDiagram(
    x = mat_plot,
    order = sector_order,
    grid.col = grid_cols,
    col = link_col_mat,
    transparency = 0,
    directional = 0,
    annotationTrack = c("grid"),
    annotationTrackHeight = 0.035,
    preAllocateTracks = list(
      list(track.height = 0.135),
      list(track.height = 0.030)
    )
  )

  ## Track 1: 刻度 + 标签
  circos.trackPlotRegion(
    track.index = 1,
    ylim = c(0, 1),
    bg.border = NA,
    panel.fun = function(x, y) {
      sector <- get.cell.meta.data("sector.index")
      xlim <- get.cell.meta.data("xlim")
      xrange <- xlim[2] - xlim[1]

      axis_h <- 0.08
      at <- nice_axis_at(
        sector,
        xlim[2],
        drop_sectors = character(0)
      )

      circos.lines(
        x = c(xlim[1], xlim[2]),
        y = c(axis_h, axis_h),
        col = "grey30",
        lwd = 0.45
      )

      if (!is.null(at) && length(at) >= 2) {
        circos.axis(
          h = axis_h,
          major.at = at,
          labels = FALSE,
          major.tick.length = mm_y(0.42),
          col = "grey30",
          minor.ticks = 0,
          direction = "outside"
        )

        labs <- nice_axis_lab(at)

        for (ii in seq_along(at)) {
          xx <- at[ii]

          ## 端点数字略向扇区内部移动，避免裁剪
          if (abs(xx - xlim[1]) < 1e-8) {
            xx2 <- xlim[1] + 0.018 * xrange
          } else if (abs(xx - xlim[2]) < 1e-8) {
            xx2 <- xlim[2] - 0.028 * xrange
          } else {
            xx2 <- xx
          }

          circos.text(
            x = xx2,
            y = 0.18,
            labels = labs[ii],
            facing = "clockwise",
            niceFacing = TRUE,
            adj = c(0.5, 0.5),
            cex = 0.34,
            col = "grey25"
          )
        }
      }

      ## 关键：大洲名和属名使用同一种文字方向
      if (sector %in% continent_order_plot_cn) {
        circos.text(
          x = mean(xlim),
          y = 0.56,
          labels = sector,
          facing = "clockwise",
          niceFacing = TRUE,
          adj = c(0, 0.5),
          cex = 0.92,
          font = 2,
          col = "black"
        )
      } else {
        circos.text(
          x = mean(xlim),
          y = 0.54,
          labels = sector,
          facing = "clockwise",
          niceFacing = TRUE,
          adj = c(0, 0.5),
          cex = 0.64,
          font = 1,
          col = "black"
        )
      }
    }
  )

  ## Track 2: 属扇区内侧大洲贡献组成条
  circos.trackPlotRegion(
    track.index = 2,
    ylim = c(0, 1),
    bg.border = NA,
    panel.fun = function(x, y) {
      sector <- get.cell.meta.data("sector.index")
      xlim <- get.cell.meta.data("xlim")

      if (sector %in% genus_order_plot_cn) {
        prop <- genus_source_prop[, sector]
        prop <- prop[continent_order_plot_cn]
        prop[is.na(prop)] <- 0

        if (sum(prop) > 0) {
          start <- xlim[1]
          total_width <- diff(xlim)

          for (ct in names(prop)) {
            w <- total_width * prop[ct]

            if (!is.na(w) && w > 0) {
              circos.rect(
                start,
                0,
                start + w,
                1,
                col = continent_colors[ct],
                border = NA
              )
              start <- start + w
            }
          }
        }
      }
    }
  )

  dev.off()
  circos.clear()
}

