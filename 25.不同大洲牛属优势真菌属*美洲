# 4. 读取 Bos metadata
# =========================
meta <- read_csv(metadata_file, show_col_types = FALSE) %>%
  filter(continent_CN %in% continent_order_cn) %>%
  distinct(sample_id, .keep_all=TRUE)

# =========================
# 5. 读取属水平丰度表
# =========================
genus_tab <- read.delim(genus_table_file, sep="\t", check.names = FALSE, comment.char = "")

tax_col <- colnames(genus_tab)[1]
genus_long <- genus_tab %>%
  rename(genus = all_of(tax_col)) %>%
  pivot_longer(cols=-genus, names_to="sample_id", values_to="abundance") %>%
  mutate(abundance = as.numeric(abundance)) %>%
