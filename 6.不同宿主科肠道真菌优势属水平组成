  pivot_wider(
    names_from = genus,
    values_from = mean_rel_abundance,
    values_fill = 0
  ) %>%
  arrange(host_family)

mat_df$host_family <- as.character(mat_df$host_family)
mat_df <- mat_df[match(family_order, mat_df$host_family), , drop = FALSE]

mat <- as.matrix(mat_df[, top_genera, drop = FALSE])
rownames(mat) <- mat_df$host_family

storage.mode(mat) <- "numeric"
mat[is.na(mat)] <- 0

write.csv(
  as.data.frame(mat) %>% rownames_to_column("host_family"),
  file.path(out_dir, "host_family_top20_genus_chord_matrix_no_elephant.csv"),
  row.names = FALSE
)

mat_plot <- mat
mat_plot[mat_plot < min_link_value] <- 0
mat_plot <- mat_plot[, colSums(mat_plot) > 0, drop = FALSE]
mat_plot <- mat_plot[rowSums(mat_plot) > 0, , drop = FALSE]

genus_order <- colnames(mat_plot)
family_order_plot <- rownames(mat_plot)

genus_source_prop <- apply(mat_plot, 2, function(x) {
  if (sum(x) == 0) {
    rep(0, length(x))
  } else {
    x / sum(x)
  }
})
genus_source_prop <- as.matrix(genus_source_prop)
rownames(genus_source_prop) <- rownames(mat_plot)

write.csv(
  as.data.frame(t(genus_source_prop)) %>% rownames_to_column("genus"),
  file.path(out_dir, "host_family_top20_genus_source_composition_for_chord_no_elephant.csv"),
