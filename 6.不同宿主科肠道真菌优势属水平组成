## =========================
## 2. 参数
## =========================
top_n_genus <- 20

## 过滤极小连接，仅用于作图；原始矩阵仍完整输出
min_link_value <- 0.001

family_order <- c(
  "Bovidae",
  "Suidae",
  "Equidae",
  "Cervidae",
  "Rhinocerotidae"
)

family_colors <- c(
  Bovidae = "#D8AA00",
  Suidae = "#E41A1C",
  Equidae = "#00BFC4",
  Cervidae = "#2CA02C",
  Rhinocerotidae = "#619CFF"
)

genus_base_cols <- c(
  "#8DD3C7", "#FFFFB3", "#BEBADA", "#FB8072", "#80B1D3",
  "#FDB462", "#B3DE69", "#FCCDE5", "#D9D9D9", "#BC80BD",
  "#CCEBC5", "#FFED6F", "#A6CEE3", "#1F78B4", "#B2DF8A",
  "#33A02C", "#FB9A99", "#E31A1C", "#FDBF6F", "#FF7F00"
)

## 这些扇区删除倒数第二个刻度，避免与最大值重叠
drop_penultimate_tick_sectors <- c(
  "Equidae", "Cervidae", "Rhinocerotidae",
  "Thelebolus", "Ascochyta"
)

## =========================
## 3. 工具函数
## =========================
clean_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c(
    "", "NA", "N/A", "na", "n/a",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded",
    "not_reported", "not reported",
    "not applicable", "Not applicable",
    "unknown", "Unknown", "UNKNOWN"
  )] <- NA
  x
}

pick_col <- function(candidates, cols, label) {
  hit <- candidates[candidates %in% cols][1]
  if (is.na(hit)) {
    stop(
      "Cannot find column for ", label,
      ". Tried: ", paste(candidates, collapse = ", "),
      "\nExisting columns:\n", paste(cols, collapse = ", ")
    )
  }
  hit
}

clean_genus <- function(x) {
  x <- trimws(as.character(x))
  x <- sub("^.*g__", "g__", x)
  x <- sub("^g__", "", x)
  x <- sub("^Genus__", "", x)
  x[x == "" | is.na(x)] <- "Unassigned"
  x[x %in% c("NA", "N/A", "na", "n/a", "unknown", "Unknown")] <- "Unassigned"
  x
}

fmt_tick <- function(x) {
  ifelse(abs(x - round(x)) < 1e-6, as.character(round(x)), sprintf("%.1f", x))
}

nice_axis_at <- function(sector, xmax) {
  if (is.na(xmax) || xmax <= 0) return(NULL)

  if (xmax > 20) {
    at <- seq(0, floor(xmax / 20) * 20, by = 20)
    if (length(at) == 0) at <- 0
    if (abs(max(at) - xmax) > 1e-6) {
      at <- c(at, xmax)
    }
  } else if (xmax >= 15) {
    at <- c(0, 10, xmax)
  } else {
    at <- c(0, xmax)
  }

  at <- at[at >= 0 & at <= xmax]
  at <- unique(round(at, 6))

  if (sector %in% drop_penultimate_tick_sectors && length(at) >= 3) {
    at <- at[-(length(at) - 1)]
  }

  at
}

nice_axis_lab <- function(at) {
  if (is.null(at) || length(at) == 0) return(character(0))
  fmt_tick(at)
}

## =========================
## 4. 读取 metadata
## =========================
meta <- read.csv(
  metadata_file,
  check.names = FALSE,
  stringsAsFactors = FALSE
)

sample_col <- pick_col(
  c("sampleid", "sample_id", "#SampleID", "SampleID", "sample", "Run", "run"),
  colnames(meta),
