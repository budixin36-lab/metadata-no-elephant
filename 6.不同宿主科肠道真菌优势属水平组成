  sample_id = clean_value(meta[[sample_col]]),
  host_family = clean_value(meta[[family_col]]),
  stringsAsFactors = FALSE
)

meta2 <- meta2[complete.cases(meta2), ]
meta2 <- meta2[!duplicated(meta2$sample_id), ]
meta2 <- meta2 %>%
  filter(host_family %in% family_order) %>%
