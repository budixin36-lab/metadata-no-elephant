## 8. 弦图绘制函数
## =========================
plot_chord <- function(outfile, type = c("png", "pdf")) {
  type <- match.arg(type)

  if (type == "png") {
    png(outfile, width = 10, height = 10, units = "in", res = 600, bg = "white")
  } else {
    pdf(outfile, width = 10, height = 10, bg = "white")
  }

  circos.clear()

  genus_colors <- setNames(
    rep(genus_base_cols, length.out = length(genus_order)),
    genus_order
  )

  grid_cols <- c(
    family_colors[family_order_plot],
    genus_colors[genus_order]
  )

  ## 弦按真菌属上色
  link_col_mat <- matrix(NA, nrow = nrow(mat_plot), ncol = ncol(mat_plot))
  rownames(link_col_mat) <- rownames(mat_plot)
  colnames(link_col_mat) <- colnames(mat_plot)

  for (g in genus_order) {
    link_col_mat[, g] <- circlize::add_transparency(genus_colors[g], transparency = 0.45)
  }

  n_family <- length(family_order_plot)
  n_genus <- length(genus_order)

  ## 宿主科放下半圈，属放上半圈
  sector_order <- c(genus_order, family_order_plot)

  gap_after <- c(
    rep(1.4, n_genus - 1),
    18,
    rep(4, n_family - 1),
    18
  )

  circos.par(
    start.degree = 92,
    gap.after = gap_after,
    track.margin = c(0.002, 0.002),
    cell.padding = c(0, 0, 0, 0),
    canvas.xlim = c(-1.26, 1.26),
    canvas.ylim = c(-1.26, 1.26),
    points.overflow.warning = FALSE
  )

  chordDiagram(
    x = mat_plot,
    order = sector_order,
    grid.col = grid_cols,
    col = link_col_mat,
    transparency = 0,
    directional = 0,
    annotationTrack = c("grid"),
    annotationTrackHeight = 0.035,
    preAllocateTracks = list(
      list(track.height = 0.145),  ## track 1: 标签和刻度
      list(track.height = 0.030)   ## track 2: 属侧来源组成条
    )
  )

  ## Track 1: 刻度 + 标签
  circos.trackPlotRegion(
    track.index = 1,
    ylim = c(0, 1),
    bg.border = NA,
    panel.fun = function(x, y) {
      sector <- get.cell.meta.data("sector.index")
      xlim <- get.cell.meta.data("xlim")

      ## 外圈刻度，位置贴近扇区
      axis_h <- 0.22
      at <- nice_axis_at(xlim[2])

      circos.lines(
        x = c(xlim[1], xlim[2]),
        y = c(axis_h, axis_h),
        col = "grey30",
        lwd = 0.45
      )

      if (!is.null(at) && length(at) >= 2) {
        circos.axis(
          h = axis_h,
          major.at = at,
          labels = nice_axis_lab(at),
          labels.cex = 0.31,
          major.tick.length = mm_y(0.55),
          labels.niceFacing = TRUE,
          col = "grey30",
          labels.col = "grey30",
          minor.ticks = 0,
          direction = "outside"
        )
      }

      ## 标签尽量靠近外圈刻度
      if (sector %in% family_order_plot) {
        circos.text(
          x = mean(xlim),
          y = 0.57,
          labels = sector,
          facing = "clockwise",
          niceFacing = TRUE,
          adj = c(0, 0.5),
          cex = 0.68,
          font = 2,
          col = "black"
        )
      } else {
        circos.text(
          x = mean(xlim),
          y = 0.54,
          labels = sector,
          facing = "clockwise",
          niceFacing = TRUE,
          adj = c(0, 0.5),
          cex = 0.46,
          font = 1,
          col = "black"
        )
      }
    }
  )

  ## Track 2: 属扇区内侧宿主科贡献组成条
  circos.trackPlotRegion(
    track.index = 2,
    ylim = c(0, 1),
    bg.border = NA,
    panel.fun = function(x, y) {
      sector <- get.cell.meta.data("sector.index")
      xlim <- get.cell.meta.data("xlim")

      if (sector %in% genus_order) {
        prop <- genus_source_prop[, sector]
        prop <- prop[prop > 0]

        if (length(prop) > 0) {
          start <- xlim[1]
          total_width <- diff(xlim)

          for (fam in names(prop)) {
            w <- total_width * prop[fam]
            circos.rect(
              start,
              0,
              start + w,
              1,
              col = family_colors[fam],
              border = NA
            )
            start <- start + w
          }
        }
      }
    }
  )

  dev.off()
  circos.clear()
}

