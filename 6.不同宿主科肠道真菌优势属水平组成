  stop("genus_abundance_table.tsv 列数异常，至少应为2列。")
}

colnames(genus_tab)[1] <- "genus"
genus_tab$genus <- clean_genus(genus_tab$genus)

sample_cols <- setdiff(colnames(genus_tab), "genus")

for (cc in sample_cols) {
  genus_tab[[cc]] <- suppressWarnings(as.numeric(as.character(genus_tab[[cc]])))
}
genus_tab[is.na(genus_tab)] <- 0

genus_tab <- genus_tab %>%
  group_by(genus) %>%
  summarise(across(all_of(sample_cols), ~ sum(.x, na.rm = TRUE)), .groups = "drop")

genus_long <- genus_tab %>%
  pivot_longer(
    cols = -genus,
    names_to = "sample_id",
    values_to = "abundance"
  ) %>%
  mutate(
    sample_id = as.character(sample_id),
    abundance = suppressWarnings(as.numeric(abundance))
  ) %>%
  filter(!is.na(abundance))

## =========================
## 6. 对齐样本并转相对多度
## =========================
common_samples <- intersect(meta2$sample_id, unique(genus_long$sample_id))

if (length(common_samples) == 0) {
  stop("metadata 与 genus 表没有匹配到共同样本。")
}

meta2 <- meta2 %>% filter(sample_id %in% common_samples)
genus_long <- genus_long %>% filter(sample_id %in% common_samples)

sample_total <- genus_long %>%
  group_by(sample_id) %>%
  summarise(total_abundance = sum(abundance, na.rm = TRUE), .groups = "drop")

valid_samples <- sample_total$sample_id[sample_total$total_abundance > 0]

meta2 <- meta2 %>% filter(sample_id %in% valid_samples)
genus_long <- genus_long %>% filter(sample_id %in% valid_samples)

genus_rel <- genus_long %>%
  group_by(sample_id) %>%
  mutate(total_abundance = sum(abundance, na.rm = TRUE)) %>%
  ungroup() %>%
  mutate(
    rel_abundance = ifelse(total_abundance > 0, abundance / total_abundance * 100, 0)
  ) %>%
  left_join(meta2, by = "sample_id") %>%
  filter(!is.na(host_family))

cat("Matched valid samples:", length(unique(genus_rel$sample_id)), "\n")
cat("Matched host family samples:\n")
print(table(genus_rel %>% distinct(sample_id, host_family) %>% pull(host_family)))

## =========================
## 7. 计算宿主科 × 属平均相对多度
## =========================
family_genus_mean_all <- genus_rel %>%
  group_by(host_family, genus) %>%
  summarise(
    mean_rel_abundance = mean(rel_abundance, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  complete(
    host_family = family_order,
    genus,
    fill = list(mean_rel_abundance = 0)
  ) %>%
  mutate(
    host_family = factor(host_family, levels = family_order)
  )

genus_rank <- family_genus_mean_all %>%
  group_by(genus) %>%
  summarise(
    overall_mean_rel_abundance = mean(mean_rel_abundance, na.rm = TRUE),
    max_family_mean_rel_abundance = max(mean_rel_abundance, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(desc(overall_mean_rel_abundance), genus)

top_genera <- genus_rank %>%
  filter(genus != "Unassigned") %>%
  slice_head(n = top_n_genus) %>%
  pull(genus)

write.csv(
  genus_rank,
  file.path(out_dir, "host_family_all_genus_rank_by_mean_relative_abundance_no_elephant.csv"),
  row.names = FALSE
)

top_summary <- genus_rank %>%
  filter(genus %in% top_genera) %>%
  mutate(top20_order = match(genus, top_genera)) %>%
  arrange(top20_order)

write.csv(
  top_summary,
  file.path(out_dir, "host_family_top20_genus_summary_no_elephant.csv"),
  row.names = FALSE
)

mean_top20 <- family_genus_mean_all %>%
  filter(genus %in% top_genera) %>%
  mutate(
    host_family = factor(host_family, levels = family_order),
    genus = factor(genus, levels = top_genera)
  )

write.csv(
  mean_top20,
  file.path(out_dir, "host_family_top20_genus_mean_relative_abundance_long_no_elephant.csv"),
  row.names = FALSE
)

