python3 - <<'PY'
from pathlib import Path
import re

script = Path("/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/scripts/06_host_family_top20_genus_chord_no_elephant.R")
txt = script.read_text(encoding="utf-8")

# 1. 画布再稍放大，避免外圈文字被裁剪
txt = txt.replace(
    'canvas.xlim = c(-1.30, 1.30),\n    canvas.ylim = c(-1.30, 1.30),',
    'canvas.xlim = c(-1.42, 1.42),\n    canvas.ylim = c(-1.42, 1.42),'
)

txt = txt.replace(
    'canvas.xlim = c(-1.24, 1.24),\n    canvas.ylim = c(-1.24, 1.24),',
    'canvas.xlim = c(-1.42, 1.42),\n    canvas.ylim = c(-1.42, 1.42),'
)

# 2. 外圈track稍加高，给刻度数字和标签留空间
txt = txt.replace(
    'list(track.height = 0.125),\n      list(track.height = 0.030)',
    'list(track.height = 0.165),\n      list(track.height = 0.030)'
)

txt = txt.replace(
    'list(track.height = 0.115),\n      list(track.height = 0.030)',
    'list(track.height = 0.165),\n      list(track.height = 0.030)'
)

# 3. 替换 Track 1：刻度 + 标签 整段
pattern = re.compile(
    r'  ## Track 1: 刻度 \+ 标签\n  circos\.trackPlotRegion\(\n    track\.index = 1,.*?\n  \)\n\n  ## Track 2: 属扇区内侧宿主科贡献组成条',
    re.S
)

new_block = r'''  ## Track 1: 刻度 + 标签
  circos.trackPlotRegion(
    track.index = 1,
    ylim = c(0, 1),
    bg.border = NA,
    panel.fun = function(x, y) {
      sector <- get.cell.meta.data("sector.index")
      xlim <- get.cell.meta.data("xlim")
      xrange <- xlim[2] - xlim[1]

      ## 刻度线靠近外圈彩条
      axis_h <- 0.065
      at <- nice_axis_at(sector, xlim[2])

      ## 画完整轴线
      circos.lines(
        x = c(xlim[1], xlim[2]),
        y = c(axis_h, axis_h),
        col = "grey30",
        lwd = 0.45
      )

      if (!is.null(at) && length(at) >= 2) {
        ## 只让 circos.axis 画刻度，不让它自动写数字；
        ## 数字改为下面手动写，避免最大值消失。
        circos.axis(
          h = axis_h,
          major.at = at,
          labels = FALSE,
          major.tick.length = mm_y(0.42),
          col = "grey30",
          minor.ticks = 0,
          direction = "outside"
        )

        labs <- nice_axis_lab(at)

        for (ii in seq_along(at)) {
          xx <- at[ii]

          ## 端点数字稍微往扇区内部挪，避免被裁掉
          if (abs(xx - xlim[1]) < 1e-8) {
            xx2 <- xlim[1] + 0.018 * xrange
          } else if (abs(xx - xlim[2]) < 1e-8) {
            xx2 <- xlim[2] - 0.028 * xrange
          } else {
            xx2 <- xx
          }

          circos.text(
            x = xx2,
            y = 0.185,
            labels = labs[ii],
            facing = "clockwise",
            niceFacing = TRUE,
            adj = c(0.5, 0.5),
            cex = 0.34,
            col = "grey25"
          )
        }
      }

      ## 标签再稍调大；同时放到刻度数字外侧，避免重叠
      if (sector %in% family_order_plot) {
        circos.text(
          x = mean(xlim),
          y = 0.62,
          labels = sector,
          facing = "clockwise",
          niceFacing = TRUE,
          adj = c(0, 0.5),
          cex = 0.76,
          font = 2,
          col = "black"
        )
      } else {
        circos.text(
          x = mean(xlim),
          y = 0.58,
          labels = sector,
          facing = "clockwise",
          niceFacing = TRUE,
          adj = c(0, 0.5),
          cex = 0.56,
          font = 1,
          col = "black"
        )
      }
    }
  )

  ## Track 2: 属扇区内侧宿主科贡献组成条'''

new_txt, n = pattern.subn(new_block, txt)

if n != 1:
    raise SystemExit("没有成功定位到 Track 1 部分，请检查脚本是否和上一版一致。")

script.write_text(new_txt, encoding="utf-8")
print("已修复最大刻度值显示，并放大宿主科名和真菌属名：", script)
PY
