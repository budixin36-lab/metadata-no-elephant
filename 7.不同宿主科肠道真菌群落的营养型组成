normalize_name <- function(x) {
  x <- as.character(x)
  x <- gsub("^.*__", "", x)
  x <- gsub("_", " ", x)
  x <- gsub("\\s+", " ", x)
  x <- trimws(x)

  ## 统一 sp / spp 写法
  x <- gsub("\\bsp\\.?$", "sp.", x, ignore.case = TRUE)
  x <- gsub("\\bspp\\.?$", "sp.", x, ignore.case = TRUE)

  x <- tolower(x)

  bad <- c(
    "", "na", "n/a", "unknown", "unidentified", "uncultured",
    "unclassified", "incertae sedis", "fungi sp.", "fungus",
    "no blast hit"
  )

  x[x %in% bad] <- NA_character_
  x
}

clean_rank_value <- function(x) {
  x <- as.character(x)
  x <- gsub("^.*__", "", x)
  x <- gsub("_", " ", x)
  x <- gsub("\\s+", " ", x)
  x <- trimws(x)
  x[x %in% c("", "NA", "na", "unidentified", "uncultured", "unclassified")] <- NA_character_
  x
}

get_id_col <- function(dt) {
  nms <- names(dt)
  cand <- c("SH_ID", "FeatureID", "#OTU ID", "OTU ID", "featureid", "feature_id", "SH", "id", "ID")
  hit <- cand[cand %in% nms]
  if (length(hit) > 0) return(hit[1])
  return(nms[1])
}

extract_genus_species_from_taxonomy_string <- function(tax_vec) {
  genus <- rep(NA_character_, length(tax_vec))
  species <- rep(NA_character_, length(tax_vec))

  parts_list <- strsplit(as.character(tax_vec), ";", fixed = TRUE)

  for (i in seq_along(parts_list)) {
    parts <- trimws(parts_list[[i]])

    g_hit <- parts[grepl("^g__", parts)]
    s_hit <- parts[grepl("^s__", parts)]

    if (length(g_hit) > 0) genus[i] <- clean_rank_value(g_hit[1])
    if (length(s_hit) > 0) species[i] <- clean_rank_value(s_hit[1])

    ## 如果 species 只有种加词，补上 genus
    if (!is.na(species[i]) && !is.na(genus[i])) {
      sp_words <- strsplit(species[i], "\\s+")[[1]]
      if (length(sp_words) == 1) {
        species[i] <- paste(genus[i], species[i])
      }
    }
  }

  data.frame(
    genus = normalize_name(genus),
    species = normalize_name(species),
    stringsAsFactors = FALSE
  )
}

