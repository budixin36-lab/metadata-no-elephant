sh_anno <- sh_anno %>%
  mutate(
    match_method = case_when(
      !is.na(trophic_species) ~ "species",
      is.na(trophic_species) & !is.na(trophic_genus) ~ "genus_fallback",
      TRUE ~ "unmatched"
    ),
    trophic_mode_raw = case_when(
      !is.na(trophic_species) ~ trophic_species,
      is.na(trophic_species) & !is.na(trophic_genus) ~ trophic_genus,
      TRUE ~ NA_character_
    ),
    trophic_mode_cn = translate_trophic(trophic_mode_raw),
    trophic_mode_cn = ifelse(is.na(trophic_mode_cn), "未分类", trophic_mode_cn)
  )

write.table(
  sh_anno,
  file = assign_tsv,
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)

cat("SH 匹配方法统计：\n")
print(table(sh_anno$match_method, useNA = "ifany"))

cat("SH 营养型匹配结果：\n")
print(table(sh_anno$trophic_mode_cn, useNA = "ifany"))

match_summary <- sh_anno %>%
  count(match_method, trophic_mode_cn, name = "SH_number") %>%
  arrange(match_method, trophic_mode_cn)

write.csv(match_summary, match_summary_csv, row.names = FALSE)

## 如果仍然全部未分类，直接报错，避免继续输出误导图
if (all(sh_anno$trophic_mode_cn == "未分类")) {
  stop("所有 SH 都被归为未分类。请检查 FungalTraits speciesMatched 与 taxonomy species/genus 格式。")
}

## =========================
## 8. 在样本内汇总营养型丰度，并转为相对多度
## =========================
cat("\n按营养型汇总样本内丰度 ...\n")

sh_anno <- sh_anno[match(rownames(abund_mat), sh_anno$SH), ]

group_vec <- factor(sh_anno$trophic_mode_cn, levels = trophic_order)

mode_count_mat <- rowsum(
  abund_mat,
  group = group_vec,
  reorder = FALSE
)

missing_modes <- setdiff(trophic_order, rownames(mode_count_mat))

if (length(missing_modes) > 0) {
  add_mat <- matrix(
    0,
    nrow = length(missing_modes),
    ncol = ncol(mode_count_mat),
    dimnames = list(missing_modes, colnames(mode_count_mat))
  )
  mode_count_mat <- rbind(mode_count_mat, add_mat)
}

mode_count_mat <- mode_count_mat[trophic_order, , drop = FALSE]

sample_total <- colSums(mode_count_mat, na.rm = TRUE)

if (any(sample_total == 0)) {
  stop("存在营养型汇总后总丰度为0的样本。")
}

mode_rel_mat <- sweep(mode_count_mat, 2, sample_total, "/") * 100

sample_rel_df <- as.data.frame(t(mode_rel_mat), check.names = FALSE)
sample_rel_df$SampleID <- rownames(sample_rel_df)

sample_rel_df <- sample_rel_df %>%
  left_join(meta_use, by = "SampleID") %>%
  select(SampleID, host_family, all_of(trophic_order))

write.csv(sample_rel_df, file = sample_csv, row.names = FALSE)

## =========================
## 9. 宿主科水平：平均相对多度
## =========================
cat("\n计算宿主科平均相对多度 ...\n")

family_mean_df <- sample_rel_df %>%
  group_by(host_family) %>%
  summarise(
    across(all_of(trophic_order), ~ mean(.x, na.rm = TRUE)),
    .groups = "drop"
  ) %>%
  mutate(host_family = factor(host_family, levels = host_family_order)) %>%
  arrange(host_family)

write.csv(family_mean_df, file = summary_csv, row.names = FALSE)

cat("宿主科平均相对多度合计检查：\n")
print(
  family_mean_df %>%
    mutate(total = rowSums(across(all_of(trophic_order)))) %>%
    select(host_family, total)
)

plot_df <- family_mean_df %>%
  pivot_longer(
    cols = all_of(trophic_order),
    names_to = "TrophicMode",
    values_to = "MeanRelativeAbundance"
  ) %>%
  mutate(
    host_family = factor(host_family, levels = host_family_order),
    TrophicMode = factor(TrophicMode, levels = trophic_order)
  )

## =========================
## 10. 绘图
## =========================
cat("\n绘图 ...\n")

p <- ggplot(
  plot_df,
  aes(
    x = host_family,
    y = MeanRelativeAbundance,
    fill = TrophicMode
  )
) +
  geom_col(
    width = 0.72,
    color = "grey35",
    linewidth = 0.18
  ) +
  scale_fill_manual(
    values = trophic_colors,
    breaks = trophic_order,
    name = "营养型",
    drop = FALSE
  ) +
  scale_y_continuous(
    breaks = seq(0, 100, 20),
    expand = expansion(mult = c(0, 0.01))
  ) +
  coord_cartesian(
    ylim = c(0, 100),
    clip = "off"
  ) +
  labs(
    x = NULL,
    y = "平均相对多度（%）"
  ) +
  theme_classic(base_size = 15) +
  theme(
    panel.grid = element_blank(),
    panel.background = element_rect(fill = "white", colour = NA),
    plot.background = element_rect(fill = "white", colour = NA),
    axis.line = element_line(color = "black", linewidth = 0.8),
    axis.ticks = element_line(color = "black", linewidth = 0.8),
    axis.ticks.length = unit(0.20, "cm"),
    axis.text.x = element_text(size = 13, angle = 0, hjust = 0.5, vjust = 0.5, colour = "black"),
    axis.text.y = element_text(size = 13, colour = "black"),
    axis.title.y = element_text(size = 17, colour = "black"),
    legend.title = element_text(size = 15, colour = "black"),
    legend.text = element_text(size = 12, colour = "black"),
    legend.key.size = unit(0.45, "cm"),
    legend.background = element_rect(fill = "white", colour = NA),
    legend.key = element_rect(fill = "white", colour = NA),
    legend.position = "right",
    plot.margin = margin(t = 10, r = 10, b = 10, l = 10)
  )

ggsave(
  plot_png,
  plot = p,
  width = 10.5,
  height = 7.2,
  dpi = 600,
  bg = "white"
)

ggsave(
  plot_pdf,
  plot = p,
  width = 10.5,
  height = 7.2,
  bg = "white"
)

