parse_comparison <- function(x) {
  parts <- strsplit(x, "-", fixed = TRUE)[[1]]
  if (length(parts) != 2) return(c(NA_character_, NA_character_))
  parts
}

plot_alpha_box <- function(alpha_df, metric, anova_df, tukey_sig_df, out_file) {
  dat <- alpha_df %>%
    select(status_CN, value = all_of(metric)) %>%
    filter(!is.na(status_CN), !is.na(value))

  dat$status_CN <- factor(dat$status_CN, levels = status_order)

  p_raw <- anova_df %>%
    filter(metric == !!metric) %>%
    pull(P_value_raw)

  p_label <- anova_df %>%
    filter(metric == !!metric) %>%
    pull(P_value_for_paper)

  if (length(p_label) == 0) p_label <- NA_character_

  sig_pairs <- tukey_sig_df %>%
    filter(metric == !!metric) %>%
    mutate(
      g1 = vapply(comparison, function(z) parse_comparison(z)[1], character(1)),
      g2 = vapply(comparison, function(z) parse_comparison(z)[2], character(1)),
      label = significance
    ) %>%
    filter(
      !is.na(g1),
      !is.na(g2),
      g1 %in% status_order,
      g2 %in% status_order,
      label %in% c("*", "**", "***")
    )

  y_min <- min(dat$value, na.rm = TRUE)
  y_max <- max(dat$value, na.rm = TRUE)
  y_range <- y_max - y_min

  if (!is.finite(y_range) || y_range == 0) {
    y_range <- max(abs(y_max), 1)
  }

  base_y <- y_max + 0.08 * y_range
  step_y <- 0.12 * y_range

  if (nrow(sig_pairs) > 0) {
    sig_pairs <- sig_pairs %>%
      mutate(
        x1 = match(g1, status_order),
        x2 = match(g2, status_order),
        y = base_y + (row_number() - 1) * step_y,
        y_text = y + 0.025 * y_range
      )
    y_top <- max(sig_pairs$y_text, na.rm = TRUE) + 0.08 * y_range
  } else {
    y_top <- y_max + 0.25 * y_range
  }

  p_text <- paste0("ANOVA: P = ", p_label)

  p <- ggplot(
    dat,
    aes(
      x = status_CN,
      y = value,
      fill = status_CN
    )
  ) +
    geom_boxplot(
      width = 0.58,
      outlier.shape = NA,
      linewidth = 0.55,
      color = "black"
    ) +
    scale_fill_manual(
      values = status_colors,
      drop = FALSE
    ) +
    coord_cartesian(
      ylim = c(y_min, y_top),
      clip = "off"
    ) +
    labs(
      x = NULL,
      y = metric_y_labels[[metric]]
    ) +
    theme_classic(base_family = "songti") +
    theme(
      axis.title.y = element_text(
        size = 12,
        family = "songti",
        colour = "black"
      ),
      axis.text.x = element_text(
        size = 11,
        family = "songti",
        colour = "black"
      ),
      axis.text.y = element_text(
        size = 10,
        family = "songti",
        colour = "black"
      ),
      axis.line = element_line(
        linewidth = 0.55,
        colour = "black"
      ),
      axis.ticks = element_line(
        linewidth = 0.55,
        colour = "black"
      ),
      legend.position = "none",
      plot.margin = margin(t = 8, r = 8, b = 6, l = 8)
    ) +
    annotate(
      "text",
      x = 2.55,
      y = y_top - 0.06 * y_range,
      label = p_text,
      hjust = 1,
      vjust = 1,
      family = "songti",
      size = 3.4
    )

  if (nrow(sig_pairs) > 0) {
    for (i in seq_len(nrow(sig_pairs))) {
      p <- p +
        annotate(
          "segment",
