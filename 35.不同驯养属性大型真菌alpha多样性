## =========================
## 4. 工具函数
## =========================

format_anova_label <- function(p) {
  if (is.na(p)) return("ANOVA: P = NA")

  if (p < 0.001) {
    return("ANOVA: P < 0.001")
  }

  paste0("ANOVA: P = ", sprintf("%.4f", p))
}

parse_comparison <- function(x) {
  parts <- strsplit(x, "-", fixed = TRUE)[[1]]
  if (length(parts) != 2) return(c(NA_character_, NA_character_))
  parts
}

plot_alpha_box_v2 <- function(alpha_df, metric, anova_df, tukey_sig_df, out_file) {
  dat <- alpha_df %>%
    select(status_CN, value = all_of(metric)) %>%
    filter(!is.na(status_CN), !is.na(value))

  dat$status_CN <- factor(dat$status_CN, levels = status_order)

  p_raw <- anova_df %>%
    filter(metric == !!metric) %>%
    pull(P_value_raw)

  if (length(p_raw) == 0) {
    p_raw <- NA_real_
  }

  p_text <- format_anova_label(p_raw[1])

  sig_pairs <- tukey_sig_df %>%
    filter(metric == !!metric) %>%
    mutate(
      g1 = vapply(comparison, function(z) parse_comparison(z)[1], character(1)),
      g2 = vapply(comparison, function(z) parse_comparison(z)[2], character(1)),
      label = significance
    ) %>%
    filter(
      !is.na(g1),
      !is.na(g2),
      g1 %in% status_order,
      g2 %in% status_order,
      label %in% c("*", "**", "***")
    )

  y_min <- min(dat$value, na.rm = TRUE)
  y_max <- max(dat$value, na.rm = TRUE)
  y_range <- y_max - y_min

  if (!is.finite(y_range) || y_range == 0) {
    y_range <- max(abs(y_max), 1)
  }

  ## 给显著性线和 ANOVA 文本预留空间
  base_y <- y_max + 0.10 * y_range
  step_y <- 0.105 * y_range

  if (nrow(sig_pairs) > 0) {
    sig_pairs <- sig_pairs %>%
      mutate(
        x1 = match(g1, status_order),
        x2 = match(g2, status_order),
        y = base_y + (row_number() - 1) * step_y,
        y_text = y + 0.025 * y_range
      )

    y_top <- max(sig_pairs$y_text, na.rm = TRUE) + 0.12 * y_range
  } else {
    y_top <- y_max + 0.25 * y_range
  }

  ## ANOVA 文本放左上方，低于显著性线区域，避免重叠
  anova_y <- y_top - 0.08 * y_range

  p <- ggplot(
    dat,
    aes(
      x = status_CN,
      y = value,
      fill = status_CN
    )
  ) +
    geom_boxplot(
      width = 0.54,
      outlier.shape = NA,
      linewidth = 0.38,
      color = "black"
    ) +
    scale_fill_manual(
      values = status_colors,
      drop = FALSE
    ) +
    coord_cartesian(
      ylim = c(y_min, y_top),
      clip = "off"
    ) +
    labs(
      x = NULL,
      y = metric_y_labels[[metric]]
    ) +
    theme_classic(base_family = "songti") +
    theme(
      axis.title.y = element_text(
        size = 9.5,
        family = "songti",
        colour = "black"
      ),
      axis.text.x = element_text(
        size = 9,
        family = "songti",
        colour = "black"
      ),
      axis.text.y = element_text(
        size = 8.5,
        family = "songti",
        colour = "black"
      ),
      axis.line = element_line(
        linewidth = 0.40,
        colour = "black"
      ),
      axis.ticks = element_line(
        linewidth = 0.40,
        colour = "black"
      ),
      legend.position = "none",
      plot.margin = margin(t = 7, r = 6, b = 5, l = 6)
    ) +
    annotate(
      "text",
      x = 0.72,
      y = anova_y,
      label = p_text,
      hjust = 0,
      vjust = 1,
      family = "songti",
      size = 2.7
    )

  if (nrow(sig_pairs) > 0) {
    for (i in seq_len(nrow(sig_pairs))) {
      p <- p +
        annotate(
          "segment",
          x = sig_pairs$x1[i],
          xend = sig_pairs$x2[i],
          y = sig_pairs$y[i],
          yend = sig_pairs$y[i],
          linewidth = 0.32
        ) +
        annotate(
          "segment",
          x = sig_pairs$x1[i],
          xend = sig_pairs$x1[i],
          y = sig_pairs$y[i] - 0.020 * y_range,
          yend = sig_pairs$y[i],
          linewidth = 0.32
        ) +
        annotate(
          "segment",
          x = sig_pairs$x2[i],
          xend = sig_pairs$x2[i],
          y = sig_pairs$y[i] - 0.020 * y_range,
          yend = sig_pairs$y[i],
          linewidth = 0.32
        ) +
        annotate(
          "text",
          x = mean(c(sig_pairs$x1[i], sig_pairs$x2[i])),
          y = sig_pairs$y_text[i],
          label = sig_pairs$label[i],
          family = "songti",
          size = 3.2
        )
    }
  }

  ggsave(
    filename = out_file,
    plot = p,
    width = 7.1,
    height = 5.2,
    units = "cm",
    dpi = 600,
    bg = "white"
  )

  ggsave(
    filename = sub("\\.png$", ".pdf", out_file),
    plot = p,
    width = 7.1,
    height = 5.2,
    units = "cm",
    bg = "white"
  )
}

