  x <- stringr::str_replace_all(x, fixed("Animal Parasite"), "动物寄生菌")
  x <- stringr::str_replace_all(x, fixed("Plant Pathogen"), "植物病原菌")
  x <- stringr::str_replace_all(x, fixed("Plant Saprotroph"), "植物腐生菌")
  x <- stringr::str_replace_all(x, fixed("Undefined Saprotroph"), "未定义腐生菌")
  x <- stringr::str_replace_all(x, fixed("Wood Saprotroph"), "木材腐生菌")
