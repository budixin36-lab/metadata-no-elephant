  x <- stringr::str_replace_all(x, fixed("Litter Saprotroph"), "凋落物腐生菌")
  x <- stringr::str_replace_all(x, fixed("Soil Saprotroph"), "土壤腐生菌")
  x <- stringr::str_replace_all(x, fixed("Endophyte"), "内生菌")
