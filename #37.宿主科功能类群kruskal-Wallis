## 功能类群名称按 "-" 分段换行，每行 2 个功能词
wrap_by_hyphen_keep_hyphen <- function(x, terms_per_line = 2) {
  x <- as.character(x)

  vapply(x, function(one) {
    if (is.na(one) || one == "") return(one)

    parts <- unlist(strsplit(one, "-", fixed = TRUE))
    parts <- trimws(parts)
    parts <- parts[parts != ""]

    if (length(parts) <= terms_per_line) {
      return(paste(parts, collapse = "-"))
    }

    groups <- split(parts, ceiling(seq_along(parts) / terms_per_line))
    lines <- vapply(groups, function(g) paste(g, collapse = "-"), character(1))

    if (length(lines) >= 2) {
      lines[-length(lines)] <- paste0(lines[-length(lines)], "-")
    }

    paste(lines, collapse = "\n")
  }, character(1))
}

save_plot_cairo <- function(p, png_file, pdf_file, width_mm, height_mm, dpi = 600) {
  width_cm <- width_mm / 10
  height_cm <- height_mm / 10

  if (isTRUE(capabilities("cairo"))) {
