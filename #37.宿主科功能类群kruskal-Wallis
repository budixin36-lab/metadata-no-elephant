      filename = png_file,
      width = width_cm,
      height = height_cm,
      units = "cm",
      res = dpi,
      type = "cairo",
      bg = "white"
    )
  } else {
    grDevices::png(
      filename = png_file,
      width = width_cm,
      height = height_cm,
      units = "cm",
      res = dpi,
      bg = "white"
    )
  }
  print(p)
  grDevices::dev.off()

  if (isTRUE(capabilities("cairo"))) {
    grDevices::cairo_pdf(
      filename = pdf_file,
      width = width_mm / 25.4,
      height = height_mm / 25.4,
      bg = "white"
    )
  } else {
    grDevices::pdf(
      file = pdf_file,
      width = width_mm / 25.4,
      height = height_mm / 25.4,
      bg = "white"
    )
  }
  print(p)
  grDevices::dev.off()
}

