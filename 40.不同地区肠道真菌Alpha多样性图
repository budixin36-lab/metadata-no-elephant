plot_alpha_box_letters <- function(alpha_df, letters_df, anova_df, metric, out_png, group_order) {

  dat <- alpha_df %>%
    select(continent_CN, value = all_of(metric)) %>%
    filter(!is.na(continent_CN), !is.na(value), continent_CN %in% group_order)

  dat$continent_CN <- factor(dat$continent_CN, levels = group_order)

  letter_dat <- letters_df %>%
    select(group, letter = all_of(metric)) %>%
    rename(continent_CN = group) %>%
    filter(continent_CN %in% group_order)

  letter_dat$continent_CN <- factor(letter_dat$continent_CN, levels = group_order)

  letter_pos_df <- dat %>%
    group_by(continent_CN) %>%
    summarise(
      upper_whisker = get_upper_whisker(value),
      .groups = "drop"
    ) %>%
    left_join(letter_dat, by = "continent_CN") %>%
    arrange(continent_CN)

  y_min <- min(dat$value, na.rm = TRUE)
  y_max <- max(dat$value, na.rm = TRUE)
  y_range <- y_max - y_min

  if (!is.finite(y_range) || y_range == 0) {
    y_range <- max(abs(y_max), 1)
  }

  letter_pos_df <- letter_pos_df %>%
    mutate(
      letter_y = upper_whisker + 0.05 * y_range
    )

  max_letter_y <- max(letter_pos_df$letter_y, na.rm = TRUE)

  anova_p <- anova_df %>%
    filter(metric == !!metric) %>%
    pull(P_value_raw)

  anova_label <- format_anova_label(anova_p[1])

  ## 根据箱线图最高字母位置自动上移，避免重叠
  anova_y <- max_letter_y + 0.14 * y_range
  y_top <- anova_y + 0.10 * y_range

  p <- ggplot(
    dat,
    aes(
      x = continent_CN,
      y = value,
      fill = continent_CN
    )
  ) +
    geom_boxplot(
      width = 0.56,
      outlier.shape = NA,
      linewidth = 0.40,
      color = "black"
    ) +
    geom_text(
      data = letter_pos_df,
      aes(
        x = continent_CN,
        y = letter_y,
        label = letter
      ),
      family = "songti",
      size = 3.3,
      vjust = 0,
      inherit.aes = FALSE
    ) +
    scale_fill_manual(
      values = continent_colors,
      drop = FALSE
    ) +
    coord_cartesian(
      ylim = c(y_min, y_top),
      clip = "off"
    ) +
    labs(
      x = NULL,
      y = metric_y_labels[[metric]]
    ) +
    theme_classic(base_family = "songti") +
    theme(
      axis.title.y = element_text(
        size = 10.5,
        family = "songti",
        colour = "black"
      ),
      axis.text.x = element_text(
        size = 10,
        family = "songti",
        colour = "black"
      ),
      axis.text.y = element_text(
        size = 9,
        family = "songti",
        colour = "black"
      ),
      axis.line = element_line(
        linewidth = 0.40,
        colour = "black"
      ),
      axis.ticks = element_line(
        linewidth = 0.40,
        colour = "black"
      ),
      legend.position = "none",
      plot.margin = margin(t = 8, r = 8, b = 6, l = 8)
    ) +
    annotate(
      "text",
      x = 0.60,
      y = anova_y,
      label = anova_label,
      hjust = 0,
      vjust = 1,
      family = "songti",
      size = 2.8
    )

  ggsave(
    filename = out_png,
    plot = p,
    width = 7.1,
    height = 5.2,
    units = "cm",
    dpi = 600,
    bg = "white"
  )

  ggsave(
    filename = sub("\\.png$", ".pdf", out_png),
    plot = p,
    width = 7.1,
    height = 5.2,
    units = "cm",
    bg = "white"
  )
}

