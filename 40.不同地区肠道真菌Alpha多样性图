  fileEncoding = "UTF-8"
)

possible_sample_cols <- c(
  "sample_id", "SampleID", "sampleid", "sample_name", "id", "#SampleID"
)

sample_col <- possible_sample_cols[possible_sample_cols %in% colnames(meta)][1]

if (is.na(sample_col)) {
  stop("metadata 中没有找到样本 ID 列。")
}

if (!"continent" %in% colnames(meta)) {
  stop("metadata 中没有 continent 列。")
}

meta_continent <- meta %>%
  transmute(
    sample_id = as.character(.data[[sample_col]]),
    continent_original = clean_value(continent),
    continent_std = normalize_continent(continent_original),
    continent_CN = unname(continent_cn_map[continent_std])
  ) %>%
  filter(
    !is.na(sample_id),
    sample_id != "",
    !is.na(continent_CN)
  ) %>%
  distinct(sample_id, .keep_all = TRUE)

cat("metadata 中 continent 有效样本数：", nrow(meta_continent), "\n", sep = "")

## =========================
## 6. 读取样本水平 alpha 数据并合并 continent
## =========================

cat("\n读取样本水平 Alpha 多样性数据 ...\n")

alpha_df <- read.csv(
  alpha_file,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "UTF-8"
)

needed_alpha_cols <- c(
  "sample_id",
  metrics_all
)

missing_alpha_cols <- setdiff(needed_alpha_cols, colnames(alpha_df))

if (length(missing_alpha_cols) > 0) {
  stop("alpha 文件缺少列：", paste(missing_alpha_cols, collapse = ", "))
}

continent_alpha <- alpha_df %>%
  mutate(sample_id = as.character(sample_id)) %>%
  select(sample_id, all_of(metrics_all)) %>%
  inner_join(
    meta_continent %>% select(sample_id, continent_CN, continent_original, continent_std),
    by = "sample_id"
  ) %>%
  relocate(sample_id, continent_CN, continent_original, continent_std)

## 合并后按样本量从大到小排序
continent_sample_count <- continent_alpha %>%
  count(continent_CN, name = "n") %>%
  arrange(desc(n), continent_CN)

continent_order <- continent_sample_count$continent_CN

continent_alpha$continent_CN <- factor(continent_alpha$continent_CN, levels = continent_order)

continent_sample_count <- continent_sample_count %>%
  mutate(continent_CN = factor(continent_CN, levels = continent_order)) %>%
  arrange(continent_CN) %>%
  mutate(continent_CN = as.character(continent_CN))

cat("进入 continent Alpha 分析的样本数：", nrow(continent_alpha), "\n", sep = "")
cat("进入分析的 continent 样本数：\n")
print(continent_sample_count)
cat("continent 作图顺序（按样本量从大到小）：\n")
print(continent_order)

write.csv(
  continent_alpha,
  out_continent_alpha,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv(
  continent_sample_count,
  out_sample_count,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

## =========================
## 7. 统计检验与表格
## =========================

cat("\n进行 ANOVA + TukeyHSD ...\n")

continent_anova <- run_anova_table(
  continent_alpha,
  "continent_CN",
  metrics_for_table
)

continent_tukey_all <- run_tukey_table(
  continent_alpha,
  "continent_CN",
  metrics_for_table,
  only_significant = FALSE
)

continent_tukey_sig <- run_tukey_table(
  continent_alpha,
  "continent_CN",
  metrics_for_table,
  only_significant = TRUE
)

continent_mean_sd <- make_mean_sd_detail(
  continent_alpha,
  "continent_CN",
  metrics_all,
  group_order = continent_order
)

continent_paper_table <- make_paper_table(
  continent_alpha,
  "continent_CN",
  metrics_for_table,
  continent_anova,
  group_order = continent_order
)

write.csv(
  continent_paper_table,
  out_paper_table,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv(
  continent_mean_sd,
  out_mean_sd,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv(
  continent_anova,
  out_anova,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv(
  continent_tukey_all,
  out_tukey_all,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv(
  continent_tukey_sig,
  out_tukey_sig,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

