## =========================
## 9. 绘制四张箱线图
## =========================

cat("\n绘制 Alpha 多样性箱线图 ...\n")

letters_df <- continent_paper_table %>%
  filter(
    !is.na(group),
    group != "",
    !grepl("^ANOVA", group)
  ) %>%
  select(group, all_of(metrics_for_table))

for (m in metrics_for_table) {
  letters_df[[m]] <- stringr::str_extract(
    as.character(letters_df[[m]]),
    "[A-Za-z]+$"
  )
}

for (m in metrics_for_table) {
  plot_alpha_box_letters(
    alpha_df = continent_alpha,
    letters_df = letters_df,
    anova_df = continent_anova,
    metric = m,
    out_png = plot_files_png[[m]],
    group_order = continent_order
  )
