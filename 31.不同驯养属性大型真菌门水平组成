#!/usr/bin/env Rscript

############################################################
## Chapter 5 - Fig5-2 重画脚本 v2
##
## 目的：
##   不重算数据，只读取已有平均相对多度结果重画图。
##
## 修改：
##   1. 图例字号放大；
##   2. 柱子收窄；
##   3. 整张图宽度缩小；
##   4. 其他风格保持 Fig4-2 / Fig5-2 v1 一致。
############################################################

rm(list = ls())

options(stringsAsFactors = FALSE)
options(scipen = 999)

suppressPackageStartupMessages({
  library(ggplot2)
  library(dplyr)
  library(readr)
  library(showtext)
  library(sysfonts)
  library(grid)
})

## =========================
## 1. 路径
## =========================

base_dir <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant"

in_dir <- file.path(
  base_dir,
  "results",
  "chapter5_macrofungi_no_elephant",
  "status_macrofungi_phylum_composition_v1"
)

summary_csv <- file.path(
  in_dir,
  "status_macrofungi_phylum_mean_relative_abundance_no_elephant_CN.csv"
)

out_png <- file.path(
  in_dir,
  "Fig5_2_status_macrofungi_phylum_stacked_bar_no_elephant_CN_v2_narrow.png"
)

out_pdf <- file.path(
  in_dir,
  "Fig5_2_status_macrofungi_phylum_stacked_bar_no_elephant_CN_v2_narrow.pdf"
)

out_log <- file.path(
  in_dir,
  "Fig5_2_status_macrofungi_phylum_stacked_bar_no_elephant_CN_v2_narrow_log.txt"
)

if (!file.exists(summary_csv)) {
  stop("找不到输入文件：", summary_csv)
}

## =========================
## 2. 字体
## =========================

font_path <- "/mnt/c/Windows/Fonts/simsun.ttc"

if (!file.exists(font_path)) {
  stop("找不到宋体字体文件：", font_path)
}

font_add("songti", font_path)
showtext_auto()
showtext_opts(dpi = 600)

## =========================
## 3. 固定顺序与颜色
## =========================

status_order_cn <- c("家养", "野生", "圈养野生")

phylum_order_cn <- c(
  "子囊菌门",
  "担子菌门",
  "新靓鞭菌门",
  "真菌门分类地位未定类群",
  "毛霉门",
  "被孢霉门",
  "壶菌门",
  "罗兹菌门",
  "油壶菌门",
  "球囊霉门",
  "捕虫霉门",
  "远日菌门",
  "芽枝霉门",
  "蛙粪霉门",
  "梳霉门",
  "单毛菌门",
  "Sanchytriomycota",
  "根肿黑粉菌门",
  "小齿梗孢门"
)

phylum_colors <- c(
  "子囊菌门" = "#E64B35",
  "担子菌门" = "#4DB3CF",
  "新靓鞭菌门" = "#00A087",
  "真菌门分类地位未定类群" = "#E7906F",
  "毛霉门" = "#3C5488",
  "被孢霉门" = "#91D1C2",
  "壶菌门" = "#F00000",
  "罗兹菌门" = "#7E6148",
  "油壶菌门" = "#B09C85",
  "球囊霉门" = "#8491B4",
  "捕虫霉门" = "#00A6D6",
  "远日菌门" = "#B24745",
  "芽枝霉门" = "#6E40AA",
  "蛙粪霉门" = "#FF8C00",
  "梳霉门" = "#1F78B4",
  "单毛菌门" = "#33A02C",
  "Sanchytriomycota" = "#F08A8A",
  "根肿黑粉菌门" = "#9CCC65",
  "小齿梗孢门" = "#F0B35E"
)

## =========================
## 4. 读取已有平均相对多度结果
## =========================

plot_df <- read_csv(
  summary_csv,
  show_col_types = FALSE
)

needed_cols <- c("status_CN", "phylum_cn", "mean_relative_abundance")
missing_cols <- setdiff(needed_cols, colnames(plot_df))

if (length(missing_cols) > 0) {
  stop(
    "输入表缺少必要列：",
    paste(missing_cols, collapse = ", "),
    "\n当前列名：",
    paste(colnames(plot_df), collapse = " | ")
  )
}

present_phyla <- unique(as.character(plot_df$phylum_cn))
present_phyla <- phylum_order_cn[phylum_order_cn %in% present_phyla]

extra_phyla <- setdiff(unique(as.character(plot_df$phylum_cn)), present_phyla)
present_phyla <- c(present_phyla, sort(extra_phyla))

plot_df <- plot_df %>%
  mutate(
    status_CN = factor(status_CN, levels = status_order_cn),
    phylum_cn = factor(phylum_cn, levels = present_phyla)
  ) %>%
  arrange(status_CN, phylum_cn)

missing_color_phyla <- setdiff(present_phyla, names(phylum_colors))

if (length(missing_color_phyla) > 0) {
  auto_cols <- rep("#BDBDBD", length(missing_color_phyla))
  names(auto_cols) <- missing_color_phyla
  phylum_colors <- c(phylum_colors, auto_cols)
}

phylum_colors_use <- phylum_colors[present_phyla]

## =========================
## 5. 重画图
## =========================

p <- ggplot(
  plot_df,
  aes(
    x = status_CN,
    y = mean_relative_abundance,
    fill = phylum_cn
  )
) +
  geom_col(width = 0.58, color = NA) +
  scale_fill_manual(
    values = phylum_colors_use,
    drop = FALSE
  ) +
  scale_y_continuous(
    limits = c(0, 100),
    breaks = seq(0, 100, 20),
    expand = c(0, 0)
  ) +
  labs(
    x = NULL,
    y = "平均相对多度（%）"
  ) +
  theme_classic(base_size = 14, base_family = "songti") +
  theme(
    axis.title.y = element_text(
      size = 16,
      family = "songti",
      colour = "black"
    ),
    axis.text.x = element_text(
      size = 16,
      family = "songti",
      colour = "black"
    ),
    axis.text.y = element_text(
      size = 13,
      family = "songti",
      colour = "black"
    ),
    axis.line = element_line(
      linewidth = 0.6,
      colour = "black"
    ),
    axis.ticks = element_line(
      linewidth = 0.6,
      colour = "black"
    ),
    legend.title = element_blank(),
    legend.text = element_text(
      size = 13,
      family = "songti",
      colour = "black"
    ),
    legend.key.size = unit(0.50, "cm"),
    legend.position = "right",
    plot.margin = margin(t = 6, r = 6, b = 6, l = 6)
  )

ggsave(
  filename = out_png,
  plot = p,
  width = 6.8,
  height = 6,
  dpi = 600,
  bg = "white"
)

ggsave(
  filename = out_pdf,
  plot = p,
  width = 6.8,
  height = 6,
  bg = "white"
)

## =========================
## 6. log
## =========================

sink(out_log)

cat("Fig5-2 status macrofungi phylum stacked bar redraw v2\n")
cat("=====================================================\n\n")

cat("Input summary CSV:\n")
cat(summary_csv, "\n\n")

cat("No recomputation performed.\n")
cat("Only figure appearance was adjusted.\n\n")

cat("Changes:\n")
cat("geom_col width: 0.75 -> 0.58\n")
cat("legend.text size: 11.2 -> 13\n")
cat("legend.key.size: 0.42 cm -> 0.50 cm\n")
cat("figure width: 9 inch -> 6.8 inch\n")
cat("figure height: 6 inch unchanged\n\n")

cat("Output PNG:\n")
cat(out_png, "\n")
cat("Output PDF:\n")
cat(out_pdf, "\n")

sink()

message("完成！")
message("PNG: ", out_png)
message("PDF: ", out_pdf)
message("日志: ", out_log)
