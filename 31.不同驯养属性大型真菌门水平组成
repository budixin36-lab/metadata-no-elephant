## 16. 输出 log
## =========================

sink(log_file)

cat("Fig5-2 status macrofungi phylum stacked bar, no-elephant\n")
cat("==============================================================\n\n")

cat("Input files:\n")
cat("Metadata:", metadata_file, "\n")
cat("Macrofungi SH abundance table:", macrofungi_SH_abundance_file, "\n")
cat("Macrofungi SH taxonomy:", macrofungi_SH_taxonomy_file, "\n\n")

cat("Data version:\n")
cat("globalfungi_style_test_no_elephant only\n")
cat("No old elephant-containing version\n")
