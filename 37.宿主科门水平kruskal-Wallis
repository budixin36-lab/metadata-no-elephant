#本次不重算 phylum 相对多度、不重做 Kruskal-Wallis、不重做 Dunn’s test，只计算作图用的 SE 和筛选前 5 个门。
cd /mnt/d/ITS_SH_pipeline

cat > /mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/scripts/15_plot_phylum_top5_significant_host_family_barplot_meanSE_letters_no_elephant.R <<'EOF'
#!/usr/bin/env Rscript

options(stringsAsFactors = FALSE)
options(scipen = 999)

## ============================================================
## 不同宿主科肠道真菌显著差异优势门相对多度图
##
## 图形口径：
## 1. 不重算门水平相对多度；
## 2. 不重做 Kruskal-Wallis；
## 3. 不重做 Dunn's test；
## 4. 读取已有 group summary、letters、Kruskal-Wallis 结果；
## 5. 去除“真菌门分类地位未定类群”；
## 6. 只保留 Kruskal-Wallis BH 校正后显著的门；
## 7. 在显著门中按总体平均相对多度选前 5 个；
## 8. 柱高为 mean_relative_abundance；
## 9. 误差线为 mean ± SE；
## 10. 字母标注来自已有 Dunn's test BH 校正结果；
## 11. 图尺寸 190 × 70 mm，与功能类群差异图保持同一宽度，高度约一半。
## ============================================================

## -----------------------------
## 0. R包路径与依赖
## -----------------------------
RVER <- paste0(R.version$major, ".", strsplit(R.version$minor, "\\.")[[1]][1])
user_lib <- file.path(Sys.getenv("HOME"), "Rlibs", paste0("R-", RVER))

.libPaths(c(
  user_lib,
  "/mnt/d/Rlibs",
  "/usr/local/lib/R/site-library",
  "/usr/lib/R/site-library",
  "/usr/lib/R/library"
))

need_pkgs <- c(
  "dplyr", "readr", "stringr", "ggplot2",
  "showtext", "sysfonts", "grid"
)

for (pkg in need_pkgs) {
  if (!requireNamespace(pkg, quietly = TRUE)) {
    dir.create(user_lib, recursive = TRUE, showWarnings = FALSE)
    install.packages(pkg, lib = user_lib, repos = "https://cloud.r-project.org")
  }
}

suppressPackageStartupMessages({
  library(dplyr)
  library(readr)
  library(stringr)
  library(ggplot2)
  library(showtext)
  library(sysfonts)
  library(grid)
})

## -----------------------------
## 1. 输入输出路径
## -----------------------------
base_dir <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant"

in_dir <- file.path(
  base_dir,
  "results/chapter3_family_composition_no_elephant/statistics_Kruskal_Dunn_phylum"
)

group_summary_file <- file.path(
  in_dir,
  "Phylum_group_summary_host_family_no_elephant.csv"
)

letters_file <- file.path(
  in_dir,
  "Phylum_letters_host_family_no_elephant.csv"
)

kw_file <- file.path(
  in_dir,
  "Phylum_Kruskal_Wallis_host_family_no_elephant.csv"
)

out_dir <- file.path(in_dir, "figures")
dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)

out_png <- file.path(
  out_dir,
  "Phylum_top5_significant_host_family_barplot_meanSE_letters_190x70mm.png"
)

out_pdf <- file.path(
  out_dir,
  "Phylum_top5_significant_host_family_barplot_meanSE_letters_190x70mm.pdf"
)

out_plotdata_csv <- file.path(
  out_dir,
  "Phylum_top5_significant_host_family_barplot_meanSE_letters_190x70mm_plotdata.csv"
)

out_selected_csv <- file.path(
  out_dir,
  "Phylum_top5_significant_selected_phyla_190x70mm.csv"
)

for (f in c(group_summary_file, letters_file, kw_file)) {
  if (!file.exists(f)) stop("找不到输入文件：", f)
}

## -----------------------------
## 2. 字体设置
## -----------------------------
base_family <- "sans"

font_candidates <- c(
  "/mnt/c/Windows/Fonts/simsun.ttc",
  "/mnt/c/Windows/Fonts/simsun.ttf",
  "/mnt/c/Windows/Fonts/simhei.ttf",
  "/usr/share/fonts/truetype/wqy/wqy-microhei.ttc",
  "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
)

font_path <- font_candidates[file.exists(font_candidates)][1]

if (!is.na(font_path)) {
  sysfonts::font_add("CNfont", regular = font_path)
  base_family <- "CNfont"
}

showtext::showtext_auto(enable = TRUE)
showtext::showtext_opts(dpi = 600)

cat("使用字体：", base_family, "\n", sep = "")
cat("字体文件：", ifelse(is.na(font_path), "未找到宋体，使用默认字体", font_path), "\n", sep = "")

## -----------------------------
## 3. 参数
## -----------------------------
host_family_order_cn <- c("牛科", "猪科", "鹿科", "马科", "犀科")

family_colors <- c(
  "牛科" = "#E69F00",
  "猪科" = "#D55E00",
  "鹿科" = "#009E73",
  "马科" = "#56B4E9",
  "犀科" = "#CC79A7"
)

exclude_phyla <- c("真菌门分类地位未定类群")
top_n <- 5
alpha <- 0.05

## -----------------------------
## 4. 工具函数
## -----------------------------
save_plot_cairo <- function(p, png_file, pdf_file, width_mm, height_mm, dpi = 600) {
  width_cm <- width_mm / 10
  height_cm <- height_mm / 10

  if (isTRUE(capabilities("cairo"))) {
    grDevices::png(
      filename = png_file,
      width = width_cm,
      height = height_cm,
      units = "cm",
      res = dpi,
      type = "cairo",
      bg = "white"
    )
  } else {
    grDevices::png(
      filename = png_file,
      width = width_cm,
      height = height_cm,
      units = "cm",
      res = dpi,
      bg = "white"
    )
  }
  print(p)
  grDevices::dev.off()

  if (isTRUE(capabilities("cairo"))) {
    grDevices::cairo_pdf(
      filename = pdf_file,
      width = width_mm / 25.4,
      height = height_mm / 25.4,
      bg = "white"
    )
  } else {
    grDevices::pdf(
      file = pdf_file,
      width = width_mm / 25.4,
      height = height_mm / 25.4,
      bg = "white"
    )
  }
  print(p)
  grDevices::dev.off()
}

format_p <- function(p) {
  dplyr::case_when(
    is.na(p) ~ NA_character_,
    p < 0.001 ~ "<0.001",
    TRUE ~ sprintf("%.4f", p)
  )
}

## -----------------------------
## 5. 读取数据
## -----------------------------
group_df <- read.csv(
  group_summary_file,
  check.names = FALSE,
  stringsAsFactors = FALSE,
  fileEncoding = "UTF-8"
)

letters_df <- read.csv(
  letters_file,
  check.names = FALSE,
  stringsAsFactors = FALSE,
  fileEncoding = "UTF-8"
)

kw_df <- read.csv(
  kw_file,
  check.names = FALSE,
  stringsAsFactors = FALSE,
  fileEncoding = "UTF-8"
)

required_group_cols <- c(
  "phylum_cn", "host_family_cn", "n",
  "mean_relative_abundance", "sd_relative_abundance"
)

missing_group_cols <- setdiff(required_group_cols, colnames(group_df))
if (length(missing_group_cols) > 0) {
  stop("group summary 表缺少列：", paste(missing_group_cols, collapse = ", "))
}

required_letter_cols <- c("phylum_cn", "host_family_cn", "letter")
missing_letter_cols <- setdiff(required_letter_cols, colnames(letters_df))
if (length(missing_letter_cols) > 0) {
  stop("letters 表缺少列：", paste(missing_letter_cols, collapse = ", "))
}

required_kw_cols <- c("phylum_cn", "p_adj_BH_across_phyla")
missing_kw_cols <- setdiff(required_kw_cols, colnames(kw_df))
if (length(missing_kw_cols) > 0) {
  stop("Kruskal-Wallis 表缺少列：", paste(missing_kw_cols, collapse = ", "))
}

## -----------------------------
## 6. 筛选显著差异前5个门
## -----------------------------
overall_mean <- group_df %>%
  filter(!phylum_cn %in% exclude_phyla) %>%
  group_by(phylum_cn) %>%
  summarise(
    overall_mean_relative_abundance = mean(mean_relative_abundance, na.rm = TRUE),
    .groups = "drop"
  )

selected_phyla_df <- kw_df %>%
  filter(
    !phylum_cn %in% exclude_phyla,
    !is.na(p_adj_BH_across_phyla),
    p_adj_BH_across_phyla < alpha
  ) %>%
  left_join(overall_mean, by = "phylum_cn") %>%
  arrange(desc(overall_mean_relative_abundance)) %>%
  slice_head(n = top_n) %>%
  mutate(
    p_value_format = format_p(p_value),
    p_adj_BH_across_phyla_format = format_p(p_adj_BH_across_phyla)
  )

if (nrow(selected_phyla_df) == 0) {
  stop("没有筛选到 BH 校正后显著的门。")
}

selected_phyla <- selected_phyla_df$phylum_cn

write.csv(
  selected_phyla_df,
  out_selected_csv,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

cat("本次作图门类：\n")
print(selected_phyla_df %>%
  select(phylum_cn, overall_mean_relative_abundance, p_value_format, p_adj_BH_across_phyla_format))

## -----------------------------
## 7. 合并作图数据
## -----------------------------
plot_df <- group_df %>%
  filter(
    phylum_cn %in% selected_phyla,
    host_family_cn %in% host_family_order_cn
  ) %>%
  mutate(
    host_family_cn = as.character(host_family_cn)
  ) %>%
  left_join(
    letters_df %>%
      filter(phylum_cn %in% selected_phyla) %>%
      mutate(host_family_cn = as.character(host_family_cn)) %>%
      select(phylum_cn, host_family_cn, letter),
    by = c("phylum_cn", "host_family_cn")
  ) %>%
  left_join(
    kw_df %>%
      select(
        phylum_cn,
        kruskal_p_value = p_value,
        kruskal_p_adj_BH_across_phyla = p_adj_BH_across_phyla
      ),
    by = "phylum_cn"
  ) %>%
  mutate(
    se_relative_abundance = sd_relative_abundance / sqrt(n),
    phylum_cn = factor(phylum_cn, levels = rev(selected_phyla)),
    host_family_cn = factor(host_family_cn, levels = host_family_order_cn)
  ) %>%
  arrange(phylum_cn, host_family_cn)

## 为字母标注预留偏移量
max_x <- max(plot_df$mean_relative_abundance + plot_df$se_relative_abundance, na.rm = TRUE)
label_offset <- max_x * 0.025

plot_df <- plot_df %>%
  mutate(
    label_x = mean_relative_abundance + se_relative_abundance + label_offset,
    letter = ifelse(is.na(letter), "", letter)
  )

write.csv(
  plot_df,
  out_plotdata_csv,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

cat("\n作图数据加总/预览：\n")
print(plot_df %>% select(phylum_cn, host_family_cn, mean_relative_abundance, se_relative_abundance, letter) %>% head(20))

## -----------------------------
## 8. 作图
## -----------------------------
pd <- position_dodge(width = 0.78)

p <- ggplot(
  plot_df,
  aes(
    x = mean_relative_abundance,
    y = phylum_cn,
    fill = host_family_cn
  )
) +
  geom_col(
    position = pd,
    width = 0.68,
    color = "grey30",
    linewidth = 0.15
  ) +
  geom_errorbar(
    aes(
      xmin = pmax(mean_relative_abundance - se_relative_abundance, 0),
      xmax = mean_relative_abundance + se_relative_abundance
    ),
    position = pd,
    width = 0.18,
    linewidth = 0.4,
    color = "black"
  ) +
  geom_text(
    aes(
      x = label_x,
      y = phylum_cn,
      label = letter,
      group = host_family_cn
    ),
    position = pd,
    hjust = 0,
    size = 3.2,
    family = base_family,
    color = "black"
  ) +
  scale_fill_manual(
    values = family_colors,
    breaks = host_family_order_cn,
    drop = FALSE
  ) +
  scale_x_continuous(
    expand = expansion(mult = c(0, 0.16))
  ) +
  labs(
    x = "平均相对多度（%）",
    y = NULL,
    fill = NULL
  ) +
  theme_classic(base_size = 11, base_family = base_family) +
  theme(
    axis.line = element_line(color = "black", linewidth = 0.8),
    axis.ticks = element_line(color = "black", linewidth = 0.8),
    axis.ticks.length = unit(0.18, "cm"),
    axis.text.x = element_text(size = 10.5, color = "black", family = base_family),
    axis.text.y = element_text(size = 10.5, color = "black", family = base_family),
    axis.title.x = element_text(size = 11, color = "black", family = base_family),
    legend.position = "bottom",
    legend.direction = "horizontal",
    legend.title = element_blank(),
    legend.text = element_text(size = 10, color = "black", family = base_family),
    legend.key.size = unit(0.42, "cm"),
    legend.spacing.x = unit(0.20, "cm"),
    panel.background = element_rect(fill = "white", colour = NA),
    plot.background = element_rect(fill = "white", colour = NA),
    plot.margin = margin(5, 10, 5, 5)
  )

## -----------------------------
## 9. 输出
## -----------------------------
save_plot_cairo(
  p = p,
  png_file = out_png,
  pdf_file = out_pdf,
  width_mm = 190,
  height_mm = 70,
  dpi = 600
)

cat("\n完成！\n")
cat("PNG: ", out_png, "\n", sep = "")
cat("PDF: ", out_pdf, "\n", sep = "")
cat("plot data: ", out_plotdata_csv, "\n", sep = "")
cat("selected phyla: ", out_selected_csv, "\n", sep = "")
EOF

