    p_adj_BH_across_phyla_format = format_p(p_adj_BH_across_phyla),
    significance_raw = p_to_sig(p_value),
    significance_BH = p_to_sig(p_adj_BH_across_phyla),
    phylum_cn = factor(phylum_cn, levels = present_phyla)
  ) %>%
