get_padded_range <- function(x, padding = 0.06) {
  r <- range(x, na.rm = TRUE)
  d <- diff(r)

  if (is.na(d) || d == 0) {
    d <- max(abs(r), 1e-6)
  }

  c(
    lower = r[1] - padding * d,
    upper = r[2] + padding * d
  )
}

fmt_decimal <- function(x) {
  x[abs(x) < 1e-12] <- 0
  sprintf("%.5f", x)
}

format_p <- function(p) {
  if (length(p) == 0 || is.na(p)) return("NA")
  if (p < 0.001) return("<0.001")
  sprintf("%.3f", p)
}

extract_adonis_main_row <- function(adonis_df) {
  idx <- which(adonis_df$term == "continent_CN")

  if (length(idx) == 0) {
    idx <- which(!adonis_df$term %in% c("Residual", "Residuals", "Total"))
  }

  if (length(idx) == 0) {
    stop(
      "无法从 adonis 结果中识别模型项。term 为：",
      paste(adonis_df$term, collapse = ", ")
    )
  }

  idx[1]
}

