  ) +
  stat_ellipse(
    aes(group = continent_CN, color = continent_CN),
    type = "t",
    level = 0.95,
    linewidth = 0.80,
    show.legend = FALSE
  ) +
  geom_point(
    size = point_size,
    alpha = point_alpha
  ) +
  annotate(
    "text",
    x = x_anno,
    y = y_anno,
    label = adonis_label,
    hjust = 0,
    vjust = 1,
    size = 4.6,
    family = base_family,
