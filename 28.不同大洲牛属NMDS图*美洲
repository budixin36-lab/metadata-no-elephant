    "unknown", "Unknown", "UNKNOWN"
  )] <- NA_character_
  x
}

read_sh_table <- function(sh_table_file) {
  sh_lines <- readLines(sh_table_file, warn = FALSE)
  sh_lines <- sh_lines[nchar(trimws(sh_lines)) > 0]

  if (length(sh_lines) == 0) {
    stop("SH abundance table 为空。")
  }

  if (grepl("^# Constructed from biom file", sh_lines[1])) {
    sh_lines <- sh_lines[-1]
  }

  sh_raw <- read.delim(
    text = paste(sh_lines, collapse = "\n"),
    header = TRUE,
    sep = "\t",
    check.names = FALSE,
    stringsAsFactors = FALSE,
    quote = "",
    comment.char = ""
  )

  if (ncol(sh_raw) < 2) {
    stop("SH abundance table 列数异常。")
  }

  colnames(sh_raw)[1] <- "SH_ID"

  taxonomy_cols <- grep(
    "taxonomy|metadata",
    colnames(sh_raw),
    ignore.case = TRUE,
    value = TRUE
  )

  if (length(taxonomy_cols) > 0) {
    sh_raw <- sh_raw[, !colnames(sh_raw) %in% taxonomy_cols, drop = FALSE]
  }

  rownames(sh_raw) <- as.character(sh_raw$SH_ID)

  mat <- as.matrix(sh_raw[, -1, drop = FALSE])
  storage.mode(mat) <- "numeric"
  mat[is.na(mat)] <- 0

  mat
}

get_iqr_range <- function(x, k = 7) {
  q1 <- unname(quantile(x, 0.25, na.rm = TRUE))
  q3 <- unname(quantile(x, 0.75, na.rm = TRUE))
  iqr <- q3 - q1

  c(
    lower = q1 - k * iqr,
    upper = q3 + k * iqr
  )
}

get_padded_range <- function(x, padding = 0.06) {
  r <- range(x, na.rm = TRUE)
  d <- diff(r)

  if (is.na(d) || d == 0) {
    d <- max(abs(r), 1e-6)
  }

  c(
    lower = r[1] - padding * d,
    upper = r[2] + padding * d
  )
}

