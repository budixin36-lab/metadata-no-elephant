  ) +
  scale_fill_manual(
    values = continent_colors,
    breaks = continent_order,
    drop = FALSE,
    guide = "none"
  ) +
  scale_x_continuous(
    labels = fmt_decimal,
    expand = expansion(mult = c(0.04, 0.08))
  ) +
  scale_y_continuous(
    labels = fmt_decimal,
    expand = expansion(mult = c(0.05, 0.08))
  ) +
  labs(
    x = "NMDS1",
    y = "NMDS2",
    color = NULL,
    caption = stress_label
  ) +
  coord_cartesian(
    xlim = x_range,
    ylim = y_range,
    clip = "off"
  ) +
  theme_bw(base_size = 14, base_family = base_family) +
  theme(
    panel.grid = element_blank(),
    plot.title = element_blank(),
    axis.title = element_text(size = 19, colour = "black", family = base_family),
    axis.text = element_text(size = 13, colour = "black", family = base_family),
