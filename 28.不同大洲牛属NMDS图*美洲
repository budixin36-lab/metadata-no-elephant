write.csv(
  adonis_df,
  adonis_csv,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

main_idx <- extract_adonis_main_row(adonis_df)

adonis_r2 <- adonis_df$R2[main_idx]
adonis_p <- adonis_df$`Pr(>F)`[main_idx]

adonis_label <- paste0(
  "Adonis: R² = ",
  sprintf("%.3f", adonis_r2),
  ", P = ",
  format_p(adonis_p)
)

cat(adonis_label, "\n")

# =========================
# 10. betadisper
# =========================
cat("\n开始计算 betadisper ...\n")

bd <- vegan::betadisper(
  bray,
  group = meta_use$continent_CN
)

bd_anova <- as.data.frame(anova(bd)) %>%
  rownames_to_column("term")

bd_perm <- vegan::permutest(bd, permutations = 999)

bd_perm_df <- as.data.frame(bd_perm$tab) %>%
  rownames_to_column("term")

write.csv(
  bd_anova,
  betadisper_anova_csv,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv(
  bd_perm_df,
  betadisper_perm_csv,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

# =========================
# 11. 作图显示范围：IQR 识别极端点，按显示点范围放大主区域
# =========================
x_iqr_range <- get_iqr_range(nmds_scores$NMDS1, iqr_k)
y_iqr_range <- get_iqr_range(nmds_scores$NMDS2, iqr_k)

plot_flag <- nmds_scores$NMDS1 >= x_iqr_range["lower"] &
  nmds_scores$NMDS1 <= x_iqr_range["upper"] &
  nmds_scores$NMDS2 >= y_iqr_range["lower"] &
  nmds_scores$NMDS2 <= y_iqr_range["upper"]

display_df <- nmds_scores[plot_flag, , drop = FALSE]
outlier_df <- nmds_scores[!plot_flag, , drop = FALSE]

write.csv(
  display_df,
  display_csv,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv(
  outlier_df,
  outlier_csv,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

x_range <- get_padded_range(display_df$NMDS1, padding = axis_padding)
y_range <- get_padded_range(display_df$NMDS2, padding = axis_padding)

cat("\nNMDS 显示设置：\n")
cat("IQR k:", iqr_k, "\n")
cat("Displayed samples:", nrow(display_df), "\n")
cat("Outliers excluded from display only:", nrow(outlier_df), "\n")
cat("x display range:", x_range["lower"], "to", x_range["upper"], "\n")
cat("y display range:", y_range["lower"], "to", y_range["upper"], "\n")

# =========================
# 12. 作图
# =========================
stress_label <- paste0(
  "Bray-Curtis NMDS stress = ",
  sprintf("%.8f", nmds$stress)
)

x_anno <- x_range["lower"] + 0.05 * diff(x_range)
y_anno <- y_range["upper"] - 0.08 * diff(y_range)

p <- ggplot(
  display_df,
  aes(
    x = NMDS1,
    y = NMDS2,
    color = continent_CN
  )
) +
  stat_ellipse(
    aes(fill = continent_CN),
