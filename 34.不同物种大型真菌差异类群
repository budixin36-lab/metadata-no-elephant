#!/usr/bin/env Rscript

############################################################
## Chapter 5
## Make LEfSe input:
## host_species × food-derived macrofungi genus-level table
##
## 数据版本：
##   globalfungi_style_test_no_elephant
##
## 输入：
##   1. final no-elephant metadata
##   2. macrofungi_SH_abundance_table_for_status_venn.tsv
##   3. macrofungi_SH_taxonomy_matched_by_strict_genus.csv
##
## 输出：
##   LEfSe_input_macrofungi_genus_host_species_no_elephant.txt
##
## 注意：
##   本脚本只生成 LEfSe 输入文件；
##   不运行 LEfSe；
##   不画图；
##   不重新筛选大型真菌 SH；
##   不重新读取 BIOM；
##   不使用旧含象科版本。
############################################################

rm(list = ls())

options(stringsAsFactors = FALSE)
options(scipen = 999)

cat("============================================================\n")
cat("Make LEfSe input: host_species macrofungi genus no-elephant\n")
cat("============================================================\n\n")

## =========================
## 0. R 包路径与依赖检查
## =========================

RVER <- paste0(
  R.version$major,
  ".",
  strsplit(R.version$minor, "\\.")[[1]][1]
)

user_lib <- file.path(Sys.getenv("HOME"), "Rlibs", paste0("R-", RVER))

.libPaths(c(
  user_lib,
  "/mnt/d/Rlibs",
  "/usr/local/lib/R/site-library",
  "/usr/lib/R/site-library",
  "/usr/lib/R/library"
))

need_pkgs <- c(
  "dplyr",
  "tidyr",
  "readr",
  "tibble"
)

pkg_check <- data.frame(
  package = need_pkgs,
  installed = sapply(need_pkgs, requireNamespace, quietly = TRUE),
  stringsAsFactors = FALSE
)

cat("========== Package check ==========\n")
print(pkg_check)

if (any(!pkg_check$installed)) {
  cat("\n以下 R 包尚未安装，请先安装后再运行本脚本：\n")
  print(pkg_check$package[!pkg_check$installed])
  stop("Package check failed.")
}

suppressPackageStartupMessages({
  library(dplyr)
  library(tidyr)
  library(readr)
  library(tibble)
})

## =========================
## 1. 路径
## =========================

base_dir <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant"

metadata_file <- file.path(
  base_dir,
  "metadata",
  "metadata_valid_globalfungi_SH_nozero_no_elephant.csv"
)

macrofungi_status_dir <- file.path(
  base_dir,
  "results",
  "chapter5_macrofungi_no_elephant",
  "status_macrofungi_SH_venn_v1"
)

macrofungi_SH_abundance_file <- file.path(
  macrofungi_status_dir,
  "macrofungi_SH_abundance_table_for_status_venn.tsv"
)

macrofungi_SH_taxonomy_file <- file.path(
  macrofungi_status_dir,
  "macrofungi_SH_taxonomy_matched_by_strict_genus.csv"
)

out_dir <- file.path(
  base_dir,
  "results",
  "chapter5_macrofungi_no_elephant",
  "host_species_macrofungi_LEfSe_genus_v1"
)

dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)

out_input <- file.path(
  out_dir,
  "LEfSe_input_macrofungi_genus_host_species_no_elephant.txt"
)

summary_file <- file.path(
  out_dir,
  "LEfSe_input_host_species_macrofungi_generation_summary_no_elephant.txt"
)

mapping_file <- file.path(
  out_dir,
  "host_species_label_mapping_macrofungi_no_elephant.csv"
)

sample_count_file <- file.path(
  out_dir,
  "LEfSe_host_species_macrofungi_sample_count_no_elephant.csv"
)

feature_list_file <- file.path(
  out_dir,
  "LEfSe_host_species_macrofungi_genus_feature_list_no_elephant.csv"
)

zero_sample_file <- file.path(
  out_dir,
  "LEfSe_host_species_macrofungi_zero_samples_excluded_no_elephant.csv"
)

input_files <- data.frame(
  file_label = c(
    "metadata",
    "macrofungi_SH_abundance",
    "macrofungi_SH_taxonomy"
  ),
  file_path = c(
    metadata_file,
    macrofungi_SH_abundance_file,
    macrofungi_SH_taxonomy_file
  ),
  exists = file.exists(c(
    metadata_file,
    macrofungi_SH_abundance_file,
    macrofungi_SH_taxonomy_file
  )),
  stringsAsFactors = FALSE
)

cat("========== Input files ==========\n")
print(input_files)

if (any(!input_files$exists)) {
  cat("\n以下输入文件不存在，请检查路径：\n")
  print(input_files[!input_files$exists, ])
  stop("Input file check failed.")
}

cat("\nOutput directory:\n")
cat(out_dir, "\n\n")

## =========================
## 2. helper functions
## =========================

clean_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c(
    "",
    "NA", "N/A", "na", "n/a",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded",
    "not_reported", "not reported",
    "unknown", "Unknown", "UNKNOWN",
    "null", "NULL", "Null"
  )] <- NA_character_
  x
}

make_safe_label <- function(x) {
  x <- as.character(x)
  x <- trimws(x)
  x <- gsub("×", "x", x)
  x <- gsub("[[:space:]]+", "_", x)
  x <- gsub("[^A-Za-z0-9_]+", "_", x)
  x <- gsub("_+", "_", x)
  x <- gsub("^_|_$", "", x)
  x
}

clean_feature_name <- function(x) {
  x <- as.character(x)
  x <- trimws(x)
  x <- gsub("^g__", "", x)
  x <- gsub("^genus__", "", x)
  x <- gsub("\\|", "_", x)
  x <- gsub("[[:space:]]+", "_", x)
  x <- gsub("[^A-Za-z0-9_]+", "_", x)
  x <- gsub("_+", "_", x)
  x <- gsub("^_|_$", "", x)
  x
}

normalize_genus <- function(x) {
  x <- as.character(x)
  x <- trimws(x)
  x <- gsub("^g__", "", x, ignore.case = TRUE)
  x <- gsub("^genus__", "", x, ignore.case = TRUE)
  x <- gsub("^.*;\\s*g__", "", x, ignore.case = TRUE)
  x <- gsub("^.*;\\s*", "", x)
  x <- gsub("\\s+", " ", x)
  x <- trimws(x)
  x[x %in% c(
    "",
    "NA", "N/A", "na", "n/a",
    "unknown", "Unknown",
    "unclassified", "Unclassified",
    "unassigned", "Unassigned"
  )] <- NA_character_
  x
}

## =========================
## 3. metadata
## =========================

cat("读取 metadata ...\n")

meta <- read.csv(
  metadata_file,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "UTF-8"
)

needed_meta_cols <- c(
  "sampleid",
  "host_family",
  "host_species"
)

missing_meta_cols <- setdiff(needed_meta_cols, colnames(meta))

if (length(missing_meta_cols) > 0) {
  stop(
    "metadata 缺少必要列：",
    paste(missing_meta_cols, collapse = ", "),
    "\n当前列名为：",
    paste(colnames(meta), collapse = " | ")
  )
}

family_order <- c(
  "Bovidae",
  "Suidae",
  "Cervidae",
  "Equidae",
  "Rhinocerotidae"
)

meta2 <- meta %>%
  mutate(
    sample_id = clean_value(sampleid),
    host_family = clean_value(host_family),
    host_species = clean_value(host_species)
  ) %>%
  filter(
    !is.na(sample_id),
    !is.na(host_family),
    !is.na(host_species),
    host_family %in% family_order
  ) %>%
  distinct(sample_id, .keep_all = TRUE)

species_map <- meta2 %>%
  distinct(host_species, host_family) %>%
  mutate(
    host_species_safe = make_safe_label(host_species)
  ) %>%
  arrange(factor(host_family, levels = family_order), host_species)

dup_safe <- species_map$host_species_safe[duplicated(species_map$host_species_safe)]

if (length(dup_safe) > 0) {
  stop("host_species_safe 出现重复：", paste(unique(dup_safe), collapse = ", "))
}

meta2 <- meta2 %>%
  left_join(
    species_map %>% select(host_species, host_species_safe),
    by = "host_species"
  )

write.csv(
  species_map,
  mapping_file,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

cat("metadata 有效样本数：", nrow(meta2), "\n", sep = "")
cat("host_species 数：", length(unique(meta2$host_species)), "\n", sep = "")

## =========================
## 4. macrofungi SH taxonomy
## =========================

cat("\n读取食源大型真菌 SH taxonomy ...\n")

macro_tax <- read.csv(
  macrofungi_SH_taxonomy_file,
  check.names = FALSE,
  stringsAsFactors = FALSE,
  fileEncoding = "UTF-8"
)

needed_tax_cols <- c("SH", "genus")

missing_tax_cols <- setdiff(needed_tax_cols, colnames(macro_tax))

if (length(missing_tax_cols) > 0) {
  stop(
    "大型真菌 SH taxonomy 文件缺少必要列：",
    paste(missing_tax_cols, collapse = ", "),
    "\n当前列名为：",
    paste(colnames(macro_tax), collapse = " | ")
  )
}

if ("genus_clean" %in% colnames(macro_tax)) {
  genus_col <- "genus_clean"
} else {
  genus_col <- "genus"
}

macro_tax2 <- macro_tax %>%
  transmute(
    SH = as.character(SH),
    Genus = normalize_genus(.data[[genus_col]])
  ) %>%
  filter(
    !is.na(SH),
    SH != "",
    !is.na(Genus),
    Genus != ""
  ) %>%
  distinct(SH, .keep_all = TRUE)

cat("大型真菌相关 SH taxonomy 记录数：", nrow(macro_tax2), "\n", sep = "")
cat("大型真菌相关属数：", n_distinct(macro_tax2$Genus), "\n", sep = "")

## =========================
## 5. macrofungi SH abundance
## =========================

cat("\n读取食源大型真菌 SH abundance table ...\n")

macro_abund <- read.delim(
  macrofungi_SH_abundance_file,
  sep = "\t",
  header = TRUE,
  check.names = FALSE,
  quote = "",
  comment.char = "",
  stringsAsFactors = FALSE
)

if (!"SH" %in% colnames(macro_abund)) {
  stop(
    "食源大型真菌 SH abundance table 缺少 SH 列。\n当前列名为：",
    paste(colnames(macro_abund), collapse = " | ")
  )
}

macro_abund$SH <- as.character(macro_abund$SH)

macro_abund <- macro_abund %>%
  filter(SH %in% macro_tax2$SH)

macro_tax2 <- macro_tax2 %>%
  filter(SH %in% macro_abund$SH)

sample_cols_all <- setdiff(colnames(macro_abund), "SH")
common_samples <- intersect(sample_cols_all, meta2$sample_id)
common_samples <- sample_cols_all[sample_cols_all %in% common_samples]

if (length(common_samples) == 0) {
  stop("大型真菌 SH abundance table 和 metadata 没有匹配样本。")
}

meta2 <- meta2 %>%
  filter(sample_id %in% common_samples)

meta2 <- meta2[match(common_samples, meta2$sample_id), , drop = FALSE]

macro_abund <- macro_abund[, c("SH", common_samples), drop = FALSE]

cat("共同样本数：", length(common_samples), "\n", sep = "")
cat("丰度表中大型真菌 SH 数：", nrow(macro_abund), "\n", sep = "")

## =========================
## 6. SH reads 汇总到 genus
## =========================

cat("\n按 genus 汇总 SH reads ...\n")

macro_abund <- macro_abund[
  match(macro_tax2$SH, macro_abund$SH),
  ,
  drop = FALSE
]

abund_mat <- as.matrix(macro_abund[, common_samples, drop = FALSE])
storage.mode(abund_mat) <- "numeric"
abund_mat[is.na(abund_mat)] <- 0
rownames(abund_mat) <- macro_abund$SH

genus_vec <- macro_tax2$Genus[
  match(rownames(abund_mat), macro_tax2$SH)
]

if (any(is.na(genus_vec))) {
  stop("部分 SH 未匹配到 Genus。")
}

genus_feature <- clean_feature_name(genus_vec)

genus_mat <- rowsum(
  abund_mat,
  group = genus_feature,
  reorder = FALSE
)

genus_mat <- genus_mat[rownames(genus_mat) != "", , drop = FALSE]
genus_mat <- genus_mat[rowSums(genus_mat) > 0, , drop = FALSE]

cat("汇总后大型真菌属数：", nrow(genus_mat), "\n", sep = "")

## =========================
## 7. 样本内相对丰度
## =========================

cat("\n计算样本内大型真菌属相对丰度百分比 ...\n")

sample_sums <- colSums(genus_mat, na.rm = TRUE)

zero_samples <- data.frame(
  sample_id = names(sample_sums)[sample_sums <= 0],
  total_macrofungi_reads = sample_sums[sample_sums <= 0],
  stringsAsFactors = FALSE
)

write.csv(
  zero_samples,
  zero_sample_file,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

cat("大型真菌 reads 为 0 的样本数：", nrow(zero_samples), "\n", sep = "")

valid_samples <- names(sample_sums)[sample_sums > 0]

if (length(valid_samples) == 0) {
  stop("所有样本的大型真菌 reads 均为 0，无法生成 LEfSe 输入。")
}

genus_mat_valid <- genus_mat[, valid_samples, drop = FALSE]

genus_rel <- sweep(
  genus_mat_valid,
  2,
  sample_sums[valid_samples],
  "/"
) * 100

genus_rel[is.na(genus_rel)] <- 0

meta_use <- meta2 %>%
  filter(sample_id %in% valid_samples)

meta_use <- meta_use[match(valid_samples, meta_use$sample_id), , drop = FALSE]

species_count <- meta_use %>%
  count(host_family, host_species, host_species_safe, name = "n_samples") %>%
  arrange(factor(host_family, levels = family_order), host_species)

write.csv(
  species_count,
  sample_count_file,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

cat("进入 LEfSe 的样本数：", nrow(meta_use), "\n", sep = "")
cat("进入 LEfSe 的宿主物种数：", n_distinct(meta_use$host_species), "\n", sep = "")

rownames(genus_rel) <- paste0("k__Fungi|g__", rownames(genus_rel))

## =========================
## 8. write LEfSe input
## =========================

cat("\n写出 LEfSe 输入文件 ...\n")

class_row <- c("class", as.character(meta_use$host_species_safe))
subclass_row <- c("subclass", rep("no_subclass", nrow(meta_use)))
subject_row <- c("subject", as.character(meta_use$sample_id))

feature_table <- as.data.frame(genus_rel, check.names = FALSE) %>%
  rownames_to_column("ID")

feature_table <- feature_table[, c("ID", meta_use$sample_id), drop = FALSE]
feature_table[] <- lapply(feature_table, as.character)

out <- rbind(
  class_row,
  subclass_row,
  subject_row,
  as.matrix(feature_table)
)

write.table(
  out,
  out_input,
  sep = "\t",
  quote = FALSE,
  row.names = FALSE,
  col.names = FALSE
)

write.csv(
  data.frame(
    lefse_feature = rownames(genus_rel),
    original_or_clean_genus = gsub("^k__Fungi\\|g__", "", rownames(genus_rel))
  ),
  feature_list_file,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

## =========================
## 9. summary
## =========================

sink(summary_file)

cat("LEfSe input generation summary: host_species macrofungi genus no-elephant\n")
cat("======================================================================\n\n")

cat("Input metadata:\n", metadata_file, "\n", sep = "")
cat("Input macrofungi SH abundance table:\n", macrofungi_SH_abundance_file, "\n", sep = "")
cat("Input macrofungi SH taxonomy:\n", macrofungi_SH_taxonomy_file, "\n\n", sep = "")

cat("Output LEfSe input:\n", out_input, "\n\n", sep = "")

cat("Data version:\n")
cat("globalfungi_style_test_no_elephant only\n")
cat("No old elephant-containing version\n")
cat("No old vsearch 97% SH results\n\n")

cat("Analysis logic:\n")
cat("1. Use already filtered food-derived macrofungi-related SH table.\n")
cat("2. Aggregate macrofungi SH reads to genus level.\n")
cat("3. Convert each sample to macrofungi genus relative abundance percentage.\n")
cat("4. Use host_species as LEfSe class.\n")
cat("5. Exclude samples with zero total macrofungi reads because within-macrofungi relative abundance is undefined.\n")
cat("6. No TopN filtering and no prevalence filtering.\n\n")

cat("Matched samples before zero filtering:", length(common_samples), "\n")
cat("Zero macrofungi samples excluded:", nrow(zero_samples), "\n")
cat("Samples used for LEfSe:", nrow(meta_use), "\n")
cat("Host species used for LEfSe:", n_distinct(meta_use$host_species), "\n")
cat("Macrofungi genus features for LEfSe:", nrow(genus_rel), "\n\n")

cat("Host species sample counts after zero filtering:\n")
print(species_count)

cat("\nZero macrofungi samples file:\n")
cat(zero_sample_file, "\n")

cat("\nFeature list file:\n")
cat(feature_list_file, "\n")

cat("\nMapping file:\n")
cat(mapping_file, "\n")

sink()

cat("\nDone!\n")
cat("Samples used for LEfSe:", nrow(meta_use), "\n")
cat("Host species used for LEfSe:", n_distinct(meta_use$host_species), "\n")
cat("Macrofungi genus features:", nrow(genus_rel), "\n")
cat("Output LEfSe input:\n", out_input, "\n", sep = "")
cat("Mapping:\n", mapping_file, "\n", sep = "")
cat("Sample counts:\n", sample_count_file, "\n", sep = "")
cat("Zero samples:\n", zero_sample_file, "\n", sep = "")
cat("Summary:\n", summary_file, "\n", sep = "")
