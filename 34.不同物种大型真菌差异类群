        parts = line.split("\t")

        if len(parts) < 4:
            continue

        feature_raw = parts[0].strip()
        group_raw = parts[2].strip()
        group_safe = normalize_group(group_raw)

        try:
            lda = float(parts[3])
        except Exception:
            continue

        if lda < 4.0:
            continue

        if not group_safe:
            continue

        if group_safe not in species_order_safe:
            unknown_groups.add(group_safe)
            continue

        genus_raw = extract_genus(feature_raw)
        feature_cn = translate_feature(feature_raw)

        if feature_cn == genus_raw:
            untranslated_genera.add(genus_raw)

        rows.append({
