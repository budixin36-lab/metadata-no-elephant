def strip_feature_prefix(feature: str) -> str:
    f = feature.strip()
    for prefix in [
        "k__Fungi|g__",
        "k__Fungi.g__",
        "k__Fungi|",
        "g__",
    ]:
        if f.startswith(prefix):
            f = f[len(prefix):]
    return f

def translate_feature(feature: str):
    genus = strip_feature_prefix(feature)
    if genus in genus_map:
        return genus, genus_map[genus][0], genus_map[genus][1]
    return genus, genus, "untranslated"

def normalize_group(group: str) -> str:
    g = group.strip()
    g = g.replace("×", "x")
    g = g.replace(" ", "_")
    return g

