#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
Chapter 5 - Fig5-5
不同宿主物种食源大型真菌属水平差异类群 LEfSe LDA score 图

Input:
  host_species_macrofungi_genus_no_elephant.res

Output:
  Fig5_5_host_species_macrofungi_LEfSe_LDA_score_no_elephant_CN_ordered.png
  Fig5_5_host_species_macrofungi_LEfSe_LDA_score_no_elephant_CN_ordered.pdf
  Fig5_5_host_species_macrofungi_LEfSe_LDA_score_no_elephant_CN_ordered_plot_data.csv
  Fig5_5_host_species_macrofungi_LEfSe_LDA_score_no_elephant_CN_ordered_untranslated_genera.csv

注意：
  本脚本不重新运行 LEfSe；
  只读取已有 .res 结果并作图；
  只绘制 LDA score > 4.0 的差异属；
  宿主物种顺序严格按论文物种分类层级图：
  牛科 → 猪科 → 鹿科 → 马科 → 犀科。
"""

from pathlib import Path
import csv
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib import font_manager
from matplotlib.patches import Patch

# =============================
# 1. 路径
# =============================

res_file = Path("host_species_macrofungi_genus_no_elephant.res")

out_png = Path("Fig5_5_host_species_macrofungi_LEfSe_LDA_score_no_elephant_CN_ordered.png")
out_pdf = Path("Fig5_5_host_species_macrofungi_LEfSe_LDA_score_no_elephant_CN_ordered.pdf")
out_csv = Path("Fig5_5_host_species_macrofungi_LEfSe_LDA_score_no_elephant_CN_ordered_plot_data.csv")
out_untranslated = Path("Fig5_5_host_species_macrofungi_LEfSe_LDA_score_no_elephant_CN_ordered_untranslated_genera.csv")

if not res_file.exists():
    raise SystemExit(
        f"找不到输入文件：{res_file}\n"
        "请先确认 lefse_run.py 已经成功生成 host_species_macrofungi_genus_no_elephant.res"
    )

# =============================
# 2. 字体
# =============================

font_candidates = [
    "/mnt/c/Windows/Fonts/simsun.ttc",
    "/mnt/c/Windows/Fonts/msyh.ttc",
    "/mnt/c/Windows/Fonts/simhei.ttf",
    "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
    "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
]

font_path = None
for fp in font_candidates:
    if Path(fp).exists():
        font_path = fp
        break

if font_path is None:
    print("警告：没有找到中文字体，中文可能显示异常。")
    font_prop = None
else:
    font_manager.fontManager.addfont(font_path)
    font_prop = font_manager.FontProperties(fname=font_path)
    plt.rcParams["font.family"] = font_prop.get_name()

plt.rcParams["axes.unicode_minus"] = False
plt.rcParams["pdf.fonttype"] = 42
plt.rcParams["ps.fonttype"] = 42

