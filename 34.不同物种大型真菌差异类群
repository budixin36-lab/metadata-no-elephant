def translate_feature(feature: str) -> str:
    f = feature.strip()

    for prefix in [
        "k__Fungi|g__",
        "k__Fungi.g__",
        "k__Fungi|",
        "g__",
    ]:
        if f.startswith(prefix):
            f = f[len(prefix):]

    return genus_map.get(f, f)

def extract_genus(feature: str) -> str:
    f = feature.strip()
    for prefix in [
        "k__Fungi|g__",
        "k__Fungi.g__",
        "k__Fungi|",
        "g__",
    ]:
        if f.startswith(prefix):
            f = f[len(prefix):]
    return f

def normalize_group(group: str) -> str:
    g = group.strip()
    g = g.replace("×", "x")
    g = g.replace(" ", "_")
    return g

