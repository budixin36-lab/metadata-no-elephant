#三、过滤 BIOM 和 taxonomy abundance tables
#继续在 WSL 终端运行：
cat > globalfungi_style_test_no_elephant/scripts/02_filter_no_elephant_biom_and_tables.py <<'EOF'
from biom import load_table
import pandas as pd
from pathlib import Path

old_base = Path("/mnt/d/ITS_SH_pipeline/globalfungi_style_test")
new_base = Path("/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant")

sample_ids_file = new_base / "metadata/no_elephant_sample_ids.txt"

biom_in = old_base / "taxonomy/merged_SH_globalfungi_style_nozero_with_taxonomy.biom"
biom_out = new_base / "taxonomy/merged_SH_globalfungi_style_nozero_no_elephant_with_taxonomy.biom"

summary_out = new_base / "summary/no_elephant_biom_taxonomy_summary.txt"

sample_ids = [x.strip() for x in open(sample_ids_file, encoding="utf-8") if x.strip()]
sample_set = set(sample_ids)

table = load_table(str(biom_in))

missing_samples = sorted(sample_set - set(table.ids(axis="sample")))
if missing_samples:
    raise ValueError(f"这些 metadata 样本在 BIOM 中找不到，前10个为：{missing_samples[:10]}")

table_f = table.filter(sample_ids, axis="sample", inplace=False)
table_f = table_f.remove_empty(axis="observation", inplace=False)

with open(biom_out, "w", encoding="utf-8") as f:
    table_f.to_json("no_elephant_filter", f)

taxonomy_files = [
    "phylum_abundance_table.tsv",
    "family_abundance_table.tsv",
    "genus_abundance_table.tsv",
    "species_abundance_table.tsv"
]

summary_lines = []
summary_lines.append(f"old_biom_samples\t{len(table.ids(axis='sample'))}")
summary_lines.append(f"old_biom_SHs\t{len(table.ids(axis='observation'))}")
summary_lines.append(f"new_biom_samples\t{len(table_f.ids(axis='sample'))}")
summary_lines.append(f"new_biom_SHs\t{len(table_f.ids(axis='observation'))}")

for fn in taxonomy_files:
    in_path = old_base / "taxonomy" / fn
    out_path = new_base / "taxonomy" / fn.replace(".tsv", "_no_elephant.tsv")

    df = pd.read_csv(in_path, sep="\t", dtype=str)
    tax_col = df.columns[0]

    keep_cols = [tax_col] + [c for c in df.columns[1:] if c in sample_set]
    df2 = df[keep_cols].copy()

    # 删除所有 no_elephant 样本中丰度均为 0 的分类行
    abundance = df2.iloc[:, 1:].apply(pd.to_numeric, errors="coerce").fillna(0)
    df2 = df2.loc[abundance.sum(axis=1) > 0, :]

    df2.to_csv(out_path, sep="\t", index=False)

    summary_lines.append(f"{fn}_old_taxa\t{df.shape[0]}")
    summary_lines.append(f"{fn}_new_taxa\t{df2.shape[0]}")
    summary_lines.append(f"{fn}_new_samples\t{df2.shape[1] - 1}")

with open(summary_out, "w", encoding="utf-8") as f:
    f.write("\n".join(summary_lines) + "\n")

print("Done BIOM and taxonomy table filtering.")
print("Output BIOM:", biom_out)
print("Summary:", summary_out)
EOF

