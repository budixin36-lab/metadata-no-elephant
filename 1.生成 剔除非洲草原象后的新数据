cat > make_tree_sorted_by_sample_size.R <<'EOF'
suppressPackageStartupMessages({
  library(dplyr)
})

metadata_file <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/metadata/metadata_valid_globalfungi_SH_nozero_no_elephant.csv"
mapping_file  <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/results/itol_fig2_2_no_elephant/Fig2_2_species_id_mapping.csv"
out_file      <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/results/itol_fig2_2_no_elephant/Fig2_2_no_elephant_tree_sample_size_order.nwk"
order_table   <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/results/itol_fig2_2_no_elephant/Fig2_2_sample_size_order_table.csv"

df <- read.csv(metadata_file, stringsAsFactors = FALSE, check.names = FALSE)
map <- read.csv(mapping_file, stringsAsFactors = FALSE, check.names = FALSE)

need_cols <- c("sampleid", "host_order", "host_family", "host_species")
miss_cols <- setdiff(need_cols, colnames(df))
if (length(miss_cols) > 0) {
  stop("metadata 缺少列: ", paste(miss_cols, collapse = ", "))
}

df <- df %>%
  mutate(across(all_of(need_cols), ~ trimws(as.character(.)))) %>%
  filter(
    host_species != "Loxodonta africana",
    host_family  != "Elephantidae",
    host_order   != "Proboscidea"
  ) %>%
  mutate(
    host_genus = sub(" .*", "", host_species)
  )

sp_info <- df %>%
  count(host_order, host_family, host_genus, host_species, name = "species_n") %>%
  left_join(map[, c("species_id", "host_species")], by = "host_species")

if (any(is.na(sp_info$species_id))) {
  print(sp_info %>% filter(is.na(species_id)))
  stop("有物种没有匹配到 species_id，请检查 Fig2_2_species_id_mapping.csv")
}

genus_n <- sp_info %>%
  group_by(host_order, host_family, host_genus) %>%
  summarise(genus_n = sum(species_n), .groups = "drop")

family_n <- sp_info %>%
  group_by(host_order, host_family) %>%
  summarise(family_n = sum(species_n), .groups = "drop")

order_n <- sp_info %>%
  group_by(host_order) %>%
  summarise(order_n = sum(species_n), .groups = "drop")

sp_info2 <- sp_info %>%
  left_join(genus_n, by = c("host_order", "host_family", "host_genus")) %>%
  left_join(family_n, by = c("host_order", "host_family")) %>%
  left_join(order_n, by = "host_order") %>%
  arrange(
    desc(order_n), host_order,
    desc(family_n), host_family,
    desc(genus_n), host_genus,
    desc(species_n), host_species
  )

write.csv(sp_info2, order_table, row.names = FALSE, quote = TRUE)

make_clade <- function(x, label) {
  paste0("(", paste(x, collapse = ","), ")", label, ":1")
}

order_strings <- c()

for (ord in unique(sp_info2$host_order)) {
  d_ord <- sp_info2 %>% filter(host_order == ord)
  family_strings <- c()

  for (fam in unique(d_ord$host_family)) {
    d_fam <- d_ord %>% filter(host_family == fam)
    genus_strings <- c()

    for (gen in unique(d_fam$host_genus)) {
      d_gen <- d_fam %>% filter(host_genus == gen)
      species_strings <- paste0(d_gen$species_id, ":1")
      genus_strings <- c(genus_strings, make_clade(species_strings, gen))
    }

    family_strings <- c(family_strings, make_clade(genus_strings, fam))
  }

  order_strings <- c(order_strings, make_clade(family_strings, ord))
}

newick <- paste0("(", paste(order_strings, collapse = ","), ");")
writeLines(newick, out_file, useBytes = TRUE)

cat("已生成按样本量从大到小排序的树文件：\n")
cat(out_file, "\n\n")
cat("排序检查表：\n")
cat(order_table, "\n")
EOF

