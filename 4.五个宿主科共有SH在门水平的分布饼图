#饼图/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/results/host_family_upset/Fig3_2_shared_SHs_all_host_families_phylum_pie_no_elephant.png
#完整门水平组成表/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/results/host_family_upset/shared_SHs_all_host_families_phylum_composition_full_no_elephant.csv
#summary /mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/results/host_family_upset/host_family_shared_phylum_summary_no_elephant.txt
#四、说明一下这次的统计口径
#这版是沿用你原第三章对应代码的口径：
#先找出 5 个宿主科共有的 381 个 SH
#再用这 381 个 SH 在所有样本中的 total reads
#聚合到 phylum
#计算门水平 relative abundance (%)
#no_elephant 目录下没有 taxonomy/SH_taxonomy_matched.tsv。
#但这不是大问题，也不需要重新做 taxonomy。因为 no_elephant 只是从最终数据里剔除了非洲草原象样本，SH 的 taxonomy 注释本身还是之前那套结果，可以直接用原始最终目录里的 taxonomy 文件：
#/mnt/d/ITS_SH_pipeline/globalfungi_style_test/taxonomy/SH_taxonomy_matched.tsv
#也就是说，脚本里这行路径写得太死了：
#taxonomy_file <- file.path(
#  base_dir,
#  "taxonomy/SH_taxonomy_matched.tsv"
#)
#应该改成：优先找 no_elephant 目录下的 taxonomy 文件；如果没有，就自动回退到原 globalfungi_style_test 目录下的 taxonomy 文件。
#直接修脚本，在 WSL 终端运行：
python3 - <<'PY'
from pathlib import Path

script = Path("/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/scripts/04_shared_SH_phylum_pie_no_elephant.R")
txt = script.read_text(encoding="utf-8")

old = '''taxonomy_file <- file.path(
  base_dir,
  "taxonomy/SH_taxonomy_matched.tsv"
)'''

new = '''## taxonomy 注释文件：
## no_elephant 目录可能没有单独复制 SH_taxonomy_matched.tsv；
## 因为 no_elephant 只是剔除样本，SH taxonomy 注释仍可使用原 globalfungi_style_test 的最终 taxonomy 文件。
taxonomy_candidates <- c(
  file.path(base_dir, "taxonomy/SH_taxonomy_matched.tsv"),
  "/mnt/d/ITS_SH_pipeline/globalfungi_style_test/taxonomy/SH_taxonomy_matched.tsv"
)

taxonomy_file <- taxonomy_candidates[file.exists(taxonomy_candidates)][1]

if (is.na(taxonomy_file)) {
  stop(
    "找不到 SH_taxonomy_matched.tsv。已尝试以下路径：\\n",
    paste(taxonomy_candidates, collapse = "\\n")
  )
}

cat("Using taxonomy file:", taxonomy_file, "\\n")'''

if old not in txt:
    raise SystemExit("没有找到 taxonomy_file 原始代码块，请检查脚本内容。")

txt = txt.replace(old, new)
script.write_text(txt, encoding="utf-8")

print("已修复 taxonomy_file 路径自动回退：")
print(script)
PY
