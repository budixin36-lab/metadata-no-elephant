extract_synonym_target <- function(comment) {
  comment <- as.character(comment)
  comment[is.na(comment)] <- ""

  ## 只处理明确 “synonym of X” 的情况。
  hit <- str_match(comment, regex("synonym of\\s+([A-Za-z][A-Za-z.-]*)", ignore_case = TRUE))[, 2]
  hit <- norm_genus(hit)
  hit
}

pick_col <- function(candidates, cols, label) {
  hit <- candidates[candidates %in% cols][1]
  if (is.na(hit)) {
    stop(
      "找不到列：", label,
      "\n尝试列名：", paste(candidates, collapse = ", "),
      "\n实际列名：", paste(cols, collapse = ", ")
    )
  }
  hit
}

