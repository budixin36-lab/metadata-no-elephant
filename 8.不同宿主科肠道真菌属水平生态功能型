residual_df <- total_check_before %>%
  mutate(
    residual = 100 - total,
    residual = ifelse(abs(residual) < 1e-6, 0, residual),
    function_group = "未分类",
    mean_relative_abundance = residual
  ) %>%
  filter(residual > 0) %>%
  select(host_family_cn2, function_group, mean_relative_abundance)

