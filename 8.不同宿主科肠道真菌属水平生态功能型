        primary_lifestyle_cn,
        accepted_match_source = match_source
      ),
    by = c("genus_key" = "accepted_key")
  ) %>%
  left_join(
    synonym_map %>%
      select(
        accepted_key,
        synonym_accepted_genus_joined = accepted_genus_joined,
        synonym_primary_raw_joined = primary_raw_joined,
        synonym_primary_lifestyle_cn = primary_lifestyle_cn,
        synonym_match_source = match_source
      ),
    by = c("genus_key" = "accepted_key")
  ) %>%
  mutate(
    match_method = case_when(
      !is.na(primary_lifestyle_cn) ~ "accepted_GENUS",
      is.na(primary_lifestyle_cn) & !is.na(synonym_primary_lifestyle_cn) ~ "synonym_comment_fallback",
      TRUE ~ "unmatched"
    ),
    primary_lifestyle_cn = case_when(
      !is.na(primary_lifestyle_cn) ~ primary_lifestyle_cn,
      is.na(primary_lifestyle_cn) & !is.na(synonym_primary_lifestyle_cn) ~ synonym_primary_lifestyle_cn,
      TRUE ~ "未分类"
    ),
    ## 合并 generic undefined/未定义型 和 未分类
    primary_lifestyle_cn = ifelse(
      primary_lifestyle_cn %in% c("未定义型", "未分类"),
