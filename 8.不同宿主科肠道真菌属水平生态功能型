choose_existing_file <- function(x) {
  hit <- x[file.exists(x)]
  if (length(hit) == 0) return(NA_character_)
  hit[1]
}

normalize_name <- function(x) {
  x <- as.character(x)
  x <- trimws(x)
  x <- gsub("^g__", "", x, ignore.case = TRUE)
  x <- gsub("^.*;\\s*g__", "", x, ignore.case = TRUE)
  x <- gsub("^.*;\\s*", "", x)
  x <- gsub("_", " ", x)
  x <- gsub("\\s+", " ", x)
  x <- gsub("\\bsp\\.?$", "", x, ignore.case = TRUE)
  x <- gsub("\\bspp\\.?$", "", x, ignore.case = TRUE)
  x <- trimws(x)

  # 对于 "Aspergillus flavus" 这种，取第一个词作为属名
  x <- sapply(strsplit(x, "\\s+"), function(v) {
    if (length(v) == 0) return(NA_character_)
    v[1]
  }, USE.NAMES = FALSE)

  x <- tolower(x)

  x[x %in% c(
    "", "na", "nan", "null",
    "unassigned", "unclassified", "uncultured", "unknown",
    "fungi", "fungal", "incertae", "incertae sedis"
  )] <- NA_character_

  return(x)
}

normalize_colname <- function(x) {
  tolower(gsub("[^a-z0-9]+", "", x))
}

find_col <- function(df, patterns, required = TRUE) {
  nm <- names(df)
  nm2 <- normalize_colname(nm)

  idx <- integer(0)
  for (p in patterns) {
    idx <- c(idx, which(grepl(p, nm2)))
  }
  idx <- unique(idx)

  if (length(idx) == 0) {
    if (required) {
      stop("无法识别所需列。现有列名为：\n", paste(names(df), collapse = " | "))
    } else {
      return(NA_character_)
    }
  }
  nm[idx[1]]
}

