#这次只需要改作图代码，不改数据、不重新计算。
#直接运行下面这段修复脚本：
python3 - <<'PY'
from pathlib import Path

script = Path("/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/scripts/10_redraw_host_family_function_group_bar_CN_final.R")
txt = script.read_text(encoding="utf-8")

old = '''  scale_y_continuous(
    limits = c(0, 100),
    breaks = seq(0, 100, 20),
    expand = c(0, 0)
  ) +'''

new = '''  scale_y_continuous(
    breaks = seq(0, 100, 20),
    expand = c(0, 0)
  ) +
  coord_cartesian(
    ylim = c(0, 100),
    clip = "off"
  ) +'''

if old not in txt:
    raise SystemExit("没找到需要替换的 scale_y_continuous 代码块。")

txt = txt.replace(old, new)

script.write_text(txt, encoding="utf-8")
print("已修复：删除 scale_y_continuous(limits=...)，改用 coord_cartesian(ylim=...)。")
PY

