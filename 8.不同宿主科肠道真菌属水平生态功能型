clean_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c(
    "", "NA", "N/A", "na", "n/a",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded",
    "not_reported", "not reported",
    "unknown", "Unknown", "UNKNOWN"
  )] <- NA_character_
  x
}

norm_genus <- function(x) {
  x <- as.character(x)
  x <- gsub("^g__", "", x)
  x <- gsub("_", " ", x)
  x <- trimws(x)
  x <- str_squish(x)
  x[x %in% c("", "NA", "na", "N/A", "unknown", "Unknown", "unclassified")] <- NA_character_
  tolower(x)
}

