format_p <- function(p) {
  if (length(p) == 0 || is.na(p)) return("NA")
  if (p < 0.001) return("<0.001")
  sprintf("%.3f", p)
}

## 关键函数：
## 对某一轴当前所有刻度值：
## 1) 先去掉尾零
## 2) 再找该轴最大所需小数位
## 3) 最后全部按该最大位数统一补齐
format_axis_trim_pad <- function(x, max_digits_cap = 10) {
  if (length(x) == 0) return(character(0))

  x2 <- x
  x2[abs(x2) < 1e-12] <- 0

  raw <- sprintf(paste0("%.", max_digits_cap, "f"), x2)
  trimmed <- sub("0+$", "", raw)
  trimmed <- sub("\\.$", "", trimmed)

  dec_digits <- ifelse(
    grepl("\\.", trimmed),
    nchar(sub("^.*\\.", "", trimmed)),
    0
  )

  keep_digits <- max(dec_digits, na.rm = TRUE)

  if (!is.finite(keep_digits)) keep_digits <- 0

  sprintf(paste0("%.", keep_digits, "f"), x2)
}

get_iqr_range <- function(x, multiplier = 5) {
  q1 <- as.numeric(stats::quantile(x, probs = 0.25, na.rm = TRUE, names = FALSE))
  q3 <- as.numeric(stats::quantile(x, probs = 0.75, na.rm = TRUE, names = FALSE))
  iqr <- q3 - q1

  lower <- q1 - multiplier * iqr
  upper <- q3 + multiplier * iqr

  data.frame(
    Q1 = q1,
    Q3 = q3,
    IQR = iqr,
    multiplier = multiplier,
    lower = lower,
    upper = upper,
    stringsAsFactors = FALSE
  )
}

get_padded_range <- function(x, padding = 0.10) {
  r <- range(x, na.rm = TRUE)
  d <- diff(r)

  if (is.na(d) || d == 0) {
    d <- max(abs(r), 1e-6)
  }

  c(
    lower = r[1] - padding * d,
    upper = r[2] + padding * d
  )
}

read_stress_from_summary <- function(summary_file) {
  if (!file.exists(summary_file)) {
    return(NA_real_)
  }

  txt <- readLines(summary_file, warn = FALSE, encoding = "UTF-8")

  hit1 <- grep("Bray-Curtis NMDS stress", txt, value = TRUE)
  if (length(hit1) > 0) {
    val <- sub(".*stress\\s*=\\s*([0-9.]+).*", "\\1", hit1[1])
    val <- suppressWarnings(as.numeric(val))
    if (!is.na(val)) return(val)
  }

  idx <- grep("^NMDS stress", txt)
  if (length(idx) > 0 && idx[1] < length(txt)) {
    next_line <- txt[idx[1] + 1]
    val <- suppressWarnings(as.numeric(gsub("[^0-9.]", "", next_line)))
    if (!is.na(val)) return(val)
  }

  return(NA_real_)
}

