#下面给你的是完整可运行最终版脚本，是以你发来的 03_host_family_upset_no_elephant.R 最底部最终版 为基准改的，只做这些事：
#保留原 final 版 UpSetR 布局参数
#group.by = "degree"
#order.by = "freq"
#decreasing = TRUE
#mb.ratio = c(0.70, 0.30)
#point.size = 2.2
#line.size = 0.65
#5000 × 3400, 600 dpi
#宿主科名改成中文
#“交集数目”“SH数目”“宿主科名”统一为宋体、统一字号
#宿主科名通过“中文名后加全角空格”方式整体往左挪
#尽量让它视觉上更靠近左柱图和右点线图之间的中间
#不用 Cairo 包
#只用 png(type = "cairo") 和 pdf()
#使用方法
#把下面整段复制到 WSL 终端运行即可：
cd /mnt/d/ITS_SH_pipeline

cat > /mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/scripts/03_host_family_upset_no_elephant_CN_final.R <<'EOF'
## ============================================================
## 图3-1 宿主科水平共享/独有 SH UpSet 图（中文最终版）
## no_elephant 版
##
## 说明：
## 1. 以旧图最终版 UpSetR 代码为基准；
## 2. 不使用 biomformat，直接读取 biom convert 导出的 SH abundance TSV；
## 3. 排序：按共享宿主科数量分组（5科共有 -> 4科共有 -> ...），
##    每组内按交集数目从大到小；
## 4. 5科共有标红；
## 5. “交集数目”“SH数目”“宿主科名”统一为宋体、统一字号；
## 6. 宿主科名通过全角空格左移，尽量居于左柱图和右点线图之间；
## 7. PNG 输出 600 dpi。
## ============================================================

RVER <- paste0(R.version$major, ".", strsplit(R.version$minor, "\\.")[[1]][1])
user_lib <- file.path(Sys.getenv("HOME"), "Rlibs", paste0("R-", RVER))

.libPaths(c(
  user_lib,
  "/mnt/d/Rlibs",
  "/usr/local/lib/R/site-library",
  "/usr/lib/R/site-library",
  "/usr/lib/R/library"
))

suppressPackageStartupMessages({
  library(tidyverse)
  library(UpSetR)
  library(showtext)
  library(sysfonts)
})

## -----------------------------
## 0. 中文字体（宋体）
## -----------------------------
font_path <- "/mnt/c/Windows/Fonts/simsun.ttc"
if (!file.exists(font_path)) {
  stop("找不到宋体字体文件：", font_path, "\n请确认 Windows 字体路径。")
}

font_add(family = "cn_font", regular = font_path)
showtext_auto()
showtext_opts(dpi = 600)

cat("使用中文字体：", font_path, "\n")

## -----------------------------
## 1. Paths
## -----------------------------
base_dir <- "/mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant"

metadata_file <- file.path(
  base_dir,
  "metadata/metadata_valid_globalfungi_SH_nozero_no_elephant.csv"
)

sh_table_file <- file.path(
  base_dir,
  "abundance_tables/SH_abundance_table_no_elephant.tsv"
)

out_dir <- file.path(
  base_dir,
  "results/host_family_upset"
)

dir.create(out_dir, recursive = TRUE, showWarnings = FALSE)

## -----------------------------
## 2. Read metadata
## -----------------------------
meta <- read.csv(
  metadata_file,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

if (!"host_family" %in% colnames(meta)) {
  stop("metadata 中没有 host_family 列，请检查列名。")
}

possible_sample_cols <- c("sample_id", "SampleID", "sampleid", "sample_name", "id", "#SampleID")
sample_col <- possible_sample_cols[possible_sample_cols %in% colnames(meta)][1]

if (is.na(sample_col)) {
  stop("没有找到样本 ID 列。请检查 metadata 中样本 ID 列名。")
}

meta <- meta %>%
  mutate(
    sample_id = .data[[sample_col]],
    host_family = trimws(as.character(host_family))
  ) %>%
  filter(
    !is.na(sample_id),
    sample_id != "",
    !is.na(host_family),
    host_family != "",
    host_family != "NA",
    host_family != "missing",
    host_family != "not_recorded",
    host_family != "not reported"
  ) %>%
  distinct(sample_id, .keep_all = TRUE)

cat("Metadata samples after filtering host_family:", nrow(meta), "\n")
cat("Host families:\n")
print(sort(table(meta$host_family), decreasing = TRUE))

## -----------------------------
## 3. Read SH abundance table
## -----------------------------
if (!file.exists(sh_table_file)) {
  stop("找不到 SH abundance table：", sh_table_file)
}

sh_lines <- readLines(sh_table_file, warn = FALSE)
sh_lines <- sh_lines[nchar(trimws(sh_lines)) > 0]

## biom convert --to-tsv 第一行通常是说明行，第二行才是 #OTU ID 表头
if (grepl("^# Constructed from biom file", sh_lines[1])) {
  sh_lines <- sh_lines[-1]
}

if (!grepl("^#OTU ID\t|^#OTU ID$", sh_lines[1])) {
  stop(
    "SH abundance table 表头异常。文件前几行是：\n",
    paste(head(sh_lines, 5), collapse = "\n")
  )
}

sh_raw <- read.delim(
  text = paste(sh_lines, collapse = "\n"),
  header = TRUE,
  sep = "\t",
  check.names = FALSE,
  stringsAsFactors = FALSE,
  quote = "",
  comment.char = ""
)

colnames(sh_raw)[1] <- "SH_ID"

taxonomy_cols <- grep("taxonomy|metadata", colnames(sh_raw), ignore.case = TRUE, value = TRUE)
if (length(taxonomy_cols) > 0) {
  sh_raw <- sh_raw[, !colnames(sh_raw) %in% taxonomy_cols, drop = FALSE]
}

rownames(sh_raw) <- sh_raw$SH_ID
mat <- as.matrix(sh_raw[, -1, drop = FALSE])
mode(mat) <- "numeric"

cat("SH abundance matrix dimension:", nrow(mat), "SHs x", ncol(mat), "samples\n")

## -----------------------------
## 4. Match samples
## -----------------------------
common_samples <- intersect(colnames(mat), meta$sample_id)

if (length(common_samples) == 0) {
  stop("SH abundance table 样本名和 metadata 样本名没有交集，请检查 sample_id 列。")
}

mat <- mat[, common_samples, drop = FALSE]

meta2 <- meta %>%
  filter(sample_id %in% common_samples) %>%
  distinct(sample_id, .keep_all = TRUE)

meta2 <- meta2[match(colnames(mat), meta2$sample_id), ]

cat("Matched samples:", ncol(mat), "\n")
cat("Matched host families:\n")
print(sort(table(meta2$host_family), decreasing = TRUE))

## -----------------------------
## 5. Build SH presence/absence by host family
## -----------------------------
host_families <- sort(unique(meta2$host_family))

presence_list <- list()

for (hf in host_families) {
  samples_hf <- meta2$sample_id[meta2$host_family == hf]
  sub_mat <- mat[, samples_hf, drop = FALSE]
  present_sh <- rownames(sub_mat)[rowSums(sub_mat > 0) > 0]
  presence_list[[hf]] <- present_sh
}

set_size_df <- tibble(
  host_family = names(presence_list),
  SH_number = lengths(presence_list)
) %>%
  arrange(desc(SH_number))

write.csv(
  set_size_df,
  file.path(out_dir, "host_family_SH_set_size_no_elephant.csv"),
  row.names = FALSE
)

all_sh <- sort(unique(unlist(presence_list)))

upset_df <- tibble(SH_ID = all_sh)

for (hf in host_families) {
  upset_df[[hf]] <- as.integer(upset_df$SH_ID %in% presence_list[[hf]])
}

write.csv(
  upset_df,
  file.path(out_dir, "host_family_SH_presence_absence_matrix_no_elephant.csv"),
  row.names = FALSE
)

## -----------------------------
## 6. Shared SHs among all host families
## -----------------------------
shared_sh <- Reduce(intersect, presence_list)

cat("Number of SHs shared by all host families:", length(shared_sh), "\n")

write.table(
  shared_sh,
  file.path(out_dir, "shared_SHs_all_host_families_no_elephant.txt"),
  quote = FALSE,
  row.names = FALSE,
  col.names = FALSE,
  sep = "\t"
)

## -----------------------------
## 7. Summary tables for text
## -----------------------------
upset_input <- as.data.frame(upset_df)
rownames(upset_input) <- upset_input$SH_ID
upset_input$SH_ID <- NULL

pa_mat <- as.matrix(upset_input)

family_sample_counts <- meta2 %>%
  count(host_family, name = "sample_n") %>%
  arrange(desc(sample_n))

family_unique_counts <- tibble(
  host_family = colnames(pa_mat),
  unique_SH_number = sapply(colnames(pa_mat), function(hf) {
    sum(pa_mat[, hf] == 1 & rowSums(pa_mat) == 1)
  })
) %>%
  arrange(desc(unique_SH_number))

pattern_df <- as.data.frame(pa_mat)
pattern_df$pattern <- apply(pattern_df, 1, paste0, collapse = "")

intersection_summary <- pattern_df %>%
  count(pattern, name = "SH_number") %>%
  mutate(
    pattern = as.character(pattern),
    pattern = sprintf("%0*s", length(host_families), pattern),
    pattern = gsub(" ", "0", pattern)
  )

pattern_mat <- do.call(rbind, strsplit(as.character(intersection_summary$pattern), ""))
pattern_mat <- matrix(as.integer(pattern_mat), ncol = length(host_families), byrow = FALSE)
colnames(pattern_mat) <- host_families

intersection_summary$degree <- rowSums(pattern_mat == 1)
intersection_summary$families <- apply(pattern_mat, 1, function(x) {
  paste(host_families[x == 1], collapse = " & ")
})
intersection_summary$share_type <- ifelse(
  intersection_summary$degree == 1,
  "1科特有",
  paste0(intersection_summary$degree, "科共有")
)

intersection_summary <- intersection_summary %>%
  arrange(desc(degree), desc(SH_number))

write.csv(
  intersection_summary,
  file.path(out_dir, "host_family_SH_intersection_summary_no_elephant.csv"),
  row.names = FALSE
)

degree_summary <- intersection_summary %>%
  group_by(degree, share_type) %>%
  summarise(SH_number_total = sum(SH_number), .groups = "drop") %>%
  arrange(desc(degree))

write.csv(
  degree_summary,
  file.path(out_dir, "host_family_SH_degree_summary_no_elephant.csv"),
  row.names = FALSE
)

summary_file <- file.path(out_dir, "host_family_upset_summary_no_elephant.txt")

sink(summary_file)
cat("Host family-level UpSet summary, no_elephant version\n")
cat("====================================================\n\n")
cat("Input metadata:\n", metadata_file, "\n\n")
cat("Input SH abundance table:\n", sh_table_file, "\n\n")
cat("Matched samples:", ncol(mat), "\n")
cat("Total SHs:", nrow(mat), "\n")
cat("Host family number:", length(host_families), "\n\n")
cat("Host family sample numbers:\n")
print(family_sample_counts)
cat("\nHost family SH set sizes:\n")
print(set_size_df)
cat("\nHost family unique SH numbers:\n")
print(family_unique_counts)
cat("\nNumber of SHs shared by all host families:", length(shared_sh), "\n\n")
cat("Degree summary:\n")
print(degree_summary)
sink()

## -----------------------------
## 8. UpSet plot（中文最终版）
## -----------------------------

## 保留旧图最终版的 set_order 逻辑：按 SH 数从高到低
set_order <- set_size_df$host_family

## 宿主科英文 -> 中文（后加全角空格，使可见文字整体左移）
family_display_map <- c(
  "Bovidae"        = "牛科　　　",
  "Equidae"        = "马科　　　",
  "Cervidae"       = "鹿科　　　",
  "Suidae"         = "猪科　　　",
  "Rhinocerotidae" = "犀科　　　"
)

## 仅改显示名，不改数据结构
upset_input_cn <- upset_input
colnames(upset_input_cn) <- unname(family_display_map[colnames(upset_input_cn)])

set_order_cn <- unname(family_display_map[set_order])

## 5科共有高亮为红色（参数必须与中文显示名一致）
all5_query_cn <- list(
  query = intersects,
  params = as.list(unname(family_display_map[c(
    "Bovidae", "Equidae", "Cervidae", "Suidae", "Rhinocerotidae"
  )])),
  color = "#D73027",
  active = TRUE
)

out_pdf <- file.path(out_dir, "Fig3_1_host_family_shared_unique_SH_UpSet_no_elephant_CN_family_centered.pdf")
out_png <- file.path(out_dir, "Fig3_1_host_family_shared_unique_SH_UpSet_no_elephant_CN_family_centered.png")

## 三类文字统一字号：
## 1 = 交集数目
## 3 = SH数目
## 5 = 宿主科名
## 统一设为 1.38
text_scale_vec <- c(
  1.38,  # main bar title
  1.20,  # main bar ticks
  1.38,  # set size title
  1.10,  # set size ticks
  1.38,  # set names
  1.03   # numbers above bars
)

## ---- PDF ----
pdf(
  out_pdf,
  width = 12,
  height = 8.0,
  family = "cn_font"
)

par(family = "cn_font")

upset(
  upset_input_cn,
  sets = set_order_cn,
  nsets = length(set_order_cn),
  nintersects = 60,

  ## 保持旧图最终版结构
  group.by = "degree",
  order.by = "freq",
  decreasing = TRUE,

  mainbar.y.label = "交集数目",
  sets.x.label = "SH数目",

  text.scale = text_scale_vec,
  point.size = 2.2,
  line.size = 0.65,
  mb.ratio = c(0.70, 0.30),

  main.bar.color = "#4D4D4D",
  sets.bar.color = "#4D4D4D",
  matrix.color = "#4D4D4D",
  shade.color = "#F0F0F0",
  shade.alpha = 0.6,

  queries = list(all5_query_cn)
)

dev.off()

## ---- PNG ----
png(
  out_png,
  width = 5000,
  height = 3400,
  res = 600,
  type = "cairo",
  bg = "white"
)

par(family = "cn_font")

upset(
  upset_input_cn,
  sets = set_order_cn,
  nsets = length(set_order_cn),
  nintersects = 60,

  ## 保持旧图最终版结构
  group.by = "degree",
  order.by = "freq",
  decreasing = TRUE,

  mainbar.y.label = "交集数目",
  sets.x.label = "SH数目",

  text.scale = text_scale_vec,
  point.size = 2.2,
  line.size = 0.65,
  mb.ratio = c(0.70, 0.30),

  main.bar.color = "#4D4D4D",
  sets.bar.color = "#4D4D4D",
  matrix.color = "#4D4D4D",
  shade.color = "#F0F0F0",
  shade.alpha = 0.6,

  queries = list(all5_query_cn)
)

dev.off()

cat("\nDone!\n")
cat("Output directory:\n", out_dir, "\n")
cat("PDF:\n", out_pdf, "\n")
cat("PNG:\n", out_png, "\n")
cat("Summary:\n", summary_file, "\n")
EOF

Rscript /mnt/d/ITS_SH_pipeline/globalfungi_style_test_no_elephant/scripts/03_host_family_upset_no_elephant_CN_final.R
