detect_sample_col <- function(df, df_name = "data.frame") {
  candidate_cols <- c(
    "sample_id", "SampleID", "#SampleID", "sampleid",
    "sample_name", "id", "X", "X.1"
  )

  found <- candidate_cols[candidate_cols %in% colnames(df)][1]

  if (is.na(found)) {
    stop(df_name, " 中未找到可识别的样本 ID 列。")
  }

  found
}

clean_value <- function(x) {
  x <- trimws(as.character(x))
  x[x %in% c(
    "", "NA", "N/A", "na", "n/a",
    "unknown", "Unknown", "UNKNOWN",
    "missing", "Missing", "MISSING",
    "not_recorded", "not recorded",
    "not_reported", "not reported",
    "null", "NULL", "Null"
  )] <- NA_character_
  x
}

normalize_continent <- function(x) {
  x <- clean_value(x)
  x_low <- tolower(x)
  x_low <- gsub("_", " ", x_low)
  x_low <- gsub("-", " ", x_low)
  x_low <- gsub("\\s+", " ", x_low)
  x_low <- trimws(x_low)

  dplyr::case_when(
    x_low %in% c("asia", "asian", "亚洲") ~ "亚洲",
    x_low %in% c("europe", "european", "欧洲") ~ "欧洲",
    x_low %in% c("africa", "african", "非洲") ~ "非洲",
    x_low %in% c(
      "north america",
      "south america",
      "americas",
      "america",
      "北美洲",
      "南美洲",
      "美洲"
    ) ~ "美洲",
    TRUE ~ NA_character_
  )
}

normalize_status <- function(x) {
  x <- clean_value(x)
  x_low <- tolower(x)
  x_low <- gsub("_", " ", x_low)
  x_low <- gsub("-", " ", x_low)
  x_low <- gsub("\\s+", " ", x_low)
  x_low <- trimws(x_low)

  dplyr::case_when(
    x_low %in% c("domesticated", "domestic", "家养") ~ "家养",
    x_low %in% c("captive", "captivity", "圈养") ~ "圈养",
    x_low %in% c("wild", "野生") ~ "野生",
    TRUE ~ NA_character_
  )
}

get_padded_range <- function(x, padding = 0.05) {
  r <- range(x, na.rm = TRUE)
  d <- diff(r)

  if (is.na(d) || d == 0) {
    d <- max(abs(r), 1e-6)
  }

  c(
    lower = r[1] - padding * d,
    upper = r[2] + padding * d
  )
}

fmt_decimal_align <- function(x, max_digits = 8) {
  out <- rep(NA_character_, length(x))

  ok <- !is.na(x)
  if (!any(ok)) return(out)

  x2 <- x[ok]
  x2[abs(x2) < 1e-12] <- 0

  raw <- sprintf(paste0("%.", max_digits, "f"), x2)
  trimmed <- sub("0+$", "", raw)
  trimmed <- sub("\\.$", "", trimmed)

  decimal_digits <- ifelse(
    grepl("\\.", trimmed),
    nchar(sub("^.*\\.", "", trimmed)),
    0
  )

  keep_digits <- max(decimal_digits, na.rm = TRUE)

  out[ok] <- sprintf(paste0("%.", keep_digits, "f"), x2)
  out
}

format_p <- function(p) {
  if (length(p) == 0 || is.na(p)) return("NA")
  if (p < 0.001) return("<0.001")
  sprintf("%.3f", p)
}

dist_subset_by_ids <- function(dist_obj, ids) {
  mat <- as.matrix(dist_obj)
  ids <- ids[ids %in% rownames(mat)]
  mat2 <- mat[ids, ids, drop = FALSE]
  as.dist(mat2)
}

extract_adonis_row <- function(adonis_df, target_terms) {
  idx <- which(adonis_df$term %in% target_terms)

  if (length(idx) == 0) {
    return(NA_integer_)
  }

  idx[1]
}

make_adonis_label <- function(adonis_terms_df) {
  idx_interaction <- extract_adonis_row(
    adonis_terms_df,
    c("continent_group:status_cn")
  )

  if (is.na(idx_interaction)) {
    return("Adonis2: 地区×生活状态 = NA")
  }

  p_col <- grep("^Pr", colnames(adonis_terms_df), value = TRUE)[1]

  if (is.na(p_col)) {
    return("Adonis2: 地区×生活状态 P = NA")
  }

  r2 <- adonis_terms_df$R2[idx_interaction]
  p <- adonis_terms_df[[p_col]][idx_interaction]

  paste0(
    "Adonis2: 地区×生活状态 R² = ",
    sprintf("%.3f", r2),
    ", P = ",
    format_p(p)
  )
}

