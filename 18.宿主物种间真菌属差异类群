def translate_feature(feature: str) -> str:
    f = feature.strip()

    # 去掉常见 LEfSe feature 前缀
    for prefix in ["k__Fungi|g__", "k__Fungi.g__", "k__Fungi|", "g__"]:
        if f.startswith(prefix):
            f = f[len(prefix):]

    return genus_map.get(f, f)

def normalize_group(group: str) -> str:
    g = group.strip()
    g = g.replace("×", "x")
    g = g.replace(" ", "_")
    return g

# -----------------------------
# 6. read LEfSe .res
# -----------------------------
rows = []
unknown_groups = set()

with res_file.open("r", encoding="utf-8", errors="ignore") as f:
    for line in f:
        line = line.rstrip("\n")
        if not line.strip():
            continue

        parts = line.split("\t")

        # LEfSe .res 常见列：
        # V1 = feature
        # V2 = raw value
        # V3 = enriched group
        # V4 = LDA score
        # V5 = p value
        if len(parts) < 4:
            continue

        feature_raw = parts[0].strip()
        group_raw = parts[2].strip()
        group_safe = normalize_group(group_raw)

        try:
            lda = float(parts[3])
        except Exception:
            continue

        # 只关注带有富集组且 LDA > 4 的结果
        if lda < 4.0:
            continue

        if group_safe not in species_order_safe:
            if group_safe != "":
                unknown_groups.add(group_safe)
            continue

        feature_cn = translate_feature(feature_raw)
        group_cn = species_cn[group_safe]

        rows.append({
            "feature": feature_cn,
            "group_safe": group_safe,
            "group_cn": group_cn,
            "lda": lda,
        })

if unknown_groups:
    print("警告：.res 中出现不在 23 个目标宿主物种列表中的富集组，已跳过：")
    for g in sorted(unknown_groups):
        print("  -", g)
    print("请检查是否是物种名拼写、×/x、空格或 no-elephant 数据版本问题。")

if len(rows) == 0:
    raise SystemExit("没有解析到 LDA > 4 且带目标宿主物种富集组的结果，请检查 .res 文件。")

# 按固定物种顺序分组；组内按 LDA 从高到低
rows_sorted = []
for sp in species_order_safe:
    sub = [r for r in rows if r["group_safe"] == sp]
    sub = sorted(sub, key=lambda x: x["lda"], reverse=True)
    rows_sorted.extend(sub)

# 输出作图数据，方便核对
with out_csv.open("w", encoding="utf-8", newline="") as f:
    writer = csv.DictWriter(f, fieldnames=["feature", "group_safe", "group_cn", "LDA_score"])
    writer.writeheader()
    for r in rows_sorted:
        writer.writerow({
            "feature": r["feature"],
            "group_safe": r["group_safe"],
            "group_cn": r["group_cn"],
            "LDA_score": r["lda"],
        })

# -----------------------------
# 7. plot
# -----------------------------
features = [r["feature"] for r in rows_sorted]
groups_safe = [r["group_safe"] for r in rows_sorted]
ldas = [r["lda"] for r in rows_sorted]
colors = [species_colors[g] for g in groups_safe]

n = len(rows_sorted)

# 物种图差异属会更多，图要更高更宽。
fig_width = 14.5
fig_height = max(8.5, n * 0.30 + 2.8)

fig, ax = plt.subplots(figsize=(fig_width, fig_height))

y = list(range(n))

ax.barh(
    y,
    ldas,
    color=colors,
    edgecolor="black",
    linewidth=0.9,
    height=0.76,
)

ax.set_yticks(y)
ax.set_yticklabels(features, fontproperties=font_prop, fontsize=13)
ax.invert_yaxis()

ax.set_xlabel("LDA SCORE (log 10)", fontproperties=font_prop, fontsize=13)

xmax = max(ldas)
x_upper = max(5.2, xmax + 0.25)

ax.set_xlim(0, x_upper)
ax.set_xticks(range(0, int(x_upper) + 1, 1))
ax.tick_params(axis="x", labelsize=13)
ax.tick_params(axis="y", length=0)

ax.grid(axis="x", color="black", linewidth=0.9)
ax.grid(axis="y", visible=False)

ax.spines["top"].set_visible(False)
ax.spines["right"].set_visible(False)
ax.spines["left"].set_visible(False)
ax.spines["bottom"].set_visible(False)

# 只显示实际进入 LDA>4 结果的物种图例，但顺序仍按固定物种顺序
present_species = [sp for sp in species_order_safe if sp in set(groups_safe)]

legend_handles = [
    Patch(facecolor=species_colors[sp], edgecolor="black", label=species_cn[sp])
    for sp in present_species
]

# 物种较多，图例放在顶部，多列显示
legend = ax.legend(
    handles=legend_handles,
    loc="upper center",
    bbox_to_anchor=(0.5, 1.15),
    ncol=6,
    frameon=False,
    prop=font_prop,
    fontsize=13,
    handlelength=1.6,
    columnspacing=1.25,
    handletextpad=0.5,
)

for text in legend.get_texts():
    text.set_fontproperties(font_prop)
    text.set_fontsize(13)

plt.subplots_adjust(
    left=0.28,
    right=0.98,
    top=0.84,
    bottom=0.08
)

fig.savefig(out_png, dpi=600, bbox_inches="tight", facecolor="white")
fig.savefig(out_pdf, bbox_inches="tight", facecolor="white")

print("Done!")
print(f"Input: {res_file}")
print(f"Features plotted: {n}")
print(f"PNG: {out_png}")
print(f"PDF: {out_pdf}")
print(f"Plot data: {out_csv}")
print("Legend species:", "、".join([species_cn[sp] for sp in present_species]))
