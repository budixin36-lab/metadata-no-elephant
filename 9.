read_sh_abundance_table <- function(sh_table_file) {
  sh_lines <- readLines(sh_table_file, warn = FALSE)
  sh_lines <- sh_lines[nchar(trimws(sh_lines)) > 0]

  if (length(sh_lines) == 0) {
    stop("SH abundance table 为空。")
  }

  if (grepl("^# Constructed from biom file", sh_lines[1])) {
    sh_lines <- sh_lines[-1]
  }

  sh_raw <- read.delim(
    text = paste(sh_lines, collapse = "\n"),
    header = TRUE,
    sep = "\t",
    check.names = FALSE,
    stringsAsFactors = FALSE,
    quote = "",
    comment.char = ""
  )

  colnames(sh_raw)[1] <- "SH_ID"

  taxonomy_cols <- grep("taxonomy|metadata", colnames(sh_raw), ignore.case = TRUE, value = TRUE)
  if (length(taxonomy_cols) > 0) {
    sh_raw <- sh_raw[, !colnames(sh_raw) %in% taxonomy_cols, drop = FALSE]
  }

  rownames(sh_raw) <- sh_raw$SH_ID
  mat <- as.matrix(sh_raw[, -1, drop = FALSE])
  mode(mat) <- "numeric"
  mat[is.na(mat)] <- 0

  mat
}

fmt_tick <- function(x) {
  ifelse(abs(x - round(x)) < 1e-6, as.character(round(x)), sprintf("%.1f", x))
}

nice_axis_at <- function(xmax) {
  if (is.na(xmax) || xmax <= 0) return(NULL)

  if (xmax > 20) {
    at <- seq(0, floor(xmax / 20) * 20, by = 20)
    if (length(at) == 0) at <- 0
    if (abs(max(at) - xmax) > 1e-6) {
      at <- c(at, xmax)
    }
  } else if (xmax >= 15) {
    at <- c(0, 10, xmax)
  } else {
    at <- c(0, xmax)
  }

  unique(at[at >= 0 & at <= xmax])
}

nice_axis_lab <- function(at) {
  if (is.null(at) || length(at) == 0) return(character(0))
  fmt_tick(at)
}

