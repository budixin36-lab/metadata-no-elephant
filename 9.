cat("\n开始绘制图3-4 中文属水平弦图...\n")

mat_input <- file.path(
  family_comp_dir,
  "host_family_top20_genus_chord_matrix_for_plot_minlink_filtered_no_elephant.csv"
)

source_input <- file.path(
  family_comp_dir,
  "host_family_top20_genus_source_composition_for_chord_no_elephant.csv"
)

if (!file.exists(mat_input)) {
  stop("找不到图3-4矩阵：", mat_input)
}

if (!file.exists(source_input)) {
  stop("找不到图3-4属侧来源组成表：", source_input)
}

mat_df <- read.csv(mat_input, stringsAsFactors = FALSE, check.names = FALSE)
if (!"host_family" %in% colnames(mat_df)) {
  colnames(mat_df)[1] <- "host_family"
}

mat <- as.matrix(mat_df[, setdiff(colnames(mat_df), "host_family"), drop = FALSE])
rownames(mat) <- mat_df$host_family
storage.mode(mat) <- "numeric"
mat[is.na(mat)] <- 0

source_df <- read.csv(source_input, stringsAsFactors = FALSE, check.names = FALSE)
if (!"genus" %in% colnames(source_df)) {
  colnames(source_df)[1] <- "genus"
}

## source_df 是 genus × host_family，转成 host_family × genus
source_family_cols <- intersect(colnames(source_df), rownames(mat))
source_mat <- as.matrix(source_df[, source_family_cols, drop = FALSE])
rownames(source_mat) <- source_df$genus
storage.mode(source_mat) <- "numeric"
source_mat[is.na(source_mat)] <- 0
genus_source_prop <- t(source_mat)

## 只保留 mat 里实际有的行列
genus_source_prop <- genus_source_prop[rownames(mat), colnames(mat), drop = FALSE]

## 中文矩阵
mat_cn <- mat
rownames(mat_cn) <- to_cn(rownames(mat_cn), family_cn)
colnames(mat_cn) <- to_cn(colnames(mat_cn), genus_cn)

genus_source_prop_cn <- genus_source_prop
rownames(genus_source_prop_cn) <- to_cn(rownames(genus_source_prop_cn), family_cn)
colnames(genus_source_prop_cn) <- to_cn(colnames(genus_source_prop_cn), genus_cn)

family_order_plot_cn <- rownames(mat_cn)
genus_order_cn <- colnames(mat_cn)

family_colors_en <- c(
  Bovidae = "#D8AA00",
  Suidae = "#E41A1C",
  Equidae = "#00BFC4",
  Cervidae = "#2CA02C",
  Rhinocerotidae = "#619CFF"
)

family_colors_cn <- family_colors_en
names(family_colors_cn) <- to_cn(names(family_colors_en), family_cn)

genus_base_cols <- c(
  "#8DD3C7", "#FFFFB3", "#BEBADA", "#FB8072", "#80B1D3",
  "#FDB462", "#B3DE69", "#FCCDE5", "#D9D9D9", "#BC80BD",
  "#CCEBC5", "#FFED6F", "#A6CEE3", "#1F78B4", "#B2DF8A",
  "#33A02C", "#FB9A99", "#E31A1C", "#FDBF6F", "#FF7F00"
)

plot_chord_cn <- function(outfile, type = c("png", "pdf")) {
  type <- match.arg(type)

  if (type == "png") {
    png(outfile, width = 10, height = 10, units = "in", res = 600, bg = "white")
  } else {
    pdf(outfile, width = 10, height = 10, bg = "white")
  }

  par(family = cn_font)

  circos.clear()

  genus_colors <- setNames(
    rep(genus_base_cols, length.out = length(genus_order_cn)),
    genus_order_cn
  )

  grid_cols <- c(
    family_colors_cn[family_order_plot_cn],
    genus_colors[genus_order_cn]
  )

  link_col_mat <- matrix(NA, nrow = nrow(mat_cn), ncol = ncol(mat_cn))
  rownames(link_col_mat) <- rownames(mat_cn)
  colnames(link_col_mat) <- colnames(mat_cn)

  for (g in genus_order_cn) {
    link_col_mat[, g] <- circlize::add_transparency(genus_colors[g], transparency = 0.45)
  }

  n_family <- length(family_order_plot_cn)
  n_genus <- length(genus_order_cn)

  sector_order <- c(genus_order_cn, family_order_plot_cn)

  gap_after <- c(
    rep(1.4, n_genus - 1),
    18,
    rep(4, n_family - 1),
    18
  )

  circos.par(
    start.degree = 92,
    gap.after = gap_after,
    track.margin = c(0.002, 0.002),
    cell.padding = c(0, 0, 0, 0),
    canvas.xlim = c(-1.30, 1.30),
    canvas.ylim = c(-1.30, 1.30),
    points.overflow.warning = FALSE
  )

  chordDiagram(
    x = mat_cn,
    order = sector_order,
    grid.col = grid_cols,
    col = link_col_mat,
    transparency = 0,
    directional = 0,
    annotationTrack = c("grid"),
    annotationTrackHeight = 0.035,
    preAllocateTracks = list(
      list(track.height = 0.155),
      list(track.height = 0.030)
    )
  )

  ## Track 1：刻度 + 标签
  circos.trackPlotRegion(
    track.index = 1,
    ylim = c(0, 1),
    bg.border = NA,
    panel.fun = function(x, y) {
      sector <- get.cell.meta.data("sector.index")
      xlim <- get.cell.meta.data("xlim")

      axis_h <- 0.22
      at <- nice_axis_at(xlim[2])

      circos.lines(
        x = c(xlim[1], xlim[2]),
        y = c(axis_h, axis_h),
        col = "grey30",
        lwd = 0.45
      )

      if (!is.null(at) && length(at) >= 2) {
        circos.axis(
          h = axis_h,
          major.at = at,
          labels = nice_axis_lab(at),
          labels.cex = 0.34,
          major.tick.length = mm_y(0.55),
          labels.niceFacing = TRUE,
          col = "grey30",
          labels.col = "grey30",
          minor.ticks = 0,
          direction = "outside"
        )
      }

      if (sector %in% family_order_plot_cn) {
        circos.text(
          x = mean(xlim),
          y = 0.64,
          labels = sector,
          facing = "bending.inside",
          niceFacing = TRUE,
          cex = 0.88,
          font = 2,
          col = "black"
        )
      } else {
        circos.text(
          x = mean(xlim),
          y = 0.63,
          labels = sector,
          facing = "clockwise",
          niceFacing = TRUE,
          adj = c(0, 0.5),
          cex = 0.58,
          col = "black"
        )
      }
    }
  )

  ## Track 2：属侧宿主科来源组成条
  circos.trackPlotRegion(
    track.index = 2,
    ylim = c(0, 1),
    bg.border = NA,
    panel.fun = function(x, y) {
      sector <- get.cell.meta.data("sector.index")
      xlim <- get.cell.meta.data("xlim")

      if (sector %in% genus_order_cn) {
        prop <- genus_source_prop_cn[, sector]
        prop <- prop[family_order_plot_cn]
        prop[is.na(prop)] <- 0

        if (sum(prop) > 0) {
          cum <- c(0, cumsum(prop))
          for (i in seq_along(prop)) {
            fam <- names(prop)[i]
            xleft <- xlim[1] + diff(xlim) * cum[i]
            xright <- xlim[1] + diff(xlim) * cum[i + 1]

            if (xright > xleft) {
              circos.rect(
                xleft = xleft,
                ybottom = 0.08,
                xright = xright,
                ytop = 0.92,
                col = family_colors_cn[fam],
                border = NA
              )
            }
          }
        }
      }
    }
  )

  circos.clear()
  dev.off()
}

plot_chord_cn(
  file.path(family_comp_dir, "Fig3_4_host_family_top20_genus_chord_enhanced_final_CN.png"),
