mat_df <- read.csv(
  mat_input,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

if (!"驯养属性" %in% colnames(mat_df)) {
  colnames(mat_df)[1] <- "驯养属性"
}

missing_status <- setdiff(status_order_cn, mat_df$驯养属性)

if (length(missing_status) > 0) {
  stop("矩阵缺少以下分组：", paste(missing_status, collapse = ", "))
}

mat_df <- mat_df[match(status_order_cn, mat_df$驯养属性), , drop = FALSE]

old_genus_names <- setdiff(colnames(mat_df), "驯养属性")
new_genus_names <- rename_genus(old_genus_names)

mat <- as.matrix(mat_df[, old_genus_names, drop = FALSE])
rownames(mat) <- mat_df$驯养属性
colnames(mat) <- new_genus_names
storage.mode(mat) <- "numeric"
mat[is.na(mat)] <- 0

## 如果翻译后出现重复中文属名，合并同名列
if (any(duplicated(colnames(mat)))) {
  mat <- rowsum(t(mat), group = colnames(mat))
  mat <- t(mat)
}

mat <- mat[rowSums(mat) > 0, , drop = FALSE]
mat <- mat[, colSums(mat) > 0, drop = FALSE]

status_order_plot_cn <- rownames(mat)
genus_order_plot_cn <- colnames(mat)

write.csv(
  cbind("驯养属性" = rownames(mat), as.data.frame(mat, check.names = FALSE)),
  out_matrix_fixed,
