## 8. 读取来源组成表；若不匹配，按矩阵重建
## =========================

rebuild_source <- TRUE
genus_source_prop <- NULL

if (file.exists(source_input)) {
  source_df <- read.csv(
    source_input,
    stringsAsFactors = FALSE,
    check.names = FALSE
  )

  if (!"属" %in% colnames(source_df)) {
    colnames(source_df)[1] <- "属"
  }

  source_df$属 <- rename_genus(source_df$属)

  source_num_cols <- intersect(colnames(source_df), status_order_cn)

  if (length(source_num_cols) == length(status_order_cn)) {
    source_df2 <- source_df %>%
      group_by(属) %>%
      summarise(
        across(all_of(source_num_cols), ~sum(.x, na.rm = TRUE)),
        .groups = "drop"
      )

    source_mat <- as.matrix(source_df2[, status_order_cn, drop = FALSE])
    rownames(source_mat) <- source_df2$属
    storage.mode(source_mat) <- "numeric"
    source_mat[is.na(source_mat)] <- 0

    source_try <- t(source_mat)

    source_has_all <- all(
      status_order_plot_cn %in% rownames(source_try)
    ) && all(
      genus_order_plot_cn %in% colnames(source_try)
    )

    if (source_has_all) {
      genus_source_prop <- source_try[
        status_order_plot_cn,
        genus_order_plot_cn,
        drop = FALSE
      ]
      rebuild_source <- FALSE
    }
  }
}

if (rebuild_source) {
  message("来源组成表与矩阵列名不完全一致，已根据弦图矩阵重新计算属侧来源组成。")

  genus_source_prop <- apply(mat, 2, function(x) {
    if (sum(x) == 0) {
      rep(0, length(x))
    } else {
      x / sum(x)
    }
  })

  genus_source_prop <- as.matrix(genus_source_prop)
  rownames(genus_source_prop) <- rownames(mat)
}

write.csv(
  cbind("属" = colnames(genus_source_prop), as.data.frame(t(genus_source_prop), check.names = FALSE)),
  out_source_fixed,
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

